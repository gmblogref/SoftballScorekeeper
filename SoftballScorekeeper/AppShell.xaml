<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="SoftballScorekeeper.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:data="clr-namespace:SoftballScorekeeper.Infrastructure.Data;assembly=SoftballScorekeeper.Infrastructure"
    xmlns:strings="clr-namespace:SoftballScorekeeper.Resources.Strings"
    xmlns:views="clr-namespace:SoftballScorekeeper.Views"
    x:DataType="data:DatabaseModeState"
    Shell.FlyoutBehavior="Flyout"
    Title="{x:Static strings:AppResources.ShellTitle}">

	<FlyoutItem
        Title="{x:Static strings:AppResources.TeamsHeading}"
        Route="teams"
        FlyoutItemIsVisible="False">
        <ShellContent
            x:Name="MainShellContent"
            Title="{x:Static strings:AppResources.TeamsHeading}"
            Route="team-manager" />
    </FlyoutItem>

    <FlyoutItem
        Title="{x:Static strings:AppResources.PlayersTitle}"
        Route="players"
        FlyoutItemIsVisible="False">
        <ShellContent
            Title="{x:Static strings:AppResources.PlayersTitle}"
            Route="player-manager"
            ContentTemplate="{DataTemplate views:PlayerListPage}" />
    </FlyoutItem>

    <MenuItem
        Text="{x:Static strings:AppResources.TeamsHeading}"
        Clicked="OnTeamsClicked" />
    <MenuItem
        Text="{x:Static strings:AppResources.PlayersTitle}"
        Clicked="OnPlayersClicked" />

    <MenuItem
        Text="{x:Static strings:AppResources.ManageInactiveTeamsButton}"
        Clicked="OnManageInactiveTeamsClicked" />
    <MenuItem
        Text="{x:Static strings:AppResources.ManageInactivePlayersButton}"
        Clicked="OnManageInactivePlayersClicked" />

    <MenuItem
        Text="{x:Static strings:AppResources.DataManagementTitle}"
        Clicked="OnDataManagementClicked" />

    <MenuItem
        x:Name="EnterTestModeMenuItem"
        AutomationId="EnterTestModeMenuItem"
        Text="{x:Static strings:AppResources.EnterTestModeMenuItem}"
        Clicked="OnEnterTestModeClicked" />
    <MenuItem
        x:Name="ExitTestModeMenuItem"
        AutomationId="ExitTestModeMenuItem"
        Text="{x:Static strings:AppResources.ExitTestModeMenuItem}"
        Clicked="OnExitTestModeClicked" />

</Shell>
