<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="SoftballScorekeeper.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:strings="clr-namespace:SoftballScorekeeper.Resources.Strings"
    Shell.FlyoutBehavior="Disabled"
    Title="{x:Static strings:AppResources.ShellTitle}">

	<ShellContent
        x:Name="MainShellContent"
        Title="{x:Static strings:AppResources.MainPageTitle}"
        Route="MainPage" />

</Shell>
