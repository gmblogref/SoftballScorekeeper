<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
 xmlns:strings="clr-namespace:SoftballScorekeeper.Resources.Strings" xmlns:viewModels="clr-namespace:SoftballScorekeeper.ViewModels"
 x:Class="SoftballScorekeeper.Views.SetLineupPage" x:DataType="viewModels:SetLineupViewModel" Title="{x:Static strings:AppResources.LineupManagerTitle}">
 <Grid Padding="40" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="16">
  <Grid ColumnDefinitions="*,Auto">
   <Label Text="{x:Static strings:AppResources.LineupManagerTitle}" Style="{StaticResource Headline}"/>
   <Label Grid.Column="1" Text="{Binding SelectedPlayerCount, StringFormat={x:Static strings:AppResources.SelectedPlayerCountText}}" IsVisible="{Binding IsAddMode}"/>
   <Label Grid.Column="1" Text="{Binding SelectedRemovalCountText}" IsVisible="{Binding IsRemovalMode}"/>
  </Grid>
  <Label Grid.Row="1" Text="{Binding ValidationMessage}" HorizontalTextAlignment="Center"/>
  <Grid Grid.Row="2" RowDefinitions="Auto,*" RowSpacing="8" IsVisible="{Binding IsCurrentLineupVisible}">
   <Label Text="{x:Static strings:AppResources.CurrentLineupHeading}" Style="{StaticResource SubHeadline}"/>
   <Label Grid.Row="1" Text="{x:Static strings:AppResources.EmptyLineupMessage}" HorizontalTextAlignment="Center" VerticalOptions="Center" IsVisible="{Binding HasEmptyLineup}"/>
   <CollectionView Grid.Row="1" ItemsSource="{Binding ExistingLineupPlayers}" IsVisible="{Binding HasExistingLineup}" SelectionMode="None">
    <CollectionView.ItemTemplate>
     <DataTemplate x:DataType="viewModels:LineupPlayerSelectionItem">
      <Grid Padding="8,3" ColumnDefinitions="*,Auto" MinimumHeightRequest="56">
       <Label Text="{Binding DisplayText}" FontSize="20" VerticalOptions="Center"/>
       <CheckBox Grid.Column="1" IsChecked="{Binding IsSelected, Mode=TwoWay}" IsVisible="{Binding IsSelectionVisible}" MinimumHeightRequest="48" MinimumWidthRequest="48"/>
      </Grid>
     </DataTemplate>
    </CollectionView.ItemTemplate>
   </CollectionView>
  </Grid>
  <HorizontalStackLayout Grid.Row="3" HorizontalOptions="Center" Spacing="16" IsVisible="{Binding IsNormalMode}">
   <Button Text="{x:Static strings:AppResources.AddLineupPlayersButton}" Command="{Binding EnterAddModeCommand}" MinimumHeightRequest="52" MinimumWidthRequest="160"/>
   <Button Text="{x:Static strings:AppResources.RemoveLineupPlayersButton}" Command="{Binding EnterRemovalModeCommand}" MinimumHeightRequest="52" MinimumWidthRequest="160"/>
   <Button Text="{x:Static strings:AppResources.DoneButton}" Command="{Binding DoneCommand}" MinimumHeightRequest="52" MinimumWidthRequest="140"/>
  </HorizontalStackLayout>
  <Grid Grid.Row="2" RowDefinitions="Auto,*" RowSpacing="8" IsVisible="{Binding IsAddMode}">
   <Label Text="{x:Static strings:AppResources.AddLineupPlayersButton}" Style="{StaticResource SubHeadline}"/>
   <Label Grid.Row="1" Text="{x:Static strings:AppResources.NoEligibleLineupPlayers}" HorizontalTextAlignment="Center" VerticalOptions="Center" IsVisible="{Binding ShowNoEligiblePlayersMessage}"/>
   <Label Grid.Row="1" Text="{x:Static strings:AppResources.NoAdditionalEligibleLineupPlayers}" HorizontalTextAlignment="Center" VerticalOptions="Center" IsVisible="{Binding ShowNoAdditionalPlayersMessage}"/>
   <CollectionView Grid.Row="1" ItemsSource="{Binding Players}" IsVisible="{Binding HasPlayers}" SelectionMode="None">
    <CollectionView.ItemTemplate><DataTemplate x:DataType="viewModels:PlayerSelectionItem"><Grid Padding="20,12" RowDefinitions="Auto,1" ColumnDefinitions="*,Auto" MinimumHeightRequest="72"><Label Text="{Binding DisplayName}" FontSize="20" VerticalOptions="Center"/><CheckBox Grid.Column="1" IsChecked="{Binding IsSelected, Mode=TwoWay}" MinimumHeightRequest="48" MinimumWidthRequest="48"/><BoxView Grid.Row="1" Grid.ColumnSpan="2" Margin="0,11,0,0" HeightRequest="1" Color="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray500}}"/></Grid></DataTemplate></CollectionView.ItemTemplate>
   </CollectionView>
  </Grid>
  <HorizontalStackLayout Grid.Row="3" HorizontalOptions="Center" Spacing="16" IsVisible="{Binding IsAddMode}"><Button Text="{x:Static strings:AppResources.CancelButton}" Command="{Binding CancelTemporaryModeCommand}" MinimumHeightRequest="52" MinimumWidthRequest="140"/><Button Text="{x:Static strings:AppResources.CreateNewPlayerButton}" Command="{Binding CreatePlayerCommand}" MinimumHeightRequest="52" MinimumWidthRequest="190"/><Button Text="{x:Static strings:AppResources.AddSelectedLineupPlayersButton}" Command="{Binding AddSelectedCommand}" MinimumHeightRequest="52" MinimumWidthRequest="180"/></HorizontalStackLayout>
  <HorizontalStackLayout Grid.Row="3" HorizontalOptions="Center" Spacing="20" IsVisible="{Binding IsRemovalMode}"><Button Text="{x:Static strings:AppResources.CancelButton}" Command="{Binding CancelTemporaryModeCommand}" MinimumHeightRequest="52" MinimumWidthRequest="160"/><Button Text="{x:Static strings:AppResources.RemoveSelectedLineupPlayersButton}" Command="{Binding RequestRemovalCommand}" MinimumHeightRequest="52" MinimumWidthRequest="200"/></HorizontalStackLayout>
 </Grid>
</ContentPage>
