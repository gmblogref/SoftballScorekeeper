<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
 xmlns:strings="clr-namespace:SoftballScorekeeper.Resources.Strings" xmlns:viewModels="clr-namespace:SoftballScorekeeper.ViewModels"
 x:Class="SoftballScorekeeper.Views.SetLineupPage" x:DataType="viewModels:SetLineupViewModel" Title="{x:Static strings:AppResources.LineupManagerTitle}">
 <Grid Style="{StaticResource ResponsivePageGrid}" RowDefinitions="Auto,Auto,*,Auto">
  <Grid ColumnDefinitions="*,Auto">
   <Label Text="{x:Static strings:AppResources.LineupManagerTitle}" Style="{StaticResource ResponsiveHeadline}"/>
   <Label Grid.Column="1" Text="{Binding SelectedPlayerCount, StringFormat={x:Static strings:AppResources.SelectedPlayerCountText}}" IsVisible="{Binding IsAddMode}"/>
   <Label Grid.Column="1" Text="{Binding SelectedRemovalCountText}" IsVisible="{Binding IsRemovalMode}"/>
  </Grid>
  <Label Grid.Row="1" Text="{Binding ValidationMessage}" HorizontalTextAlignment="Center"/>
  <Grid Grid.Row="2" RowDefinitions="Auto,*" RowSpacing="8" IsVisible="{Binding IsCurrentLineupVisible}">
   <Label Text="{x:Static strings:AppResources.CurrentLineupHeading}" Style="{StaticResource SubHeadline}"/>
   <Label Grid.Row="1" Text="{x:Static strings:AppResources.EmptyLineupMessage}" HorizontalTextAlignment="Center" VerticalOptions="Center" IsVisible="{Binding HasEmptyLineup}"/>
   <CollectionView Grid.Row="1" ItemsSource="{Binding ExistingLineupPlayers}" IsVisible="{Binding HasExistingLineup}" SelectionMode="None">
    <CollectionView.ItemTemplate>
     <DataTemplate x:DataType="viewModels:LineupPlayerSelectionItem">
      <Grid RowDefinitions="Auto,Auto,Auto">
       <Grid.GestureRecognizers>
        <DragGestureRecognizer DragStarting="OnLineupPlayerDragStarting" DropCompleted="OnLineupPlayerDropCompleted" />
        <DropGestureRecognizer AllowDrop="True" DragOver="OnLineupPlayerDragOver" DragLeave="OnLineupPlayerDragLeave" Drop="OnLineupPlayerDrop" />
       </Grid.GestureRecognizers>
       <Grid HeightRequest="18" IsVisible="{Binding IsDropGapBefore}">
        <BoxView Margin="12,7" HeightRequest="4" CornerRadius="2" Color="{StaticResource Primary}"/>
       </Grid>
       <Border Grid.Row="1" Padding="8,3" MinimumHeightRequest="56" Scale="1" Opacity="1" Stroke="Transparent" StrokeThickness="0" BackgroundColor="Transparent">
        <Border.Triggers>
         <DataTrigger TargetType="Border" Binding="{Binding IsDragged}" Value="False">
          <Setter Property="Scale" Value="1"/>
          <Setter Property="Opacity" Value="1"/>
          <Setter Property="Stroke" Value="Transparent"/>
          <Setter Property="StrokeThickness" Value="0"/>
          <Setter Property="BackgroundColor" Value="Transparent"/>
         </DataTrigger>
         <DataTrigger TargetType="Border" Binding="{Binding IsDragged}" Value="True">
          <Setter Property="Scale" Value="1.03"/>
          <Setter Property="Opacity" Value="0.82"/>
          <Setter Property="Stroke" Value="{StaticResource Primary}"/>
          <Setter Property="StrokeThickness" Value="2"/>
          <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource Gray600}}"/>
         </DataTrigger>
        </Border.Triggers>
         <Grid ColumnDefinitions="*,Auto,Auto">
          <Label Text="{Binding DisplayText}" FontSize="20" VerticalOptions="Center"/>
          <Label Grid.Column="1" AutomationId="{Binding OnBasePercentageAutomationId}" Text="{Binding OnBasePercentageDisplay}" FontSize="20" Margin="12,0" VerticalOptions="Center"/>
          <CheckBox Grid.Column="2" IsChecked="{Binding IsSelected, Mode=TwoWay}" IsVisible="{Binding IsSelectionVisible}" MinimumHeightRequest="48" MinimumWidthRequest="48"/>
         </Grid>
       </Border>
       <Grid Grid.Row="2" HeightRequest="18" IsVisible="{Binding IsDropGapAfter}">
        <BoxView Margin="12,7" HeightRequest="4" CornerRadius="2" Color="{StaticResource Primary}"/>
       </Grid>
      </Grid>
     </DataTemplate>
    </CollectionView.ItemTemplate>
   </CollectionView>
  </Grid>
   <FlexLayout Grid.Row="3" Direction="Row" Wrap="Wrap" JustifyContent="Center"
               AlignItems="Center" IsVisible="{Binding IsNormalMode}">
    <Button Margin="8,4" Text="{x:Static strings:AppResources.AddLineupPlayersButton}" Command="{Binding EnterAddModeCommand}" MinimumHeightRequest="52" MinimumWidthRequest="160"/>
    <Button Margin="8,4" Text="{x:Static strings:AppResources.RemoveLineupPlayersButton}" Command="{Binding EnterRemovalModeCommand}" MinimumHeightRequest="52" MinimumWidthRequest="160"/>
    <Button Margin="8,4" Text="{x:Static strings:AppResources.UsePreviousLineupButton}" Command="{Binding UsePreviousLineupCommand}" MinimumHeightRequest="52" MinimumWidthRequest="190"/>
    <Button Margin="8,4" AutomationId="OrderLineupByObpButton" Text="{Binding OrderByObpButtonText}" Command="{Binding OrderByObpCommand}" MinimumHeightRequest="52" MinimumWidthRequest="190"/>
    <Button Margin="8,4" Text="{x:Static strings:AppResources.DoneButton}" Command="{Binding DoneCommand}" MinimumHeightRequest="52" MinimumWidthRequest="140"/>
   </FlexLayout>
  <Grid Grid.Row="2" RowDefinitions="Auto,*" RowSpacing="8" IsVisible="{Binding IsAddMode}">
   <Label Text="{x:Static strings:AppResources.AddLineupPlayersButton}" Style="{StaticResource SubHeadline}"/>
   <Label Grid.Row="1" Text="{x:Static strings:AppResources.NoEligibleLineupPlayers}" HorizontalTextAlignment="Center" VerticalOptions="Center" IsVisible="{Binding ShowNoEligiblePlayersMessage}"/>
   <Label Grid.Row="1" Text="{x:Static strings:AppResources.NoAdditionalEligibleLineupPlayers}" HorizontalTextAlignment="Center" VerticalOptions="Center" IsVisible="{Binding ShowNoAdditionalPlayersMessage}"/>
   <CollectionView Grid.Row="1" ItemsSource="{Binding Players}" IsVisible="{Binding HasPlayers}" SelectionMode="None">
    <CollectionView.ItemTemplate><DataTemplate x:DataType="viewModels:PlayerSelectionItem"><Grid Padding="20,12" RowDefinitions="Auto,1" ColumnDefinitions="*,Auto,Auto" MinimumHeightRequest="72"><Label Text="{Binding DisplayName}" FontSize="20" VerticalOptions="Center"/><Label Grid.Column="1" Text="{Binding OnBasePercentageDisplay}" FontSize="20" Margin="12,0" VerticalOptions="Center"/><CheckBox Grid.Column="2" IsChecked="{Binding IsSelected, Mode=TwoWay}" MinimumHeightRequest="48" MinimumWidthRequest="48"/><BoxView Grid.Row="1" Grid.ColumnSpan="3" Margin="0,11,0,0" HeightRequest="1" Color="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray500}}"/></Grid></DataTemplate></CollectionView.ItemTemplate>
   </CollectionView>
  </Grid>
  <HorizontalStackLayout Grid.Row="3" HorizontalOptions="Center" Spacing="16" IsVisible="{Binding IsAddMode}"><Button Text="{x:Static strings:AppResources.CancelButton}" Command="{Binding CancelTemporaryModeCommand}" MinimumHeightRequest="52" MinimumWidthRequest="140"/><Button Text="{x:Static strings:AppResources.CreateNewPlayerButton}" Command="{Binding CreatePlayerCommand}" MinimumHeightRequest="52" MinimumWidthRequest="190"/><Button Text="{x:Static strings:AppResources.AddSelectedLineupPlayersButton}" Command="{Binding AddSelectedCommand}" MinimumHeightRequest="52" MinimumWidthRequest="180"/></HorizontalStackLayout>
  <HorizontalStackLayout Grid.Row="3" HorizontalOptions="Center" Spacing="20" IsVisible="{Binding IsRemovalMode}"><Button Text="{x:Static strings:AppResources.CancelButton}" Command="{Binding CancelTemporaryModeCommand}" MinimumHeightRequest="52" MinimumWidthRequest="160"/><Button Text="{x:Static strings:AppResources.RemoveSelectedLineupPlayersButton}" Command="{Binding RequestRemovalCommand}" MinimumHeightRequest="52" MinimumWidthRequest="200"/></HorizontalStackLayout>
 </Grid>
</ContentPage>
