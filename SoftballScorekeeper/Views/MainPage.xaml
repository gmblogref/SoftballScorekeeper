<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:SoftballScorekeeper.Views.Controls"
             xmlns:strings="clr-namespace:SoftballScorekeeper.Resources.Strings"
             xmlns:viewModels="clr-namespace:SoftballScorekeeper.ViewModels"
             x:Class="SoftballScorekeeper.Views.MainPage"
             x:Name="PageRoot"
             x:DataType="viewModels:LandingPageViewModel">

    <Grid
        Style="{StaticResource ResponsivePageGrid}"
        RowDefinitions="Auto,Auto,Auto,*,Auto">

        <controls:PrimarySectionNavigation Grid.Row="0" CurrentSection="Teams" IsCurrentSectionRoot="True" />

        <Label
            Grid.Row="1"
            Text="{x:Static strings:AppResources.LandingPageTitle}"
            Style="{StaticResource ResponsiveHeadline}"
            SemanticProperties.HeadingLevel="Level1" />

        <Label
            Grid.Row="2"
            Text="{x:Static strings:AppResources.TeamsHeading}"
            Style="{StaticResource ResponsiveSubHeadline}"
            SemanticProperties.HeadingLevel="Level2" />

        <Grid Grid.Row="3">
            <Label
                Text="{x:Static strings:AppResources.NoTeamsMessage}"
                HorizontalTextAlignment="Center"
                IsVisible="{Binding HasNoTeams}" />

            <CollectionView
                ItemsSource="{Binding TeamYearGroups}"
                IsVisible="{Binding HasTeams}"
                SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:TeamManagerYearGroup">
                        <VerticalStackLayout Spacing="0">
                            <Button
                                Margin="0,4"
                                Padding="20,8"
                                MinimumHeightRequest="48"
                                HorizontalOptions="Fill"
                                Text="{Binding HeaderDisplay}"
                                Command="{Binding ToggleExpansionCommand}"
                                AutomationId="{Binding Year, StringFormat='TeamYearGroup-{0}'}"
                                FontAttributes="Bold"
                                FontSize="18"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                                TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                            <VerticalStackLayout
                                IsVisible="{Binding IsExpanded}"
                                BindableLayout.ItemsSource="{Binding Teams}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="viewModels:TeamManagerItem">
                                        <Border
                                            Style="{StaticResource PrimaryListCard}"
                                            Margin="0,0,0,12"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}"
                                            Stroke="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray500}}"
                                            AutomationId="{Binding CardAutomationId}"
                                            SemanticProperties.Description="{Binding Name}">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.OpenTeamCommand}"
                                                    CommandParameter="{Binding .}"
                                                    NumberOfTapsRequired="1" />
                                            </Border.GestureRecognizers>

                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="14" />
                                            </Border.StrokeShape>

                                            <VerticalStackLayout Spacing="2">
                                                <Label
                                                    Text="{Binding Name}"
                                                    AutomationId="{Binding NameAutomationId}"
                                                    FontFamily="OpenSansSemibold"
                                                    FontSize="24"
                                                    LineBreakMode="WordWrap"
                                                    HorizontalOptions="Start"
                                                    HorizontalTextAlignment="Start" />
                                                <Label
                                                    Text="{Binding Year}"
                                                    AutomationId="{Binding YearAutomationId}"
                                                    IsVisible="{Binding HasYear}"
                                                    FontSize="16" />
                                                <Label
                                                    Text="{Binding RecordDisplay}"
                                                    AutomationId="{Binding RecordAutomationId}"
                                                    FontSize="16" />
                                            </VerticalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <VerticalStackLayout
            Grid.Row="4"
            HorizontalOptions="Center"
            Spacing="12">
            <Button
                Text="{x:Static strings:AppResources.CreateTeamButton}"
                Command="{Binding CreateTeamCommand}"
                MinimumWidthRequest="180"
                Padding="28,14"
                HorizontalOptions="Center" />

        </VerticalStackLayout>
    </Grid>

</ContentPage>
