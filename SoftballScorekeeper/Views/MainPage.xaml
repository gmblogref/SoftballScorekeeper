<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:strings="clr-namespace:SoftballScorekeeper.Resources.Strings"
             xmlns:viewModels="clr-namespace:SoftballScorekeeper.ViewModels"
             x:Class="SoftballScorekeeper.Views.MainPage"
             x:DataType="viewModels:LandingPageViewModel">

    <ScrollView>
        <VerticalStackLayout
            Padding="40"
            Spacing="24">

            <Label
                Text="{x:Static strings:AppResources.LandingPageTitle}"
                Style="{StaticResource Headline}"
                SemanticProperties.HeadingLevel="Level1" />

            <Label
                Text="{x:Static strings:AppResources.TeamsHeading}"
                Style="{StaticResource SubHeadline}"
                SemanticProperties.HeadingLevel="Level2" />

            <Label
                Text="{x:Static strings:AppResources.NoTeamsMessage}"
                HorizontalTextAlignment="Center" />

            <Button
                Text="{x:Static strings:AppResources.CreateTeamButton}"
                Command="{Binding CreateTeamCommand}"
                HorizontalOptions="Center" />

            <Label
                Text="{Binding StatusMessage}"
                HorizontalTextAlignment="Center">
                <Label.Triggers>
                    <DataTrigger
                        TargetType="Label"
                        Binding="{Binding StatusMessage}"
                        Value="{x:Null}">
                        <Setter Property="IsVisible" Value="False" />
                    </DataTrigger>
                    <DataTrigger
                        TargetType="Label"
                        Binding="{Binding StatusMessage}"
                        Value="">
                        <Setter Property="IsVisible" Value="False" />
                    </DataTrigger>
                </Label.Triggers>
            </Label>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
