<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:SoftballScorekeeper.Core.Models;assembly=SoftballScorekeeper.Core"
             xmlns:strings="clr-namespace:SoftballScorekeeper.Resources.Strings"
             xmlns:viewModels="clr-namespace:SoftballScorekeeper.ViewModels"
             x:Class="SoftballScorekeeper.Views.MainPage"
             x:Name="PageRoot"
             x:DataType="viewModels:LandingPageViewModel">

    <Grid
        Padding="40"
        RowDefinitions="Auto,Auto,*,Auto"
        RowSpacing="24">

        <Label
            Grid.Row="0"
            Text="{x:Static strings:AppResources.LandingPageTitle}"
            Style="{StaticResource Headline}"
            SemanticProperties.HeadingLevel="Level1" />

        <Label
            Grid.Row="1"
            Text="{x:Static strings:AppResources.TeamsHeading}"
            Style="{StaticResource SubHeadline}"
            SemanticProperties.HeadingLevel="Level2" />

        <Grid Grid.Row="2">
            <Label
                Text="{x:Static strings:AppResources.NoTeamsMessage}"
                HorizontalTextAlignment="Center"
                IsVisible="{Binding HasNoTeams}" />

            <CollectionView
                ItemsSource="{Binding Teams}"
                IsVisible="{Binding HasTeams}"
                SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Team">
                        <Border
                            Margin="0,0,0,12"
                            Padding="28,16"
                            MinimumHeightRequest="64"
                            HorizontalOptions="Start"
                            BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}"
                            Stroke="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray500}}"
                            StrokeThickness="2"
                            SemanticProperties.Description="{Binding Name}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.OpenTeamCommand}"
                                    CommandParameter="{Binding .}"
                                    NumberOfTapsRequired="1" />
                            </Border.GestureRecognizers>

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>

                            <Label
                                Text="{Binding Name}"
                                FontFamily="OpenSansSemibold"
                                FontSize="24"
                                LineBreakMode="WordWrap"
                                HorizontalOptions="Start"
                                HorizontalTextAlignment="Start"
                                VerticalOptions="Center"
                                VerticalTextAlignment="Center" />
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <VerticalStackLayout
            Grid.Row="3"
            HorizontalOptions="Center"
            Spacing="12">
            <Button
                Text="{x:Static strings:AppResources.CreateTeamButton}"
                Command="{Binding CreateTeamCommand}"
                MinimumWidthRequest="180"
                Padding="28,14"
                HorizontalOptions="Center" />

            <Button
                Text="{x:Static strings:AppResources.ManageInactiveTeamsButton}"
                Command="{Binding ManageInactiveTeamsCommand}"
                MinimumHeightRequest="48"
                Padding="20,10"
                HorizontalOptions="Center"
                BackgroundColor="Transparent"
                BorderWidth="0"
                TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />

            <Button
                Text="{x:Static strings:AppResources.ViewPlayersButton}"
                Command="{Binding OpenPlayerListCommand}"
                MinimumHeightRequest="48"
                Padding="20,10"
                HorizontalOptions="Center"
                BackgroundColor="Transparent"
                BorderWidth="0"
                TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
        </VerticalStackLayout>
    </Grid>

</ContentPage>
