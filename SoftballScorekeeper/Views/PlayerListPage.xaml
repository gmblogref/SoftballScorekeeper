<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:strings="clr-namespace:SoftballScorekeeper.Resources.Strings"
             xmlns:viewModels="clr-namespace:SoftballScorekeeper.ViewModels"
             x:Class="SoftballScorekeeper.Views.PlayerListPage"
             x:DataType="viewModels:PlayerListViewModel"
             Title="{x:Static strings:AppResources.PlayersTitle}">

    <ContentPage.Resources>
        <x:Double x:Key="PlayerActionButtonWidth">210</x:Double>
        <x:Double x:Key="PlayerActionButtonHeight">44</x:Double>
        <Thickness x:Key="PlayerActionButtonPadding">12,6</Thickness>
    </ContentPage.Resources>

    <Grid
        Padding="40"
        RowDefinitions="Auto,Auto,*,Auto"
        RowSpacing="20">
        <Label
            Grid.Row="0"
            Text="{x:Static strings:AppResources.PlayersTitle}"
            Style="{StaticResource Headline}"
            SemanticProperties.HeadingLevel="Level1" />

        <Label
            Grid.Row="1"
            Text="{Binding StatusMessage}"
            HorizontalTextAlignment="Center">
            <Label.Triggers>
                <DataTrigger TargetType="Label" Binding="{Binding StatusMessage}" Value="{x:Null}">
                    <Setter Property="IsVisible" Value="False" />
                </DataTrigger>
                <DataTrigger TargetType="Label" Binding="{Binding StatusMessage}" Value="">
                    <Setter Property="IsVisible" Value="False" />
                </DataTrigger>
            </Label.Triggers>
        </Label>

        <Grid Grid.Row="2">
            <Label
                Text="{x:Static strings:AppResources.NoPlayersMessage}"
                HorizontalTextAlignment="Center"
                VerticalOptions="Center"
                IsVisible="{Binding HasNoPlayers}" />

            <CollectionView
                ItemsSource="{Binding Players}"
                IsVisible="{Binding HasPlayers}"
                SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:PlayerSelectionItem">
                        <Grid
                            Padding="20,12"
                            RowDefinitions="Auto,1"
                            ColumnDefinitions="*,Auto"
                            ColumnSpacing="20"
                            MinimumHeightRequest="72">
                            <Label
                                Text="{Binding DisplayName}"
                                FontSize="20"
                                LineBreakMode="TailTruncation"
                                HorizontalOptions="Start"
                                VerticalOptions="Center" />
                            <CheckBox
                                Grid.Column="1"
                                IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                MinimumHeightRequest="48"
                                MinimumWidthRequest="48"
                                HorizontalOptions="End"
                                VerticalOptions="Center" />
                            <BoxView
                                Grid.Row="1"
                                Grid.ColumnSpan="2"
                                Margin="0,11,0,0"
                                HeightRequest="1"
                                Color="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray500}}" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <Grid
            Grid.Row="3"
            RowDefinitions="Auto,Auto"
            ColumnDefinitions="Auto,Auto"
            RowSpacing="12"
            ColumnSpacing="12"
            HorizontalOptions="Center">
            <Button
                Text="{x:Static strings:AppResources.AddPlayerButton}"
                Command="{Binding AddPlayerCommand}"
                WidthRequest="{StaticResource PlayerActionButtonWidth}"
                HeightRequest="{StaticResource PlayerActionButtonHeight}"
                Padding="{StaticResource PlayerActionButtonPadding}" />
            <Button
                Grid.Column="1"
                Text="{x:Static strings:AppResources.EditPlayerButton}"
                Command="{Binding EditPlayerCommand}"
                WidthRequest="{StaticResource PlayerActionButtonWidth}"
                HeightRequest="{StaticResource PlayerActionButtonHeight}"
                Padding="{StaticResource PlayerActionButtonPadding}" />
            <Button
                Grid.Row="1"
                Text="{x:Static strings:AppResources.DeactivateSelectedPlayersButton}"
                Command="{Binding DeactivateSelectedPlayersCommand}"
                WidthRequest="{StaticResource PlayerActionButtonWidth}"
                HeightRequest="{StaticResource PlayerActionButtonHeight}"
                Padding="{StaticResource PlayerActionButtonPadding}" />
            <Button
                Grid.Row="1"
                Grid.Column="1"
                Text="{x:Static strings:AppResources.ManageInactivePlayersButton}"
                Command="{Binding ManageInactivePlayersCommand}"
                WidthRequest="{StaticResource PlayerActionButtonWidth}"
                HeightRequest="{StaticResource PlayerActionButtonHeight}"
                Padding="{StaticResource PlayerActionButtonPadding}" />
        </Grid>
    </Grid>
</ContentPage>
