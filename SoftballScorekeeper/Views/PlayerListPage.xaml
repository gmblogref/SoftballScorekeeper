<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:strings="clr-namespace:SoftballScorekeeper.Resources.Strings"
             xmlns:viewModels="clr-namespace:SoftballScorekeeper.ViewModels"
             x:Class="SoftballScorekeeper.Views.PlayerListPage"
             x:Name="PageRoot"
             x:DataType="viewModels:PlayerListViewModel"
             Title="{x:Static strings:AppResources.PlayersTitle}">

    <Grid
        Padding="40"
        RowDefinitions="Auto,Auto,Auto,*,Auto"
        RowSpacing="20">
        <Label
            Grid.Row="0"
            Text="{x:Static strings:AppResources.PlayersTitle}"
            Style="{StaticResource Headline}"
            SemanticProperties.HeadingLevel="Level1" />

        <Label
            Grid.Row="1"
            Text="{Binding StatusMessage}"
            HorizontalTextAlignment="Center">
            <Label.Triggers>
                <DataTrigger TargetType="Label" Binding="{Binding StatusMessage}" Value="{x:Null}">
                    <Setter Property="IsVisible" Value="False" />
                </DataTrigger>
                <DataTrigger TargetType="Label" Binding="{Binding StatusMessage}" Value="">
                    <Setter Property="IsVisible" Value="False" />
                </DataTrigger>
            </Label.Triggers>
        </Label>

        <Label
            Grid.Row="2"
            Text="{Binding SelectedPlayerCount, StringFormat={x:Static strings:AppResources.SelectedPlayerCountText}}"
            HorizontalTextAlignment="Center" />

        <Grid Grid.Row="3">
            <Label
                Text="{x:Static strings:AppResources.NoPlayersMessage}"
                HorizontalTextAlignment="Center"
                VerticalOptions="Center"
                IsVisible="{Binding HasNoPlayers}" />

            <CollectionView
                ItemsSource="{Binding Players}"
                IsVisible="{Binding HasPlayers}"
                SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:PlayerSelectionItem">
                        <Grid
                            Padding="20,12"
                            RowDefinitions="Auto,1"
                            ColumnDefinitions="*,Auto"
                            ColumnSpacing="20"
                            MinimumHeightRequest="72">
                            <Border
                                Padding="24,10"
                                MinimumHeightRequest="52"
                                HorizontalOptions="Start"
                                VerticalOptions="Center"
                                BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}"
                                Stroke="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray500}}"
                                StrokeThickness="2"
                                SemanticProperties.Description="{Binding DisplayName}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.OpenPlayerCommand}"
                                        CommandParameter="{Binding Player.Id}"
                                        NumberOfTapsRequired="1" />
                                </Border.GestureRecognizers>
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="14" />
                                </Border.StrokeShape>
                                <Label
                                    Text="{Binding DisplayName}"
                                    FontSize="20"
                                    LineBreakMode="WordWrap"
                                    VerticalOptions="Center" />
                            </Border>
                            <CheckBox
                                Grid.Column="1"
                                IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                MinimumHeightRequest="48"
                                MinimumWidthRequest="48"
                                HorizontalOptions="End"
                                VerticalOptions="Center" />
                            <BoxView
                                Grid.Row="1"
                                Grid.ColumnSpan="2"
                                Margin="0,11,0,0"
                                HeightRequest="1"
                                Color="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray500}}" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <HorizontalStackLayout
            Grid.Row="4"
            Spacing="16"
            HorizontalOptions="Center">
            <Button
                Text="{x:Static strings:AppResources.AddPlayerButton}"
                Command="{Binding AddPlayerCommand}"
                MinimumHeightRequest="52"
                Padding="24,12" />
            <Button
                Text="{x:Static strings:AppResources.DeactivateSelectedPlayersButton}"
                Command="{Binding DeactivateSelectedPlayersCommand}"
                MinimumHeightRequest="52"
                Padding="24,12" />
            <Button
                Text="{x:Static strings:AppResources.ManageInactivePlayersButton}"
                Command="{Binding ManageInactivePlayersCommand}"
                MinimumHeightRequest="52"
                Padding="24,12" />
        </HorizontalStackLayout>
    </Grid>
</ContentPage>
