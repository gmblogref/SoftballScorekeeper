<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:SoftballScorekeeper.Core.Models;assembly=SoftballScorekeeper.Core"
             xmlns:controls="clr-namespace:SoftballScorekeeper.Views.Controls"
             xmlns:strings="clr-namespace:SoftballScorekeeper.Resources.Strings"
             xmlns:viewModels="clr-namespace:SoftballScorekeeper.ViewModels"
             x:Class="SoftballScorekeeper.Views.PlayerWorkspacePage"
             x:DataType="viewModels:PlayerWorkspaceViewModel"
             Title="{x:Static strings:AppResources.PlayerWorkspaceTitle}">

    <Grid Padding="40" RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" RowSpacing="24">
        <controls:PrimarySectionNavigation Grid.Row="0" CurrentSection="Players" />
        <Grid Grid.Row="1" IsVisible="{Binding IsPlayerLoaded}">
            <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="6" HorizontalOptions="Center">
                <Grid.Triggers>
                    <DataTrigger TargetType="Grid" Binding="{Binding IsEditingPlayerName}" Value="True">
                        <Setter Property="IsVisible" Value="False" />
                    </DataTrigger>
                </Grid.Triggers>
                <Button
                    AutomationId="EditPlayerNameButton"
                    Text="{Binding PlayerDisplayName}"
                    Command="{Binding BeginPlayerNameEditCommand}"
                    BackgroundColor="Transparent"
                    BorderWidth="0"
                    Padding="0"
                    FontSize="32"
                    TextColor="{AppThemeBinding Light={StaticResource MidnightBlue}, Dark={StaticResource White}}"
                    HorizontalOptions="Center"
                    MinimumHeightRequest="52"
                    SemanticProperties.HeadingLevel="Level1"
                    SemanticProperties.Hint="{x:Static strings:AppResources.PlayerNameEditHint}" />
                <Grid
                    Grid.Column="1"
                    SemanticProperties.Description="{x:Static strings:AppResources.PlayerNameEditHint}"
                    BackgroundColor="Transparent"
                    WidthRequest="44"
                    MinimumHeightRequest="44"
                    VerticalOptions="Center">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BeginPlayerNameEditCommand}" />
                    </Grid.GestureRecognizers>
                    <Label
                        Text="{x:Static strings:AppResources.EditIconGlyph}"
                        FontSize="20"
                        InputTransparent="True"
                        HorizontalOptions="Start"
                        VerticalOptions="Center" />
                </Grid>
            </Grid>

            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,*,Auto,Auto" RowSpacing="8" ColumnSpacing="16" IsVisible="False">
                <Grid.Triggers>
                    <DataTrigger TargetType="Grid" Binding="{Binding IsEditingPlayerName}" Value="True">
                        <Setter Property="IsVisible" Value="True" />
                    </DataTrigger>
                </Grid.Triggers>
                <Label Text="{x:Static strings:AppResources.FirstNameLabel}" />
                <Label Grid.Column="1" Text="{x:Static strings:AppResources.LastNameLabel}" />
                <Entry
                    Grid.Row="1"
                    Text="{Binding EditableFirstName, Mode=TwoWay}"
                    Placeholder="{x:Static strings:AppResources.FirstNamePlaceholder}"
                    MinimumHeightRequest="52" />
                <Entry
                    Grid.Row="1"
                    Grid.Column="1"
                    Text="{Binding EditableLastName, Mode=TwoWay}"
                    Placeholder="{x:Static strings:AppResources.LastNamePlaceholder}"
                    MinimumHeightRequest="52" />
                <Button
                    Grid.Row="1"
                    Grid.Column="2"
                    Text="{x:Static strings:AppResources.SaveButton}"
                    Command="{Binding SavePlayerNameCommand}"
                    MinimumHeightRequest="52"
                    Padding="24,12" />
                <Button
                    Grid.Row="1"
                    Grid.Column="3"
                    Text="{x:Static strings:AppResources.CancelButton}"
                    Command="{Binding CancelPlayerNameEditCommand}"
                    MinimumHeightRequest="52"
                    Padding="24,12" />
            </Grid>
        </Grid>

        <Label Grid.Row="2" Text="{Binding ValidationMessage}" HorizontalTextAlignment="Center">
            <Label.Triggers>
                <DataTrigger TargetType="Label" Binding="{Binding ValidationMessage}" Value="">
                    <Setter Property="IsVisible" Value="False" />
                </DataTrigger>
            </Label.Triggers>
        </Label>

        <Label
            Grid.Row="3"
            Text="{x:Static strings:AppResources.TeamMembershipHeading}"
            Style="{StaticResource SubHeadline}"
            SemanticProperties.HeadingLevel="Level2"
            IsVisible="{Binding IsPlayerLoaded}" />

        <Grid Grid.Row="4" IsVisible="{Binding IsPlayerLoaded}">
            <Label
                Text="{x:Static strings:AppResources.NoTeamMembershipsMessage}"
                HorizontalTextAlignment="Center"
                VerticalOptions="Center"
                IsVisible="{Binding HasNoTeamMemberships}" />
            <CollectionView ItemsSource="{Binding TeamMemberships}" IsVisible="{Binding HasTeamMemberships}" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Team">
                        <Grid Padding="20,12" RowDefinitions="Auto,1" MinimumHeightRequest="64">
                            <Label Text="{Binding Name}" FontSize="20" LineBreakMode="WordWrap" />
                            <BoxView
                                Grid.Row="1"
                                Margin="0,11,0,0"
                                HeightRequest="1"
                                Color="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray500}}" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <Button
            Grid.Row="5"
            Padding="24,14"
            MinimumHeightRequest="52"
            MinimumWidthRequest="200"
            HorizontalOptions="Center"
            Text="{x:Static strings:AppResources.DeactivatePlayerButton}"
            Command="{Binding RequestDeactivatePlayerCommand}"
            BackgroundColor="Transparent"
            BorderColor="{AppThemeBinding Light=#B3261E, Dark=#FFB4AB}"
            BorderWidth="2"
            TextColor="{AppThemeBinding Light=#B3261E, Dark=#FFB4AB}" />
    </Grid>
</ContentPage>
