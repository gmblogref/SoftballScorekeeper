<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:strings="clr-namespace:SoftballScorekeeper.Resources.Strings"
             xmlns:viewModels="clr-namespace:SoftballScorekeeper.ViewModels"
             x:Class="SoftballScorekeeper.Views.PlayerWorkspacePage"
             x:DataType="viewModels:PlayerWorkspaceViewModel"
             Title="{x:Static strings:AppResources.PlayerWorkspaceTitle}">

    <Grid Padding="40" RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="24">
        <Grid Grid.Row="0" IsVisible="{Binding IsPlayerLoaded}">
            <Label
                Text="{Binding PlayerDisplayName}"
                Style="{StaticResource Headline}"
                MinimumHeightRequest="52"
                VerticalTextAlignment="Center"
                SemanticProperties.HeadingLevel="Level1"
                SemanticProperties.Hint="{x:Static strings:AppResources.PlayerNameEditHint}">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding BeginPlayerNameEditCommand}" />
                </Label.GestureRecognizers>
                <Label.Triggers>
                    <DataTrigger TargetType="Label" Binding="{Binding IsEditingPlayerName}" Value="True">
                        <Setter Property="IsVisible" Value="False" />
                    </DataTrigger>
                </Label.Triggers>
            </Label>

            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,*,Auto,Auto" RowSpacing="8" ColumnSpacing="16" IsVisible="False">
                <Grid.Triggers>
                    <DataTrigger TargetType="Grid" Binding="{Binding IsEditingPlayerName}" Value="True">
                        <Setter Property="IsVisible" Value="True" />
                    </DataTrigger>
                </Grid.Triggers>
                <Label Text="{x:Static strings:AppResources.FirstNameLabel}" />
                <Label Grid.Column="1" Text="{x:Static strings:AppResources.LastNameLabel}" />
                <Entry
                    Grid.Row="1"
                    Text="{Binding EditableFirstName, Mode=TwoWay}"
                    Placeholder="{x:Static strings:AppResources.FirstNamePlaceholder}"
                    MinimumHeightRequest="52" />
                <Entry
                    Grid.Row="1"
                    Grid.Column="1"
                    Text="{Binding EditableLastName, Mode=TwoWay}"
                    Placeholder="{x:Static strings:AppResources.LastNamePlaceholder}"
                    MinimumHeightRequest="52" />
                <Button
                    Grid.Row="1"
                    Grid.Column="2"
                    Text="{x:Static strings:AppResources.SaveButton}"
                    Command="{Binding SavePlayerNameCommand}"
                    MinimumHeightRequest="52"
                    Padding="24,12" />
                <Button
                    Grid.Row="1"
                    Grid.Column="3"
                    Text="{x:Static strings:AppResources.CancelButton}"
                    Command="{Binding CancelPlayerNameEditCommand}"
                    MinimumHeightRequest="52"
                    Padding="24,12" />
            </Grid>
        </Grid>

        <Label Grid.Row="1" Text="{Binding ValidationMessage}" HorizontalTextAlignment="Center">
            <Label.Triggers>
                <DataTrigger TargetType="Label" Binding="{Binding ValidationMessage}" Value="">
                    <Setter Property="IsVisible" Value="False" />
                </DataTrigger>
            </Label.Triggers>
        </Label>

        <Label
            Grid.Row="2"
            Text="{x:Static strings:AppResources.TeamMembershipHeading}"
            Style="{StaticResource SubHeadline}"
            SemanticProperties.HeadingLevel="Level2"
            IsVisible="{Binding IsPlayerLoaded}" />

        <Label
            Grid.Row="3"
            Text="{x:Static strings:AppResources.TeamMembershipPlaceholderMessage}"
            HorizontalTextAlignment="Center"
            VerticalOptions="Center"
            IsVisible="{Binding IsPlayerLoaded}" />

        <Button
            Grid.Row="4"
            Padding="24,14"
            MinimumHeightRequest="52"
            MinimumWidthRequest="200"
            HorizontalOptions="Center"
            Text="{x:Static strings:AppResources.DeactivatePlayerButton}"
            Command="{Binding RequestDeactivatePlayerCommand}"
            BackgroundColor="Transparent"
            BorderColor="{AppThemeBinding Light=#B3261E, Dark=#FFB4AB}"
            BorderWidth="2"
            TextColor="{AppThemeBinding Light=#B3261E, Dark=#FFB4AB}" />
    </Grid>
</ContentPage>
