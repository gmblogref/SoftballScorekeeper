<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SoftballScorekeeper.Views.MultiOutSelectionDialog"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:strings="clr-namespace:SoftballScorekeeper.Resources.Strings"
    Shell.NavBarIsVisible="False"
    BackgroundColor="#99000000">
    <Grid Padding="36">
        <Border Padding="28"
                WidthRequest="620"
                MaximumWidthRequest="680"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource Gray900}}"
                Stroke="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"
                StrokeShape="RoundRectangle 16">
            <VerticalStackLayout Spacing="16">
                <Label x:Name="TitleLabel"
                       FontSize="24"
                       FontAttributes="Bold"
                       HorizontalTextAlignment="Center" />
                <Label Text="{x:Static strings:AppResources.MultiOutSelectionInstruction}"
                       FontSize="16"
                       HorizontalTextAlignment="Center" />
                <BoxView HeightRequest="1"
                         Color="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}" />
                <VerticalStackLayout x:Name="ParticipantButtons" Spacing="10" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <Button Text="{x:Static strings:AppResources.CancelButton}"
                            Clicked="OnCancelClicked"
                            MinimumHeightRequest="56" />
                    <Button x:Name="ConfirmButton"
                            Grid.Column="1"
                            Text="{x:Static strings:AppResources.MultiOutSelectionConfirmButton}"
                            Clicked="OnConfirmClicked"
                            MinimumHeightRequest="56"
                            IsEnabled="False" />
                </Grid>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
