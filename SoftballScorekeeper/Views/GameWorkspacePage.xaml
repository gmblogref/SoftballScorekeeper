<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:SoftballScorekeeper.Views.Controls"
             xmlns:strings="clr-namespace:SoftballScorekeeper.Resources.Strings"
             xmlns:viewModels="clr-namespace:SoftballScorekeeper.ViewModels"
             x:Class="SoftballScorekeeper.Views.GameWorkspacePage"
             x:DataType="viewModels:GameWorkspaceViewModel"
             Title="{x:Static strings:AppResources.GameWorkspaceTitle}">
    <ContentPage.Resources>
        <Style x:Key="CompletedGameViewButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="{StaticResource Black}" />
            <Setter Property="BorderColor" Value="{StaticResource White}" />
            <Setter Property="BorderWidth" Value="1" />
            <Setter Property="TextColor" Value="{StaticResource White}" />
        </Style>
    </ContentPage.Resources>

    <Grid x:Name="RootGrid" Style="{StaticResource ResponsivePageGrid}" RowDefinitions="Auto,*">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="CompletedWorkspaceLayoutStates">
                <VisualState x:Name="PortraitCompletedWorkspace">
                    <VisualState.Setters>
                        <Setter TargetName="CompletedGameGrid" Property="RowDefinitions" Value="Auto,Auto,Auto,*,Auto" />
                        <Setter TargetName="CompletedGameGrid" Property="RowSpacing" Value="12" />
                        <Setter TargetName="CompletedGameGrid" Property="ColumnDefinitions" Value="*" />
                        <Setter TargetName="CompletedGameGrid" Property="ColumnSpacing" Value="0" />
                        <Setter TargetName="CompletedScoreboard"
                                Property="controls:FullScoreboard.Profile"
                                Value="CompletedPortrait" />
                        <Setter TargetName="CompletedScoreboard" Property="Grid.Row" Value="0" />
                        <Setter TargetName="CompletedScoreboard" Property="Grid.Column" Value="0" />
                        <Setter TargetName="CompletedViewButtons" Property="Grid.Row" Value="1" />
                        <Setter TargetName="CompletedViewButtons" Property="Grid.Column" Value="0" />
                        <Setter TargetName="CompletedStatsHeading" Property="Grid.Row" Value="2" />
                        <Setter TargetName="CompletedStatsHeading" Property="Grid.Column" Value="0" />
                        <Setter TargetName="CompletedGameStatsView" Property="Grid.Row" Value="3" />
                        <Setter TargetName="CompletedGameStatsView" Property="Grid.Column" Value="0" />
                        <Setter TargetName="CompletedGamePlaysView" Property="Grid.Row" Value="3" />
                        <Setter TargetName="CompletedGamePlaysView" Property="Grid.Column" Value="0" />
                        <Setter TargetName="CompletedGameInfoPanel" Property="Grid.Row" Value="4" />
                        <Setter TargetName="CompletedGameInfoPanel" Property="Grid.Column" Value="0" />
                        <Setter TargetName="CompletedGameInfoPanel" Property="Grid.RowSpan" Value="1" />
                        <Setter TargetName="CompletedGameInfoPanel" Property="VerticalOptions" Value="Fill" />
                        <Setter TargetName="CompletedGameInfoGrid" Property="ColumnDefinitions" Value="*,*" />
                        <Setter TargetName="CompletedGameInfoGrid" Property="RowDefinitions" Value="Auto,Auto,Auto" />
                        <Setter TargetName="CompletedSeasonInfo" Property="Grid.Row" Value="0" />
                        <Setter TargetName="CompletedSeasonInfo" Property="Grid.Column" Value="0" />
                        <Setter TargetName="CompletedDateInfo" Property="Grid.Row" Value="1" />
                        <Setter TargetName="CompletedDateInfo" Property="Grid.Column" Value="0" />
                        <Setter TargetName="CompletedFieldInfo" Property="Grid.Row" Value="2" />
                        <Setter TargetName="CompletedFieldInfo" Property="Grid.Column" Value="0" />
                        <Setter TargetName="CompletedOpponentInfo" Property="Grid.Row" Value="0" />
                        <Setter TargetName="CompletedOpponentInfo" Property="Grid.Column" Value="1" />
                        <Setter TargetName="CompletedTimeInfo" Property="Grid.Row" Value="1" />
                        <Setter TargetName="CompletedTimeInfo" Property="Grid.Column" Value="1" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="LandscapeCompletedWorkspace">
                    <VisualState.Setters>
                        <Setter TargetName="CompletedGameGrid" Property="RowDefinitions" Value="Auto,Auto,Auto,*,Auto" />
                        <Setter TargetName="CompletedGameGrid" Property="RowSpacing" Value="8" />
                        <Setter TargetName="CompletedGameGrid" Property="ColumnDefinitions" Value="0.3*,0.7*" />
                        <Setter TargetName="CompletedGameGrid" Property="ColumnSpacing" Value="16" />
                        <Setter TargetName="CompletedScoreboard"
                                Property="controls:FullScoreboard.Profile"
                                Value="CompletedLandscape" />
                        <Setter TargetName="CompletedScoreboard" Property="Grid.Row" Value="0" />
                        <Setter TargetName="CompletedScoreboard" Property="Grid.Column" Value="1" />
                        <Setter TargetName="CompletedViewButtons" Property="Grid.Row" Value="1" />
                        <Setter TargetName="CompletedViewButtons" Property="Grid.Column" Value="1" />
                        <Setter TargetName="CompletedStatsHeading" Property="Grid.Row" Value="2" />
                        <Setter TargetName="CompletedStatsHeading" Property="Grid.Column" Value="1" />
                        <Setter TargetName="CompletedGameStatsView" Property="Grid.Row" Value="3" />
                        <Setter TargetName="CompletedGameStatsView" Property="Grid.Column" Value="1" />
                        <Setter TargetName="CompletedGamePlaysView" Property="Grid.Row" Value="3" />
                        <Setter TargetName="CompletedGamePlaysView" Property="Grid.Column" Value="1" />
                        <Setter TargetName="CompletedGameInfoPanel" Property="Grid.Row" Value="0" />
                        <Setter TargetName="CompletedGameInfoPanel" Property="Grid.Column" Value="0" />
                        <Setter TargetName="CompletedGameInfoPanel" Property="Grid.RowSpan" Value="5" />
                        <Setter TargetName="CompletedGameInfoPanel" Property="VerticalOptions" Value="Fill" />
                        <Setter TargetName="CompletedGameInfoGrid" Property="ColumnDefinitions" Value="*" />
                        <Setter TargetName="CompletedGameInfoGrid" Property="RowDefinitions" Value="Auto,Auto,Auto,*,Auto,Auto" />
                        <Setter TargetName="CompletedSeasonInfo" Property="Grid.Row" Value="0" />
                        <Setter TargetName="CompletedSeasonInfo" Property="Grid.Column" Value="0" />
                        <Setter TargetName="CompletedDateInfo" Property="Grid.Row" Value="1" />
                        <Setter TargetName="CompletedDateInfo" Property="Grid.Column" Value="0" />
                        <Setter TargetName="CompletedFieldInfo" Property="Grid.Row" Value="2" />
                        <Setter TargetName="CompletedFieldInfo" Property="Grid.Column" Value="0" />
                        <Setter TargetName="CompletedOpponentInfo" Property="Grid.Row" Value="4" />
                        <Setter TargetName="CompletedOpponentInfo" Property="Grid.Column" Value="0" />
                        <Setter TargetName="CompletedTimeInfo" Property="Grid.Row" Value="5" />
                        <Setter TargetName="CompletedTimeInfo" Property="Grid.Column" Value="0" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Label AutomationId="GameWorkspaceValidationMessage"
               Grid.Row="0"
               Text="{Binding ValidationMessage}"
               HorizontalTextAlignment="Center">
            <Label.Triggers>
                <DataTrigger TargetType="Label" Binding="{Binding ValidationMessage}" Value="">
                    <Setter Property="IsVisible" Value="False" />
                </DataTrigger>
            </Label.Triggers>
        </Label>

        <Grid x:Name="WorkspaceContentGrid" Grid.Row="1">
            <Grid IsVisible="{Binding ShowStandardWorkspace}"
                  RowDefinitions="Auto,Auto,Auto,*,Auto"
                  RowSpacing="20">
                <controls:TeamContextHeader TeamName="{Binding TeamName}"
                                            PageTitle="{x:Static strings:AppResources.GameDetailsHeading}" />
                <Grid Grid.Row="1" RowDefinitions="Auto,Auto,Auto"
                      ColumnDefinitions="*,*" ColumnSpacing="32" RowSpacing="20" Padding="0,12">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="{x:Static strings:AppResources.OpponentLabel}" FontAttributes="Bold" />
                        <Label Text="{Binding OpponentDisplay}" FontSize="22" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="6">
                        <Label Text="{x:Static strings:AppResources.SeasonLabel}" FontAttributes="Bold" />
                        <Label Text="{Binding SeasonDisplay}" FontSize="22" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Row="1" Spacing="6">
                        <Label Text="{x:Static strings:AppResources.GameDateLabel}" FontAttributes="Bold" />
                        <Label Text="{Binding DateDisplay}" FontSize="22" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="6">
                        <Label Text="{x:Static strings:AppResources.GameTimeLabel}" FontAttributes="Bold" />
                        <Label Text="{Binding TimeDisplay}" FontSize="22" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Row="2" Spacing="6">
                        <Label Text="{x:Static strings:AppResources.FieldLabel}" FontAttributes="Bold" />
                        <Label Text="{Binding FieldDisplay}" FontSize="22" />
                    </VerticalStackLayout>
                </Grid>
                <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto" ColumnSpacing="20"
                      HorizontalOptions="Center">
                    <Button AutomationId="ScoreGameButton"
                            Text="{x:Static strings:AppResources.ScoreGameButton}"
                            Clicked="OnScoreGameClicked" IsVisible="{Binding ShowScoreGame}"
                            MinimumHeightRequest="52" MinimumWidthRequest="200" Padding="24,14" />
                    <Button AutomationId="ResumeGameButton"
                            Text="{x:Static strings:AppResources.ResumeGameButton}"
                            Command="{Binding ResumeGameCommand}" IsVisible="{Binding ShowResumeGame}"
                            MinimumHeightRequest="52" MinimumWidthRequest="200" Padding="24,14" />
                    <Button Grid.Column="1"
                            Text="{x:Static strings:AppResources.ResetGameButton}"
                            Clicked="OnResetGameClicked" IsVisible="{Binding ShowResetGame}"
                            MinimumHeightRequest="52" MinimumWidthRequest="200" Padding="24,14" />
                </Grid>
                <HorizontalStackLayout Grid.Row="4" HorizontalOptions="Center" Spacing="20">
                    <Button Text="{x:Static strings:AppResources.EditGameTitle}"
                            Command="{Binding EditGameCommand}"
                            MinimumHeightRequest="52" MinimumWidthRequest="200"
                            HorizontalOptions="Center" Padding="24,14" />
                    <Button Text="{Binding LineupActionText}"
                            Command="{Binding SetLineupCommand}"
                            IsVisible="{Binding ShowLineupAction}"
                            MinimumHeightRequest="52" MinimumWidthRequest="200" Padding="24,14" />
                </HorizontalStackLayout>
            </Grid>

            <Grid x:Name="CompletedGameGrid"
                  IsVisible="{Binding ShowCompletedGame}"
                  ColumnDefinitions="*"
                  RowDefinitions="Auto,Auto,Auto,*,Auto"
                  RowSpacing="12">
                <controls:FullScoreboard x:Name="CompletedScoreboard"
                                         Profile="CompletedPortrait"
                                         HeaderText="{x:Static strings:AppResources.FinalStatus}"
                                         VisitorName="{Binding CompletedVisitorName}"
                                         VisitorScore="{Binding CompletedVisitorScore}"
                                         HomeName="{Binding CompletedHomeName}"
                                         HomeScore="{Binding CompletedHomeScore}"
                                         HeaderAutomationId="CompletedGameStatus"
                                         VisitorNameAutomationId="CompletedVisitorName"
                                         VisitorScoreAutomationId="CompletedVisitorScore"
                                         HomeNameAutomationId="CompletedHomeName"
                                         HomeScoreAutomationId="CompletedHomeScore" />

                <VerticalStackLayout x:Name="CompletedViewButtons"
                                     Grid.Row="1" HorizontalOptions="Center" Spacing="8">
                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="16">
                    <Button AutomationId="GameStatsButton" Text="{x:Static strings:AppResources.GameStatsButton}"
                            Command="{Binding ShowGameStatsCommand}"
                            MinimumHeightRequest="48"
                            SemanticProperties.Description="{x:Static strings:AppResources.GameStatsInactiveAccessibilityText}"
                            Style="{StaticResource CompletedGameViewButton}">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding ShowingGameStats}" Value="True">
                                <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                <Setter Property="BorderColor" Value="{StaticResource Primary}" />
                                <Setter Property="SemanticProperties.Description" Value="{x:Static strings:AppResources.GameStatsActiveAccessibilityText}" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    <Button AutomationId="GamePlaysButton" Text="{x:Static strings:AppResources.GamePlaysButton}"
                            Command="{Binding ShowGamePlaysCommand}"
                            MinimumHeightRequest="48"
                            SemanticProperties.Description="{x:Static strings:AppResources.GamePlaysInactiveAccessibilityText}"
                            Style="{StaticResource CompletedGameViewButton}">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding ShowingGamePlays}" Value="True">
                                <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                <Setter Property="BorderColor" Value="{StaticResource Primary}" />
                                <Setter Property="SemanticProperties.Description" Value="{x:Static strings:AppResources.GamePlaysActiveAccessibilityText}" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    </HorizontalStackLayout>

                    <Border AutomationId="ManualOverrideChip"
                            IsVisible="{Binding ShowManualOverrideChip}"
                            HorizontalOptions="Center" Padding="12,5"
                            BackgroundColor="{AppThemeBinding Light={StaticResource WarningSurface}, Dark={StaticResource WarningSurfaceDark}}"
                            StrokeShape="RoundRectangle 12">
                        <Label Text="{x:Static strings:AppResources.ManualOverrideChip}"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource WarningText}, Dark={StaticResource WarningTextDark}}" />
                    </Border>

                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="12"
                                           IsVisible="{Binding ShowBeginManualOverride}">
                        <Button AutomationId="BeginManualOverrideButton"
                                Text="{x:Static strings:AppResources.ManualOverrideEditStatsButton}"
                                Command="{Binding BeginManualOverrideCommand}"
                                MinimumHeightRequest="48" />
                        <Button AutomationId="RevertManualOverridesButton"
                                Text="{x:Static strings:AppResources.RevertToGamePlaysStatsButton}"
                                Command="{Binding RevertManualOverridesCommand}"
                                IsVisible="{Binding ShowRevertManualOverrides}"
                                MinimumHeightRequest="48" />
                    </HorizontalStackLayout>

                    <VerticalStackLayout IsVisible="{Binding IsManualOverrideEditing}" Spacing="8">
                        <Grid ColumnDefinitions="Auto,90,Auto,90" ColumnSpacing="10"
                              HorizontalOptions="Center" VerticalOptions="Center">
                            <Label Text="{x:Static strings:AppResources.ManualOverrideVisitorScoreLabel}"
                                   VerticalTextAlignment="Center" />
                            <Entry AutomationId="ManualOverrideVisitorScore"
                                   Grid.Column="1" Text="{Binding CompletedVisitorScoreEdit}"
                                   Keyboard="Numeric" HorizontalTextAlignment="Center"
                                   SemanticProperties.Description="{Binding CompletedVisitorScoreEditDescription}">
                                <Entry.Triggers><DataTrigger TargetType="Entry" Binding="{Binding IsCompletedVisitorScoreDirty}" Value="True"><Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource WarningSurface}, Dark={StaticResource WarningSurfaceDark}}" /></DataTrigger></Entry.Triggers>
                            </Entry>
                            <Label Grid.Column="2"
                                   Text="{x:Static strings:AppResources.ManualOverrideHomeScoreLabel}"
                                   VerticalTextAlignment="Center" />
                            <Entry AutomationId="ManualOverrideHomeScore"
                                   Grid.Column="3" Text="{Binding CompletedHomeScoreEdit}"
                                   Keyboard="Numeric" HorizontalTextAlignment="Center"
                                   SemanticProperties.Description="{Binding CompletedHomeScoreEditDescription}">
                                <Entry.Triggers><DataTrigger TargetType="Entry" Binding="{Binding IsCompletedHomeScoreDirty}" Value="True"><Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource WarningSurface}, Dark={StaticResource WarningSurfaceDark}}" /></DataTrigger></Entry.Triggers>
                            </Entry>
                        </Grid>
                        <HorizontalStackLayout HorizontalOptions="Center" Spacing="12">
                            <Button AutomationId="SaveManualOverrideButton"
                                    Text="{x:Static strings:AppResources.SaveButton}"
                                    Command="{Binding SaveManualOverrideCommand}"
                                    MinimumHeightRequest="48" MinimumWidthRequest="120" />
                            <Button AutomationId="CancelManualOverrideButton"
                                    Text="{x:Static strings:AppResources.CancelButton}"
                                    Command="{Binding CancelManualOverrideCommand}"
                                    MinimumHeightRequest="48" MinimumWidthRequest="120" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <Label x:Name="CompletedStatsHeading"
                       Grid.Row="2" Text="{x:Static strings:AppResources.BattingStatisticsHeading}"
                       IsVisible="{Binding ShowingGameStats}"
                       Style="{StaticResource SubHeadline}" SemanticProperties.HeadingLevel="Level2" />

                <Grid x:Name="CompletedGameStatsView"
                      Grid.Row="3" AutomationId="CompletedGameStatsView"
                      IsVisible="{Binding ShowingGameStats}">
                    <controls:BattingStatisticsGrid
                        BindingContext="{Binding CompletedBattingStatistics}" />
                </Grid>

                <ScrollView x:Name="CompletedGamePlaysView"
                            Grid.Row="3" AutomationId="CompletedGamePlaysView"
                            IsVisible="{Binding ShowingGamePlays}">
                    <VerticalStackLayout Spacing="14" BindableLayout.ItemsSource="{Binding CompletedGamePlays}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:CompletedGameHalfInningViewModel">
                                <Border Stroke="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"
                                        StrokeShape="RoundRectangle 8" Padding="14">
                                    <VerticalStackLayout Spacing="6">
                                        <Label Text="{Binding Heading}" FontSize="20" FontAttributes="Bold" />
                                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Plays}" Spacing="10">
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate x:DataType="viewModels:CompletedGamePlayViewModel">
                                                    <VerticalStackLayout Spacing="2">
                                                        <Label Text="{Binding LineupChangeDisplay}" FontSize="18"
                                                               FontAttributes="Italic" IsVisible="{Binding IsLineupChange}" />
                                                        <Label Text="{Binding BatterResultDisplay}" FontSize="18"
                                                               FontAttributes="Bold" IsVisible="{Binding IsPlateAppearance}" />
                                                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding RunnerMovements}"
                                                                             IsVisible="{Binding IsPlateAppearance}">
                                                            <BindableLayout.ItemTemplate>
                                                                <DataTemplate x:DataType="x:String">
                                                                    <Label Text="{Binding .}" />
                                                                </DataTemplate>
                                                            </BindableLayout.ItemTemplate>
                                                        </VerticalStackLayout>
                                                        <Label Text="{Binding Score}" FontAttributes="Bold"
                                                               IsVisible="{Binding IsPlateAppearance}" />
                                                    </VerticalStackLayout>
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </VerticalStackLayout>
                                        <VerticalStackLayout IsVisible="{Binding IsOpponentSummary}" Spacing="2">
                                            <Label Text="{Binding OpponentRuns}" />
                                            <Label Text="{Binding OpponentHomeRuns}" />
                                            <Label Text="{Binding OpponentTotalHomeRuns}" />
                                            <Label Text="{Binding OpponentScore}" FontAttributes="Bold" />
                                        </VerticalStackLayout>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </ScrollView>

                <Border x:Name="CompletedGameInfoPanel"
                        Grid.Row="4"
                        Stroke="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"
                        StrokeShape="RoundRectangle 8" Padding="14,8">
                    <Grid x:Name="CompletedGameInfoGrid"
                          RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,*"
                          RowSpacing="6" ColumnSpacing="24">
                        <HorizontalStackLayout x:Name="CompletedSeasonInfo" Spacing="6">
                            <Label Text="{x:Static strings:AppResources.SeasonLabel}" FontAttributes="Bold" />
                            <Label Text="{Binding SeasonDisplay}" LineBreakMode="TailTruncation" MaxLines="1" />
                        </HorizontalStackLayout>
                        <HorizontalStackLayout x:Name="CompletedOpponentInfo" Grid.Column="1" Spacing="6">
                            <Label Text="{x:Static strings:AppResources.OpponentLabel}" FontAttributes="Bold" />
                            <Label Text="{Binding OpponentDisplay}" LineBreakMode="TailTruncation" MaxLines="1" />
                        </HorizontalStackLayout>
                        <HorizontalStackLayout x:Name="CompletedDateInfo" Grid.Row="1" Spacing="6">
                            <Label Text="{x:Static strings:AppResources.GameDateLabel}" FontAttributes="Bold" />
                            <Label Text="{Binding DateDisplay}" LineBreakMode="TailTruncation" MaxLines="1" />
                        </HorizontalStackLayout>
                        <HorizontalStackLayout x:Name="CompletedTimeInfo"
                                               Grid.Row="1" Grid.Column="1" Spacing="6">
                            <Label Text="{x:Static strings:AppResources.GameTimeLabel}" FontAttributes="Bold" />
                            <Label Text="{Binding TimeDisplay}" LineBreakMode="TailTruncation" MaxLines="1" />
                        </HorizontalStackLayout>
                        <HorizontalStackLayout x:Name="CompletedFieldInfo" Grid.Row="2" Spacing="6">
                            <Label Text="{x:Static strings:AppResources.FieldLabel}" FontAttributes="Bold" />
                            <Label Text="{Binding FieldDisplay}" LineBreakMode="TailTruncation" MaxLines="1" />
                        </HorizontalStackLayout>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</ContentPage>
