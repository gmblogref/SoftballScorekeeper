<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SoftballScorekeeper.Views.RunnerDestinationDialog"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:services="clr-namespace:SoftballScorekeeper.Services"
    xmlns:strings="clr-namespace:SoftballScorekeeper.Resources.Strings"
    Shell.NavBarIsVisible="False"
    BackgroundColor="#99000000">
    <Grid x:Name="DialogOverlay" Padding="36">
        <Grid.Triggers>
            <DataTrigger TargetType="Grid"
                         Binding="{Binding IsCompactLandscape, Source={x:Static services:ResponsiveLayoutState.Current}, x:DataType=services:ResponsiveLayoutState}"
                         Value="True">
                <Setter Property="Padding" Value="12" />
            </DataTrigger>
        </Grid.Triggers>
        <Border AutomationId="RunnerDestinationDialog"
                x:Name="DialogCard"
                Padding="28"
                MaximumWidthRequest="680"
                HorizontalOptions="Fill"
                VerticalOptions="Center"
                BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource Gray900}}"
                Stroke="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"
                StrokeShape="RoundRectangle 16">
            <Border.Triggers>
                <DataTrigger TargetType="Border"
                             Binding="{Binding IsCompactLandscape, Source={x:Static services:ResponsiveLayoutState.Current}, x:DataType=services:ResponsiveLayoutState}"
                             Value="True">
                    <Setter Property="Padding" Value="16" />
                </DataTrigger>
            </Border.Triggers>
            <VerticalStackLayout x:Name="DialogContent" Spacing="16">
                <VerticalStackLayout.Triggers>
                    <DataTrigger TargetType="VerticalStackLayout"
                                 Binding="{Binding IsCompactLandscape, Source={x:Static services:ResponsiveLayoutState.Current}, x:DataType=services:ResponsiveLayoutState}"
                                 Value="True">
                        <Setter Property="Spacing" Value="8" />
                    </DataTrigger>
                </VerticalStackLayout.Triggers>
                <Label x:Name="FielderChoiceContextLabel"
                       IsVisible="False"
                       FontSize="14"
                       HorizontalTextAlignment="Center"
                       TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
                <Label x:Name="PlayerNameLabel"
                       FontSize="28"
                       FontAttributes="Bold"
                       HorizontalTextAlignment="Center" />
                <Label x:Name="StartingLocationLabel"
                       IsVisible="False"
                       FontSize="16"
                       HorizontalTextAlignment="Center"
                       TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
                <Label x:Name="CurrentOutcomeLabel"
                       AutomationId="RunnerCurrentOutcomeLabel"
                       FontSize="18"
                       FontAttributes="Bold"
                       HorizontalTextAlignment="Center"
                       TextColor="{StaticResource Primary}" />
                <BoxView HeightRequest="1"
                         Color="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}" />
                <Label Text="{x:Static strings:AppResources.ChooseOutcomeInstruction}"
                       FontSize="16"
                       HorizontalTextAlignment="Center" />
                <FlexLayout x:Name="DestinationButtons"
                            Direction="Row"
                            Wrap="Wrap"
                            JustifyContent="Center"
                            AlignItems="Center" />
                <Button AutomationId="RunnerDestinationCancelButton"
                        Text="{x:Static strings:AppResources.CancelButton}"
                        Clicked="OnCancelClicked"
                        MinimumHeightRequest="56"
                        MinimumWidthRequest="170"
                        HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
