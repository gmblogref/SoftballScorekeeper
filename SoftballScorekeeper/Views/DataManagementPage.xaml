<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:strings="clr-namespace:SoftballScorekeeper.Resources.Strings"
             xmlns:viewModels="clr-namespace:SoftballScorekeeper.ViewModels"
             x:Class="SoftballScorekeeper.Views.DataManagementPage"
             x:DataType="viewModels:DataManagementViewModel"
             Title="{x:Static strings:AppResources.DataManagementTitle}">
    <ScrollView>
        <VerticalStackLayout Style="{StaticResource ResponsivePageStack}">
            <Label
                Text="{x:Static strings:AppResources.DataManagementTitle}"
                Style="{StaticResource ResponsiveHeadline}"
                SemanticProperties.HeadingLevel="Level1" />
            <ActivityIndicator
                AutomationId="BackupDataActivityIndicator"
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}"
                HorizontalOptions="Start" />
            <Label
                AutomationId="PortableDataProductionOnlyMessage"
                Text="{x:Static strings:AppResources.PortableDataProductionOnlyMessage}"
                IsVisible="{Binding IsTestMode}"
                FontAttributes="Bold"
                TextColor="{StaticResource Error}" />
            <Label
                Text="{x:Static strings:AppResources.BackupDataDescription}"
                FontSize="18" />
            <HorizontalStackLayout Spacing="16">
                <Button
                    AutomationId="BackupDataButton"
                    Text="{x:Static strings:AppResources.BackupDataButton}"
                    Command="{Binding BackupDataCommand}"
                    MinimumHeightRequest="56"
                    MinimumWidthRequest="200"
                    Padding="28,14" />
            </HorizontalStackLayout>
            <BoxView HeightRequest="1" Margin="0,12" />
            <Label
                Text="{x:Static strings:AppResources.RestoreDataDescription}"
                FontSize="18" />
            <Button
                AutomationId="RestoreDataButton"
                Text="{x:Static strings:AppResources.RestoreDataButton}"
                Command="{Binding RestoreDataCommand}"
                MinimumHeightRequest="56"
                MinimumWidthRequest="200"
                HorizontalOptions="Start"
                Padding="28,14" />
            <Label
                AutomationId="BackupDataStatus"
                Text="{Binding StatusMessage}"
                IsVisible="{Binding HasStatusMessage}"
                FontSize="18" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
