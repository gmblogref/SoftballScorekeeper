<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:strings="clr-namespace:SoftballScorekeeper.Resources.Strings"
             xmlns:viewModels="clr-namespace:SoftballScorekeeper.ViewModels"
             x:Class="SoftballScorekeeper.Views.ScoringPage"
             x:DataType="viewModels:ScoringViewModel"
             Shell.FlyoutBehavior="Disabled"
             Shell.NavBarIsVisible="False"
             Title="{x:Static strings:AppResources.ScoringTitle}">
    <Grid Padding="40" RowDefinitions="Auto,Auto,Auto,Auto,*" RowSpacing="18">
        <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*">
            <Button Text="&#x2630;"
                    Clicked="OnScoringMenuClicked"
                    FontSize="28"
                    MinimumHeightRequest="52"
                    MinimumWidthRequest="64"
                    HorizontalOptions="Start"
                    Padding="12,6"
                    SemanticProperties.Description="{x:Static strings:AppResources.ScoringMenuAccessibility}" />
            <Label Grid.Column="1"
                   Text="{x:Static strings:AppResources.ScoringTitle}"
                   Style="{StaticResource Headline}"
                   VerticalOptions="Center"
                   SemanticProperties.HeadingLevel="Level1" />
            <Border x:Name="ScoringMenu"
                    Grid.Row="1"
                    IsVisible="False"
                    HorizontalOptions="Start"
                    BackgroundColor="White"
                    Stroke="Black"
                    StrokeShape="RoundRectangle 8"
                    Padding="0">
                <VerticalStackLayout Spacing="0">
                    <Button Text="{x:Static strings:AppResources.ExitGameButton}"
                            Clicked="OnExitGameClicked"
                            BackgroundColor="Transparent"
                            TextColor="Black"
                            MinimumHeightRequest="52"
                            MinimumWidthRequest="180"
                            Padding="20,12" />
                    <BoxView BackgroundColor="Black" HeightRequest="1" />
                </VerticalStackLayout>
            </Border>
        </Grid>
        <Label Grid.Row="1" Text="{Binding ValidationMessage}" HorizontalTextAlignment="Center" />
        <Border Grid.Row="2"
                IsVisible="{Binding IsLoaded}"
                Stroke="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"
                StrokeShape="RoundRectangle 12"
                Padding="24,16">
            <Grid ColumnDefinitions="*,1,*" ColumnSpacing="24">
                <VerticalStackLayout Spacing="4" HorizontalOptions="Fill">
                    <Label Text="{x:Static strings:AppResources.HomeScoreboardHeading}"
                           FontSize="20"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center" />
                    <Label Text="{Binding HomeTeamDisplayName}"
                           FontSize="24"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center"
                           LineBreakMode="TailTruncation"
                           MaxLines="1" />
                    <Label Text="{Binding HomeScore}"
                           FontSize="64"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
                <BoxView Grid.Column="1"
                         BackgroundColor="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}" />
                <VerticalStackLayout Grid.Column="2" Spacing="4" HorizontalOptions="Fill">
                    <Label Text="{x:Static strings:AppResources.VisitorScoreboardHeading}"
                           FontSize="20"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center" />
                    <Label Text="{Binding VisitorTeamDisplayName}"
                           FontSize="24"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center"
                           LineBreakMode="TailTruncation"
                           MaxLines="1" />
                    <Label Text="{Binding VisitorScore}"
                           FontSize="64"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Grid>
        </Border>
        <VerticalStackLayout Grid.Row="3"
                             IsVisible="{Binding IsLoaded}"
                             Spacing="6"
                             HorizontalOptions="Center">
            <Label Text="{x:Static strings:AppResources.CurrentBatterHeading}"
                   FontSize="20"
                   FontAttributes="Bold"
                   HorizontalTextAlignment="Center" />
            <Label Text="{Binding CurrentBatterDisplayName}"
                   FontSize="32"
                   HorizontalTextAlignment="Center" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
