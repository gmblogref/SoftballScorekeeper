<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:strings="clr-namespace:SoftballScorekeeper.Resources.Strings"
             xmlns:viewModels="clr-namespace:SoftballScorekeeper.ViewModels"
             x:Class="SoftballScorekeeper.Views.ScoringPage"
             x:DataType="viewModels:ScoringViewModel"
             Shell.FlyoutBehavior="Disabled"
             Shell.NavBarIsVisible="False"
             Title="{x:Static strings:AppResources.ScoringTitle}">
    <Grid Padding="40" RowDefinitions="Auto,Auto,Auto,Auto,*" RowSpacing="18">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="ScoreboardLayoutStates">
                <VisualState x:Name="PortraitScoreboard">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="LandscapeScoreboard">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="900" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter TargetName="ScoreboardBorder" Property="Padding" Value="16,6" />
                        <Setter TargetName="ScoreboardGrid" Property="RowSpacing" Value="2" />
                        <Setter TargetName="HomeScoreboard" Property="RowSpacing" Value="0" />
                        <Setter TargetName="VisitorScoreboard" Property="RowSpacing" Value="0" />
                        <Setter TargetName="HomeHeading" Property="Label.FontSize" Value="16" />
                        <Setter TargetName="VisitorHeading" Property="Label.FontSize" Value="16" />
                        <Setter TargetName="HomeTeamName" Property="Label.FontSize" Value="19" />
                        <Setter TargetName="VisitorTeamName" Property="Label.FontSize" Value="19" />
                        <Setter TargetName="HomeScoreValue" Property="Label.FontSize" Value="44" />
                        <Setter TargetName="VisitorScoreValue" Property="Label.FontSize" Value="44" />
                        <Setter TargetName="HomeScoreValue" Property="Grid.Row" Value="0" />
                        <Setter TargetName="VisitorScoreValue" Property="Grid.Row" Value="0" />
                        <Setter TargetName="HomeScoreValue" Property="Grid.Column" Value="1" />
                        <Setter TargetName="VisitorScoreValue" Property="Grid.Column" Value="1" />
                        <Setter TargetName="HomeScoreValue" Property="Grid.RowSpan" Value="2" />
                        <Setter TargetName="VisitorScoreValue" Property="Grid.RowSpan" Value="2" />
                        <Setter TargetName="InningOutLabel" Property="Label.FontSize" Value="16" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*">
            <Button Text="&#x2630;"
                    Clicked="OnScoringMenuClicked"
                    FontSize="28"
                    MinimumHeightRequest="52"
                    MinimumWidthRequest="64"
                    HorizontalOptions="Start"
                    Padding="12,6"
                    SemanticProperties.Description="{x:Static strings:AppResources.ScoringMenuAccessibility}" />
            <Label Grid.Column="1"
                   Text="{x:Static strings:AppResources.ScoringTitle}"
                   Style="{StaticResource Headline}"
                   VerticalOptions="Center"
                   SemanticProperties.HeadingLevel="Level1" />
            <Border x:Name="ScoringMenu"
                    Grid.Row="1"
                    IsVisible="False"
                    HorizontalOptions="Start"
                    BackgroundColor="White"
                    Stroke="Black"
                    StrokeShape="RoundRectangle 8"
                    Padding="0">
                <VerticalStackLayout Spacing="0">
                    <Button Text="{x:Static strings:AppResources.ExitGameButton}"
                            Clicked="OnExitGameClicked"
                            BackgroundColor="Transparent"
                            TextColor="Black"
                            MinimumHeightRequest="52"
                            MinimumWidthRequest="180"
                            Padding="20,12" />
                    <BoxView BackgroundColor="Black" HeightRequest="1" />
                </VerticalStackLayout>
            </Border>
        </Grid>
        <Label Grid.Row="1" Text="{Binding ValidationMessage}" HorizontalTextAlignment="Center" />
        <Border x:Name="ScoreboardBorder"
                Grid.Row="2"
                IsVisible="{Binding IsLoaded}"
                Stroke="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"
                StrokeShape="RoundRectangle 12"
                Padding="24,16">
            <Grid x:Name="ScoreboardGrid"
                  ColumnDefinitions="*,1,*" RowDefinitions="Auto,Auto"
                  ColumnSpacing="24" RowSpacing="8">
                <Grid x:Name="HomeScoreboard"
                      ColumnDefinitions="*,Auto"
                      RowDefinitions="Auto,Auto,Auto"
                      RowSpacing="4"
                      HorizontalOptions="Fill">
                    <Label x:Name="HomeHeading"
                           Text="{x:Static strings:AppResources.HomeScoreboardHeading}"
                           FontSize="20"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center" />
                    <Label x:Name="HomeTeamName"
                           Grid.Row="1"
                           Text="{Binding HomeTeamDisplayName}"
                           FontSize="24"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center"
                           LineBreakMode="TailTruncation"
                           MaxLines="1" />
                    <Label x:Name="HomeScoreValue"
                           Grid.Row="2"
                           Text="{Binding HomeScore}"
                           FontSize="64"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center" />
                </Grid>
                <BoxView Grid.Column="1"
                         BackgroundColor="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}" />
                <Grid x:Name="VisitorScoreboard"
                      Grid.Column="2"
                      ColumnDefinitions="*,Auto"
                      RowDefinitions="Auto,Auto,Auto"
                      RowSpacing="4"
                      HorizontalOptions="Fill">
                    <Label x:Name="VisitorHeading"
                           Text="{x:Static strings:AppResources.VisitorScoreboardHeading}"
                           FontSize="20"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center" />
                    <Label x:Name="VisitorTeamName"
                           Grid.Row="1"
                           Text="{Binding VisitorTeamDisplayName}"
                           FontSize="24"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center"
                           LineBreakMode="TailTruncation"
                           MaxLines="1" />
                    <Label x:Name="VisitorScoreValue"
                           Grid.Row="2"
                           Text="{Binding VisitorScore}"
                           FontSize="64"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center" />
                </Grid>
                <Label x:Name="InningOutLabel"
                       Grid.Row="1" Grid.ColumnSpan="3"
                       Text="{Binding InningOutDisplay}"
                       FontSize="20"
                       FontAttributes="Bold"
                       HorizontalTextAlignment="Center" />
            </Grid>
        </Border>
        <ScrollView Grid.Row="3" Grid.RowSpan="2" IsVisible="{Binding IsLoaded}">
            <VerticalStackLayout Spacing="10">
                <Label Text="{x:Static strings:AppResources.BasesHeading}"
                       FontAttributes="Bold" HorizontalTextAlignment="Center" />
                <Grid ColumnDefinitions="*,Auto,*"
                      RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                      RowSpacing="12">
                    <VerticalStackLayout Grid.Row="0" Grid.Column="1"
                                         Spacing="6" WidthRequest="160">
                        <Label Text="{Binding SecondBaseRunner.BaseLabel}"
                               FontAttributes="Bold" HorizontalTextAlignment="Center" />
                        <Button CommandParameter="{Binding SecondBaseRunner}"
                                Text="{Binding SecondBaseRunner.PlayerName}"
                                IsEnabled="{Binding SecondBaseRunner.IsOccupied}"
                                Clicked="OnRunnerButtonClicked" BackgroundColor="White"
                                BorderColor="{StaticResource Gray400}" BorderWidth="1"
                                TextColor="Black" MinimumWidthRequest="160"
                                MinimumHeightRequest="66" FontSize="16"
                                FontAttributes="Bold" Padding="14,8" />
                        <Label Text="{Binding SecondBaseRunner.RoleLabel}"
                               IsVisible="{Binding SecondBaseRunner.IsCurrentBatter}"
                               FontSize="12" FontAttributes="Bold"
                               TextColor="{StaticResource Primary}"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Row="1" Grid.Column="0"
                                         Spacing="6" WidthRequest="160"
                                         HorizontalOptions="Center">
                        <Label Text="{Binding ThirdBaseRunner.BaseLabel}"
                               FontAttributes="Bold" HorizontalTextAlignment="Center" />
                        <Button CommandParameter="{Binding ThirdBaseRunner}"
                                Text="{Binding ThirdBaseRunner.PlayerName}"
                                IsEnabled="{Binding ThirdBaseRunner.IsOccupied}"
                                Clicked="OnRunnerButtonClicked" BackgroundColor="White"
                                BorderColor="{StaticResource Gray400}" BorderWidth="1"
                                TextColor="Black" MinimumWidthRequest="160"
                                MinimumHeightRequest="66" FontSize="16"
                                FontAttributes="Bold" Padding="14,8" />
                        <Label Text="{Binding ThirdBaseRunner.RoleLabel}"
                               IsVisible="{Binding ThirdBaseRunner.IsCurrentBatter}"
                               FontSize="12" FontAttributes="Bold"
                               TextColor="{StaticResource Primary}"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Row="1" Grid.Column="2"
                                         Spacing="6" WidthRequest="160"
                                         HorizontalOptions="Center">
                        <Label Text="{Binding FirstBaseRunner.BaseLabel}"
                               FontAttributes="Bold" HorizontalTextAlignment="Center" />
                        <Button CommandParameter="{Binding FirstBaseRunner}"
                                Text="{Binding FirstBaseRunner.PlayerName}"
                                IsEnabled="{Binding FirstBaseRunner.IsOccupied}"
                                Clicked="OnRunnerButtonClicked" BackgroundColor="White"
                                BorderColor="{StaticResource Gray400}" BorderWidth="1"
                                TextColor="Black" MinimumWidthRequest="160"
                                MinimumHeightRequest="66" FontSize="16"
                                FontAttributes="Bold" Padding="14,8" />
                        <Label Text="{Binding FirstBaseRunner.RoleLabel}"
                               IsVisible="{Binding FirstBaseRunner.IsCurrentBatter}"
                               FontSize="12" FontAttributes="Bold"
                               TextColor="{StaticResource Primary}"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                    <Button Grid.Row="2" Grid.Column="1"
                            Text="{x:Static strings:AppResources.CompletePlateAppearanceButton}"
                            IsEnabled="{Binding CanCompletePlateAppearance}"
                            Clicked="OnNextBatterClicked"
                            MinimumHeightRequest="56"
                            MinimumWidthRequest="260"
                            HorizontalOptions="Center"
                            Padding="24,14" />
                    <Label Grid.Row="3" Grid.Column="1"
                           Text="{Binding RunsOnPlayDisplay}"
                           IsVisible="{Binding HasPendingPlay}"
                           FontSize="18"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center" />
                    <Border Grid.Row="4" Grid.Column="1"
                            IsVisible="{Binding IsAwaitingResult}"
                            Stroke="{StaticResource Primary}"
                            StrokeThickness="2"
                            StrokeShape="RoundRectangle 12"
                            Padding="18,10"
                            HorizontalOptions="Center"
                            MinimumWidthRequest="360">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnBatterTapped" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                            <Label Text="{x:Static strings:AppResources.BatterBadgeLabel}"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource Primary}"
                                   HorizontalTextAlignment="Center" />
                            <Label Text="{Binding CurrentBatterDisplayName}"
                                   FontSize="28"
                                   FontAttributes="Bold"
                                   HorizontalTextAlignment="Center" />
                            <Label Text="{x:Static strings:AppResources.TapBatterHint}"
                                   FontSize="13"
                                   HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>
                    <VerticalStackLayout Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3"
                                         IsVisible="{Binding HasPendingPlay}"
                                         Spacing="6" HorizontalOptions="Center">
                        <Label Text="{x:Static strings:AppResources.ScoredHeading}"
                               FontAttributes="Bold" HorizontalTextAlignment="Center" />
                        <CollectionView ItemsSource="{Binding ScoredPlayers}" SelectionMode="None"
                                        ItemsLayout="HorizontalList" HorizontalOptions="Center">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="viewModels:ScoredPlayerViewModel">
                                    <Button Text="{Binding DisplayText}" Clicked="OnRunnerButtonClicked"
                                            Margin="6,0" MinimumWidthRequest="190"
                                            MinimumHeightRequest="68" FontSize="16"
                                            FontAttributes="Bold" Padding="14,8" />
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                        <Label Text="{x:Static strings:AppResources.EmptyBaseLabel}"
                               IsVisible="{Binding HasNoScoredPlayers}"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Grid>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
