<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:SoftballScorekeeper.Views.Controls"
             xmlns:services="clr-namespace:SoftballScorekeeper.Services"
             xmlns:strings="clr-namespace:SoftballScorekeeper.Resources.Strings"
             xmlns:viewModels="clr-namespace:SoftballScorekeeper.ViewModels"
             x:Class="SoftballScorekeeper.Views.ScoringPage"
             x:DataType="viewModels:ScoringViewModel"
             Shell.FlyoutBehavior="Disabled"
             Shell.NavBarIsVisible="False"
             Title="{x:Static strings:AppResources.ScoringTitle}">
    <ContentPage.Resources>
        <Style x:Key="BaseRunnerButtonStyle" TargetType="Button">
            <Setter Property="BorderWidth" Value="1" />
            <Setter Property="TextColor" Value="Black" />
        </Style>
    </ContentPage.Resources>
    <Grid x:Name="ScoringOverlayGrid">
    <Grid x:Name="RootGrid"
          Padding="40" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="14">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="ScoreboardLayoutStates">
                <VisualState x:Name="PortraitScoreboard">
                </VisualState>
                <VisualState x:Name="CompactPortraitScoreboard">
                    <VisualState.Setters>
                        <Setter TargetName="RootGrid" Property="Padding" Value="12,6" />
                        <Setter TargetName="RootGrid" Property="RowSpacing" Value="4" />
                        <Setter TargetName="ScoringMenu" Property="Margin" Value="12,54,0,0" />
                        <Setter TargetName="ScoringPageTitle" Property="Label.FontSize" Value="20" />
                        <Setter TargetName="FullScoreboard"
                                Property="controls:FullScoreboard.Profile"
                                Value="LiveCompactPortrait" />
                        <Setter TargetName="ScoringContentLayout" Property="RowSpacing" Value="4" />
                        <Setter TargetName="FieldSection" Property="RowSpacing" Value="2" />
                        <Setter TargetName="FieldGrid" Property="RowSpacing" Value="3" />
                        <Setter TargetName="SecondBaseRunnerButton" Property="MinimumHeightRequest" Value="52" />
                        <Setter TargetName="ThirdBaseRunnerButton" Property="MinimumHeightRequest" Value="52" />
                        <Setter TargetName="FirstBaseRunnerButton" Property="MinimumHeightRequest" Value="52" />
                        <Setter TargetName="NextBatterButton" Property="MinimumHeightRequest" Value="48" />
                        <Setter TargetName="NextBatterButton" Property="Padding" Value="14,6" />
                        <Setter TargetName="CurrentBatterBorder" Property="WidthRequest" Value="320" />
                        <Setter TargetName="CurrentBatterBorder" Property="Padding" Value="8,4" />
                        <Setter TargetName="CurrentBatterName" Property="Label.FontSize" Value="22" />
                        <Setter TargetName="PortraitInfoPanels" Property="RowSpacing" Value="4" />
                        <Setter TargetName="PortraitInfoPanels" Property="Margin" Value="8,4,8,0" />
                        <Setter TargetName="UpcomingInfoPanel" Property="Padding" Value="10,6" />
                        <Setter TargetName="OutsInfoPanel" Property="Padding" Value="10,6" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="LandscapeScoreboard">
                    <VisualState.Setters>
                        <Setter TargetName="RootGrid" Property="Padding" Value="20,8" />
                        <Setter TargetName="RootGrid" Property="RowSpacing" Value="6" />
                        <Setter TargetName="ScoringMenu" Property="Margin" Value="20,64,0,0" />
                        <Setter TargetName="FullScoreboard"
                                Property="controls:FullScoreboard.Profile"
                                Value="LiveRegularLandscape" />
                        <Setter TargetName="ScoringPageTitle" Property="Label.FontSize" Value="24" />
                        <Setter TargetName="ScoringContentLayout" Property="ColumnDefinitions" Value="210,1,*,1,240" />
                        <Setter TargetName="ScoringContentLayout" Property="RowDefinitions" Value="*" />
                        <Setter TargetName="FieldSection" Property="Grid.Row" Value="0" />
                        <Setter TargetName="FieldSection" Property="Grid.Column" Value="2" />
                        <Setter TargetName="FieldSection" Property="RowDefinitions" Value="Auto,Auto" />
                        <Setter TargetName="FieldSection" Property="VerticalOptions" Value="Center" />
                        <Setter TargetName="PortraitInfoPanels" Property="Grid.Row" Value="0" />
                        <Setter TargetName="PortraitInfoPanels" Property="Grid.Column" Value="0" />
                        <Setter TargetName="PortraitInfoPanels" Property="Grid.ColumnSpan" Value="5" />
                        <Setter TargetName="PortraitInfoPanels" Property="ColumnDefinitions" Value="210,*,240" />
                        <Setter TargetName="PortraitInfoPanels" Property="RowDefinitions" Value="Auto,*,Auto" />
                        <Setter TargetName="PortraitInfoPanels" Property="Margin" Value="0" />
                        <Setter TargetName="PortraitInfoPanels" Property="VerticalOptions" Value="Fill" />
                        <Setter TargetName="OutsInfoPanel" Property="Grid.Column" Value="2" />
                        <Setter TargetName="UndoScoringButton" Property="Grid.Row" Value="2" />
                        <Setter TargetName="RedoScoringButton" Property="Grid.Row" Value="2" />
                        <Setter TargetName="RedoScoringButton" Property="Grid.Column" Value="2" />
                        <Setter TargetName="LandscapeScoredArea" Property="Grid.Row" Value="1" />
                        <Setter TargetName="LandscapeScoredArea" Property="Grid.Column" Value="2" />
                        <Setter TargetName="UpcomingDivider" Property="Grid.Column" Value="1" />
                        <Setter TargetName="UpcomingDivider" Property="IsVisible" Value="True" />
                        <Setter TargetName="ScoredDivider" Property="Grid.Column" Value="3" />
                        <Setter TargetName="ScoredDivider" Property="IsVisible" Value="True" />
                        <Setter TargetName="LandscapeScoredArea" Property="IsVisible" Value="True" />
                        <Setter TargetName="FieldGrid" Property="RowDefinitions" Value="Auto,Auto,Auto,Auto" />
                        <Setter TargetName="FieldGrid" Property="RowSpacing" Value="6" />
                        <Setter TargetName="NextBatterButton" Property="MinimumWidthRequest" Value="210" />
                        <Setter TargetName="NextBatterButton" Property="MinimumHeightRequest" Value="52" />
                        <Setter TargetName="NextBatterButton" Property="Padding" Value="18,10" />
                        <Setter TargetName="CurrentBatterBorder" Property="Grid.Row" Value="3" />
                        <Setter TargetName="CurrentBatterBorder" Property="Grid.Column" Value="1" />
                        <Setter TargetName="CurrentBatterBorder" Property="Grid.ColumnSpan" Value="1" />
                        <Setter TargetName="CurrentBatterBorder" Property="WidthRequest" Value="260" />
                        <Setter TargetName="CurrentBatterBorder" Property="Margin" Value="0" />
                        <Setter TargetName="CurrentBatterBorder" Property="Padding" Value="12,6" />
                        <Setter TargetName="CurrentBatterName" Property="Label.FontSize" Value="22" />
                        <Setter TargetName="RunsOnPlayLabel" Property="Grid.Row" Value="3" />
                        <Setter TargetName="RunsOnPlayLabel" Property="Grid.Column" Value="2" />
                        <Setter TargetName="PortraitScoredArea" Property="Grid.Row" Value="3" />
                        <Setter TargetName="PortraitScoredArea" Property="IsVisible" Value="False" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CompactLandscapeScoreboard">
                    <VisualState.Setters>
                        <Setter TargetName="RootGrid" Property="Padding" Value="10,4" />
                        <Setter TargetName="RootGrid" Property="RowSpacing" Value="3" />
                        <Setter TargetName="ScoringMenu" Property="Margin" Value="10,48,0,0" />
                        <Setter TargetName="ScoringPageTitle" Property="Label.FontSize" Value="18" />
                        <Setter TargetName="FullScoreboard"
                                Property="controls:FullScoreboard.Profile"
                                Value="LiveCompactLandscape" />
                        <Setter TargetName="ScoringContentLayout" Property="ColumnDefinitions" Value="190,1,*,1,210" />
                        <Setter TargetName="ScoringContentLayout" Property="RowDefinitions" Value="*" />
                        <Setter TargetName="FieldSection" Property="Grid.Row" Value="0" />
                        <Setter TargetName="FieldSection" Property="Grid.Column" Value="2" />
                        <Setter TargetName="FieldSection" Property="RowDefinitions" Value="Auto,Auto" />
                        <Setter TargetName="FieldSection" Property="RowSpacing" Value="2" />
                        <Setter TargetName="FieldSection" Property="VerticalOptions" Value="Center" />
                        <Setter TargetName="PortraitInfoPanels" Property="Grid.Row" Value="0" />
                        <Setter TargetName="PortraitInfoPanels" Property="Grid.Column" Value="0" />
                        <Setter TargetName="PortraitInfoPanels" Property="Grid.ColumnSpan" Value="5" />
                        <Setter TargetName="PortraitInfoPanels" Property="ColumnDefinitions" Value="190,*,210" />
                        <Setter TargetName="PortraitInfoPanels" Property="RowDefinitions" Value="Auto,*,Auto" />
                        <Setter TargetName="PortraitInfoPanels" Property="Margin" Value="0" />
                        <Setter TargetName="PortraitInfoPanels" Property="VerticalOptions" Value="Fill" />
                        <Setter TargetName="OutsInfoPanel" Property="Grid.Column" Value="2" />
                        <Setter TargetName="UndoScoringButton" Property="Grid.Row" Value="2" />
                        <Setter TargetName="RedoScoringButton" Property="Grid.Row" Value="2" />
                        <Setter TargetName="RedoScoringButton" Property="Grid.Column" Value="2" />
                        <Setter TargetName="LandscapeScoredArea" Property="Grid.Row" Value="1" />
                        <Setter TargetName="LandscapeScoredArea" Property="Grid.Column" Value="2" />
                        <Setter TargetName="UpcomingDivider" Property="Grid.Column" Value="1" />
                        <Setter TargetName="UpcomingDivider" Property="IsVisible" Value="True" />
                        <Setter TargetName="ScoredDivider" Property="Grid.Column" Value="3" />
                        <Setter TargetName="ScoredDivider" Property="IsVisible" Value="True" />
                        <Setter TargetName="LandscapeScoredArea" Property="IsVisible" Value="True" />
                        <Setter TargetName="FieldGrid" Property="RowDefinitions" Value="Auto,Auto,Auto,Auto" />
                        <Setter TargetName="FieldGrid" Property="RowSpacing" Value="3" />
                        <Setter TargetName="SecondBaseRunnerButton" Property="MinimumHeightRequest" Value="52" />
                        <Setter TargetName="ThirdBaseRunnerButton" Property="MinimumHeightRequest" Value="52" />
                        <Setter TargetName="FirstBaseRunnerButton" Property="MinimumHeightRequest" Value="52" />
                        <Setter TargetName="NextBatterButton" Property="MinimumWidthRequest" Value="190" />
                        <Setter TargetName="NextBatterButton" Property="MinimumHeightRequest" Value="48" />
                        <Setter TargetName="NextBatterButton" Property="Padding" Value="14,6" />
                        <Setter TargetName="CurrentBatterBorder" Property="Grid.Row" Value="3" />
                        <Setter TargetName="CurrentBatterBorder" Property="Grid.Column" Value="1" />
                        <Setter TargetName="CurrentBatterBorder" Property="Grid.ColumnSpan" Value="1" />
                        <Setter TargetName="CurrentBatterBorder" Property="WidthRequest" Value="220" />
                        <Setter TargetName="CurrentBatterBorder" Property="Margin" Value="0" />
                        <Setter TargetName="CurrentBatterBorder" Property="Padding" Value="8,4" />
                        <Setter TargetName="CurrentBatterName" Property="Label.FontSize" Value="20" />
                        <Setter TargetName="RunsOnPlayLabel" Property="Grid.Row" Value="3" />
                        <Setter TargetName="RunsOnPlayLabel" Property="Grid.Column" Value="2" />
                        <Setter TargetName="PortraitScoredArea" Property="Grid.Row" Value="3" />
                        <Setter TargetName="PortraitScoredArea" Property="IsVisible" Value="False" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid ColumnDefinitions="Auto,*">
            <Button AutomationId="ScoringMenuButton" Text="&#x2630;"
                    Clicked="OnScoringMenuClicked"
                    FontSize="28"
                    MinimumHeightRequest="52"
                    MinimumWidthRequest="64"
                    HorizontalOptions="Start"
                    Padding="12,6"
                    SemanticProperties.Description="{x:Static strings:AppResources.ScoringMenuAccessibility}" />
            <Label x:Name="ScoringPageTitle" Grid.Column="1"
                   Text="{x:Static strings:AppResources.ScoringTitle}"
                   Style="{StaticResource Headline}"
                   VerticalOptions="Center"
                   SemanticProperties.HeadingLevel="Level1" />
        </Grid>
        <Label Grid.Row="1" Text="{Binding ValidationMessage}" HorizontalTextAlignment="Center" />
        <controls:FullScoreboard x:Name="FullScoreboard"
                                 Grid.Row="2"
                                 IsVisible="{Binding IsLoaded}"
                                 Profile="LiveRegularPortrait"
                                 VisitorName="{Binding VisitorTeamDisplayName}"
                                 VisitorScore="{Binding VisitorScore}"
                                 HomeName="{Binding HomeTeamDisplayName}"
                                 HomeScore="{Binding HomeScore}"
                                 VisitorDetailText="{Binding VisitorHomeRunDisplay}"
                                 HomeDetailText="{Binding HomeHomeRunDisplay}"
                                 CombinedStatusText="{Binding InningOutDisplay}"
                                 InningStatusText="{Binding InningDisplay}"
                                 OutsStatusText="{Binding OutsDisplay}"
                                 IsOneUpEnabled="{Binding IsOneUpEnabled}"
                                 VisitorScoreAutomationId="VisitorScoreValue"
                                 HomeScoreAutomationId="HomeScoreValue"
                                 CombinedStatusAutomationId="InningOutStateLabel"
                                 InningStatusAutomationId="InningStateLabel"
                                 OutsStatusAutomationId="OutsStateLabel" />
        <Grid x:Name="ScoringContentLayout"
              Grid.Row="3"
              IsVisible="{Binding IsOffenseAvailable}"
              RowDefinitions="Auto,Auto" ColumnDefinitions="*"
              RowSpacing="12">
                <Grid x:Name="FieldSection"
                      RowDefinitions="Auto,Auto"
                      RowSpacing="10">
                    <Label Text="{x:Static strings:AppResources.BasesHeading}"
                           FontAttributes="Bold" HorizontalTextAlignment="Center" />
                    <Grid x:Name="FieldGrid"
                          Grid.Row="1"
                          ColumnDefinitions="*,Auto,*"
                          RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                          RowSpacing="12">
                    <VerticalStackLayout Grid.Row="0" Grid.Column="1"
                                         Spacing="6" WidthRequest="160">
                        <Label Text="{Binding SecondBaseRunner.BaseLabel}"
                               FontAttributes="Bold" HorizontalTextAlignment="Center" />
                        <Button x:Name="SecondBaseRunnerButton" AutomationId="SecondBaseRunnerButton"
                                CommandParameter="{Binding SecondBaseRunner}"
                                Text="{Binding SecondBaseRunner.PlayerName}"
                                IsEnabled="{Binding SecondBaseRunner.IsOccupied}"
                                BackgroundColor="{Binding SecondBaseRunner.BackgroundColor}"
                                BorderColor="{Binding SecondBaseRunner.BorderColor}"
                                Clicked="OnRunnerButtonClicked"
                                Style="{StaticResource BaseRunnerButtonStyle}"
                                MinimumWidthRequest="160"
                                MinimumHeightRequest="66" FontSize="16"
                                FontAttributes="Bold" Padding="14,8" />
                        <Label Text="{Binding SecondBaseRunner.RoleLabel}"
                               IsVisible="{Binding SecondBaseRunner.IsCurrentBatter}"
                               FontSize="12" FontAttributes="Bold"
                               TextColor="{StaticResource Primary}"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Row="1" Grid.Column="0"
                                         Spacing="6" WidthRequest="160"
                                         HorizontalOptions="Center">
                        <Label Text="{Binding ThirdBaseRunner.BaseLabel}"
                               FontAttributes="Bold" HorizontalTextAlignment="Center" />
                        <Button x:Name="ThirdBaseRunnerButton" AutomationId="ThirdBaseRunnerButton"
                                CommandParameter="{Binding ThirdBaseRunner}"
                                Text="{Binding ThirdBaseRunner.PlayerName}"
                                IsEnabled="{Binding ThirdBaseRunner.IsOccupied}"
                                BackgroundColor="{Binding ThirdBaseRunner.BackgroundColor}"
                                BorderColor="{Binding ThirdBaseRunner.BorderColor}"
                                Clicked="OnRunnerButtonClicked"
                                Style="{StaticResource BaseRunnerButtonStyle}"
                                MinimumWidthRequest="160"
                                MinimumHeightRequest="66" FontSize="16"
                                FontAttributes="Bold" Padding="14,8" />
                        <Label Text="{Binding ThirdBaseRunner.RoleLabel}"
                               IsVisible="{Binding ThirdBaseRunner.IsCurrentBatter}"
                               FontSize="12" FontAttributes="Bold"
                               TextColor="{StaticResource Primary}"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Row="1" Grid.Column="2"
                                         Spacing="6" WidthRequest="160"
                                         HorizontalOptions="Center">
                        <Label Text="{Binding FirstBaseRunner.BaseLabel}"
                               FontAttributes="Bold" HorizontalTextAlignment="Center" />
                        <Button x:Name="FirstBaseRunnerButton" AutomationId="FirstBaseRunnerButton" CommandParameter="{Binding FirstBaseRunner}"
                                Text="{Binding FirstBaseRunner.PlayerName}"
                                IsEnabled="{Binding FirstBaseRunner.IsOccupied}"
                                BackgroundColor="{Binding FirstBaseRunner.BackgroundColor}"
                                BorderColor="{Binding FirstBaseRunner.BorderColor}"
                                Clicked="OnRunnerButtonClicked"
                                Style="{StaticResource BaseRunnerButtonStyle}"
                                MinimumWidthRequest="160"
                                MinimumHeightRequest="66" FontSize="16"
                                FontAttributes="Bold" Padding="14,8" />
                        <Label Text="{Binding FirstBaseRunner.RoleLabel}"
                               IsVisible="{Binding FirstBaseRunner.IsCurrentBatter}"
                               FontSize="12" FontAttributes="Bold"
                               TextColor="{StaticResource Primary}"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                    <Button x:Name="NextBatterButton" AutomationId="NextBatterButton"
                            Grid.Row="2" Grid.Column="1"
                            Text="{x:Static strings:AppResources.CompletePlateAppearanceButton}"
                            IsEnabled="{Binding CanAdvanceToNextBatter}"
                            Clicked="OnNextBatterClicked"
                            MinimumHeightRequest="56"
                            MinimumWidthRequest="260"
                            HorizontalOptions="Center"
                            Padding="24,14" />
                    <Label x:Name="RunsOnPlayLabel"
                           Grid.Row="3" Grid.Column="1"
                           Text="{Binding RunsOnPlayDisplay}"
                           IsVisible="{Binding HasPendingPlay}"
                           FontSize="18"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center" />
                    <VerticalStackLayout x:Name="PortraitScoredArea"
                                         Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3"
                                         IsVisible="{Binding HasPendingPlay}"
                                         Spacing="6" HorizontalOptions="Center">
                        <Label Text="{x:Static strings:AppResources.ScoredHeading}"
                               FontAttributes="Bold" HorizontalTextAlignment="Center" />
                        <CollectionView ItemsSource="{Binding ScoredPlayers}" SelectionMode="None"
                                        ItemsLayout="HorizontalList" HorizontalOptions="Center">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="viewModels:ScoredPlayerViewModel">
                                    <Button AutomationId="{Binding AutomationId}"
                                            Text="{Binding PlayerName}" Clicked="OnRunnerButtonClicked"
                                            Margin="6,0" MinimumWidthRequest="190"
                                            MinimumHeightRequest="68" FontSize="16"
                                            FontAttributes="Bold" Padding="14,8" />
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                        <Label Text="{x:Static strings:AppResources.EmptyBaseLabel}"
                               IsVisible="{Binding HasNoScoredPlayers}"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                    <Grid x:Name="CurrentBatterBorder"
                          Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3"
                          IsVisible="{Binding IsCurrentBatterVisible}"
                          HorizontalOptions="Center"
                          WidthRequest="360">
                        <Border Stroke="{StaticResource Primary}"
                                StrokeThickness="2"
                                StrokeShape="RoundRectangle 12"
                                Padding="18,10"
                                HorizontalOptions="Fill"
                                InputTransparent="True">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="{x:Static strings:AppResources.CurrentBatterHeading}"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource Primary}"
                                       HorizontalTextAlignment="Center" />
                                <Label x:Name="CurrentBatterName" AutomationId="CurrentBatter"
                                       Text="{Binding CurrentBatterDisplayName}"
                                       FontSize="28"
                                       FontAttributes="Bold"
                                       HorizontalTextAlignment="Center" />
                                <Label Text="{x:Static strings:AppResources.TapBatterHint}"
                                       FontSize="13"
                                       HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                        </Border>
                        <Button AutomationId="CurrentBatterButton"
                                Text="{Binding CurrentBatterDisplayName}"
                                TextColor="Transparent"
                                BackgroundColor="Transparent"
                                BorderColor="Transparent"
                                BorderWidth="0"
                                Padding="0"
                                HorizontalOptions="Fill"
                                Clicked="OnBatterClicked" />
                    </Grid>
                    </Grid>
                </Grid>
                <Grid x:Name="PortraitInfoPanels"
                      Grid.Row="1"
                      RowDefinitions="Auto,Auto"
                      ColumnDefinitions="*,*"
                      RowSpacing="8"
                      ColumnSpacing="12"
                      Margin="18,12,18,0">
                    <Border x:Name="UpcomingInfoPanel"
                            Stroke="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 10"
                            Padding="14,8">
                        <Grid RowDefinitions="Auto,Auto,Auto"
                              ColumnDefinitions="Auto,*"
                              RowSpacing="5" ColumnSpacing="14">
                            <Label AutomationId="UpcomingBattersHeading"
                                   Grid.ColumnSpan="2"
                                   Text="{x:Static strings:AppResources.UpcomingHeading}"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource Primary}"
                                   HorizontalTextAlignment="Center" />
                            <Label Grid.Row="1"
                                   Text="{x:Static strings:AppResources.OnDeckLabel}"
                                   FontAttributes="Bold" />
                            <Label Grid.Row="1" Grid.Column="1"
                                   AutomationId="OnDeckBatter"
                                   Text="{Binding OnDeckDisplayName}"
                                   FontSize="16" LineBreakMode="TailTruncation" />
                            <Label Grid.Row="2"
                                   Text="{x:Static strings:AppResources.InTheHoleLabel}"
                                   FontAttributes="Bold" />
                            <Label Grid.Row="2" Grid.Column="1"
                                   AutomationId="InTheHoleBatter"
                                   Text="{Binding InTheHoleDisplayName}"
                                   FontSize="16" LineBreakMode="TailTruncation" />
                        </Grid>
                    </Border>
                    <Button x:Name="UndoScoringButton"
                            AutomationId="UndoScoringButton"
                            Grid.Row="1"
                            Text="{x:Static strings:AppResources.UndoScoringButton}"
                            Clicked="OnUndoClicked"
                            IsEnabled="{Binding CanUndo}"
                            MinimumHeightRequest="52" />
                    <Border x:Name="OutsInfoPanel"
                            Grid.Column="1"
                            Stroke="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 10"
                            Padding="14,8">
                        <VerticalStackLayout Spacing="5">
                            <Label AutomationId="OutsThisInningHeading"
                                   Text="{x:Static strings:AppResources.OutsThisInningHeading}"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource Primary}"
                                   HorizontalTextAlignment="Center" />
                            <VerticalStackLayout Spacing="2"
                                BindableLayout.ItemsSource="{Binding OutsThisInning}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="viewModels:OutPlayerViewModel">
                                        <Label Text="{Binding DisplayText}"
                                               FontSize="16"
                                               LineBreakMode="TailTruncation" />
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                    <Button x:Name="RedoScoringButton"
                            AutomationId="RedoScoringButton"
                            Grid.Row="1" Grid.Column="1"
                            Text="{x:Static strings:AppResources.RedoScoringButton}"
                            Clicked="OnRedoClicked"
                            IsEnabled="{Binding CanRedo}"
                            MinimumHeightRequest="52" />
                    <VerticalStackLayout x:Name="LandscapeScoredArea"
                                         Grid.Row="1" Grid.Column="1"
                                         IsVisible="False"
                                         Spacing="6">
                        <VerticalStackLayout IsVisible="{Binding HasPendingPlay}" Spacing="6">
                        <Label Text="{x:Static strings:AppResources.ScoredHeading}"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center" />
                        <CollectionView ItemsSource="{Binding ScoredPlayers}"
                                        SelectionMode="None"
                                        ItemsLayout="VerticalList">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="viewModels:ScoredPlayerViewModel">
                                    <Button AutomationId="{Binding AutomationId}"
                                            Text="{Binding PlayerName}"
                                            Clicked="OnRunnerButtonClicked"
                                            Margin="0,3"
                                            MinimumHeightRequest="48"
                                            FontSize="16"
                                            FontAttributes="Bold"
                                            Padding="10,6" />
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                        <Label Text="{x:Static strings:AppResources.EmptyBaseLabel}"
                               IsVisible="{Binding HasNoScoredPlayers}"
                               HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Grid>
                <BoxView x:Name="UpcomingDivider"
                         Grid.Row="0" Grid.Column="0"
                         IsVisible="False"
                         BackgroundColor="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}" />
                <BoxView x:Name="ScoredDivider"
                         Grid.Row="0" Grid.Column="0"
                         IsVisible="False"
                         BackgroundColor="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}" />
        </Grid>
        <HorizontalStackLayout Grid.Row="3"
                               IsVisible="{Binding IsAwaitingOpponentHalfInning}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               Spacing="16">
            <Button AutomationId="EnterOpponentHalfInningButton"
                    Text="{x:Static strings:AppResources.EnterOpponentHalfInningButton}"
                    Clicked="OnEnterOpponentHalfInningClicked"
                    MinimumHeightRequest="56"
                    MinimumWidthRequest="240" />
            <Button AutomationId="StartupRedoScoringButton"
                    Text="{x:Static strings:AppResources.RedoScoringButton}"
                    Clicked="OnRedoClicked"
                    IsEnabled="{Binding CanRedo}"
                    MinimumHeightRequest="56"
                    MinimumWidthRequest="140" />
        </HorizontalStackLayout>
    </Grid>
    <Border x:Name="ScoringMenu"
            IsVisible="False"
            Margin="40,92,0,0"
            HorizontalOptions="Start"
            VerticalOptions="Start"
            ZIndex="10"
            BackgroundColor="White"
            Stroke="Black"
            StrokeShape="RoundRectangle 8"
            Padding="0">
        <VerticalStackLayout Spacing="0">
            <Button Text="{x:Static strings:AppResources.GameRulesTitle}"
                    Clicked="OnGameRulesClicked"
                    BackgroundColor="Transparent" TextColor="Black"
                    MinimumHeightRequest="52" MinimumWidthRequest="180" Padding="20,12" />
            <BoxView BackgroundColor="Black" HeightRequest="1" />
            <Button AutomationId="GameBeerRulesButton"
                    Text="{x:Static strings:AppResources.GameBeerRulesTitle}"
                    Clicked="OnBeerRulesClicked"
                    BackgroundColor="Transparent" TextColor="Black"
                    MinimumHeightRequest="52" MinimumWidthRequest="180" Padding="20,12" />
            <BoxView BackgroundColor="Black" HeightRequest="1" />
            <Button AutomationId="InGameStatsButton"
                    Text="{x:Static strings:AppResources.StatsButton}"
                    Clicked="OnStatsClicked"
                    BackgroundColor="Transparent" TextColor="Black"
                    MinimumHeightRequest="52" MinimumWidthRequest="180" Padding="20,12" />
            <BoxView BackgroundColor="Black" HeightRequest="1" />
            <Button AutomationId="ViewLineupButton"
                    Text="{x:Static strings:AppResources.ViewLineupButton}"
                    Clicked="OnViewLineupClicked"
                    BackgroundColor="Transparent" TextColor="Black"
                    MinimumHeightRequest="52" MinimumWidthRequest="180" Padding="20,12" />
            <BoxView BackgroundColor="Black" HeightRequest="1" />
            <Button AutomationId="ManageLiveLineupButton"
                    Text="{x:Static strings:AppResources.ManageLiveLineupButton}"
                    Clicked="OnManageLineupClicked"
                    BackgroundColor="Transparent" TextColor="Black"
                    MinimumHeightRequest="52" MinimumWidthRequest="180" Padding="20,12" />
            <BoxView BackgroundColor="Black" HeightRequest="1" />
            <Button AutomationId="ExitGameButton" Text="{x:Static strings:AppResources.ExitGameButton}"
                    Clicked="OnExitGameClicked"
                    BackgroundColor="Transparent"
                    TextColor="Black"
                    MinimumHeightRequest="52"
                    MinimumWidthRequest="180"
                    Padding="20,12" />
            <BoxView BackgroundColor="Black" HeightRequest="1" />
            <Button AutomationId="GameOverButton"
                    Text="{x:Static strings:AppResources.GameOverButton}"
                    Clicked="OnGameOverClicked"
                    BackgroundColor="Transparent" TextColor="Black"
                    MinimumHeightRequest="52" MinimumWidthRequest="180" Padding="20,12" />
        </VerticalStackLayout>
    </Border>
    </Grid>
</ContentPage>
