<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:strings="clr-namespace:SoftballScorekeeper.Resources.Strings"
             xmlns:viewModels="clr-namespace:SoftballScorekeeper.ViewModels"
             x:Class="SoftballScorekeeper.Views.ScoringPage"
             x:DataType="viewModels:ScoringViewModel"
             Shell.FlyoutBehavior="Disabled"
             Shell.NavBarIsVisible="False"
             Title="{x:Static strings:AppResources.ScoringTitle}">
    <Grid x:Name="RootGrid"
          Padding="40" RowDefinitions="Auto,Auto,Auto,Auto,*" RowSpacing="14">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="ScoreboardLayoutStates">
                <VisualState x:Name="PortraitScoreboard">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="LandscapeScoreboard">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="900" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter TargetName="RootGrid" Property="Padding" Value="20,12" />
                        <Setter TargetName="RootGrid" Property="RowSpacing" Value="8" />
                        <Setter TargetName="ScoreboardBorder" Property="Padding" Value="12,4" />
                        <Setter TargetName="ScoreboardGrid" Property="ColumnDefinitions" Value="*,1,Auto,1,*" />
                        <Setter TargetName="ScoreboardGrid" Property="RowDefinitions" Value="Auto" />
                        <Setter TargetName="ScoreboardGrid" Property="RowSpacing" Value="2" />
                        <Setter TargetName="HomeScoreboard" Property="Grid.Column" Value="4" />
                        <Setter TargetName="HomeScoreboard" Property="RowSpacing" Value="0" />
                        <Setter TargetName="VisitorScoreboard" Property="RowSpacing" Value="0" />
                        <Setter TargetName="ScoreboardRightDivider" Property="IsVisible" Value="True" />
                        <Setter TargetName="ScoreboardRightDivider" Property="Grid.Column" Value="3" />
                        <Setter TargetName="GameStatusPanel" Property="Grid.Row" Value="0" />
                        <Setter TargetName="GameStatusPanel" Property="Grid.Column" Value="2" />
                        <Setter TargetName="GameStatusPanel" Property="Grid.ColumnSpan" Value="1" />
                        <Setter TargetName="GameStatusPanel" Property="Padding" Value="12,0" />
                        <Setter TargetName="InningOutLabel" Property="IsVisible" Value="False" />
                        <Setter TargetName="LandscapeInningLabel" Property="IsVisible" Value="True" />
                        <Setter TargetName="LandscapeOutsLabel" Property="IsVisible" Value="True" />
                        <Setter TargetName="HomeHeading" Property="Label.FontSize" Value="16" />
                        <Setter TargetName="VisitorHeading" Property="Label.FontSize" Value="16" />
                        <Setter TargetName="HomeTeamName" Property="Label.FontSize" Value="19" />
                        <Setter TargetName="VisitorTeamName" Property="Label.FontSize" Value="19" />
                        <Setter TargetName="HomeScoreValue" Property="Label.FontSize" Value="44" />
                        <Setter TargetName="VisitorScoreValue" Property="Label.FontSize" Value="44" />
                        <Setter TargetName="HomeScoreValue" Property="Grid.Row" Value="0" />
                        <Setter TargetName="VisitorScoreValue" Property="Grid.Row" Value="0" />
                        <Setter TargetName="HomeScoreValue" Property="Grid.Column" Value="1" />
                        <Setter TargetName="VisitorScoreValue" Property="Grid.Column" Value="1" />
                        <Setter TargetName="HomeScoreValue" Property="Grid.RowSpan" Value="2" />
                        <Setter TargetName="VisitorScoreValue" Property="Grid.RowSpan" Value="2" />
                        <Setter TargetName="InningOutLabel" Property="Label.FontSize" Value="16" />
                        <Setter TargetName="ScoringContentLayout" Property="ColumnDefinitions" Value="210,1,*,1,240" />
                        <Setter TargetName="ScoringContentLayout" Property="RowDefinitions" Value="Auto" />
                        <Setter TargetName="FieldSection" Property="Grid.Row" Value="0" />
                        <Setter TargetName="FieldSection" Property="Grid.Column" Value="2" />
                        <Setter TargetName="UpcomingBattersList" Property="Grid.Row" Value="0" />
                        <Setter TargetName="UpcomingBattersList" Property="Grid.Column" Value="0" />
                        <Setter TargetName="UpcomingBattersList" Property="Margin" Value="0,34,12,0" />
                        <Setter TargetName="UpcomingBattersList" Property="MinimumWidthRequest" Value="200" />
                        <Setter TargetName="UpcomingBattersList" Property="VerticalOptions" Value="Start" />
                        <Setter TargetName="UpcomingDivider" Property="Grid.Column" Value="1" />
                        <Setter TargetName="UpcomingDivider" Property="IsVisible" Value="True" />
                        <Setter TargetName="ScoredDivider" Property="Grid.Column" Value="3" />
                        <Setter TargetName="ScoredDivider" Property="IsVisible" Value="True" />
                        <Setter TargetName="LandscapeScoredRail" Property="Grid.Column" Value="4" />
                        <Setter TargetName="LandscapeScoredRail" Property="IsVisible" Value="True" />
                        <Setter TargetName="FieldGrid" Property="RowSpacing" Value="6" />
                        <Setter TargetName="NextBatterButton" Property="MinimumWidthRequest" Value="210" />
                        <Setter TargetName="NextBatterButton" Property="MinimumHeightRequest" Value="52" />
                        <Setter TargetName="NextBatterButton" Property="Padding" Value="18,10" />
                        <Setter TargetName="CurrentBatterBorder" Property="Grid.Row" Value="3" />
                        <Setter TargetName="CurrentBatterBorder" Property="Grid.Column" Value="1" />
                        <Setter TargetName="CurrentBatterBorder" Property="Grid.ColumnSpan" Value="1" />
                        <Setter TargetName="CurrentBatterBorder" Property="MinimumWidthRequest" Value="260" />
                        <Setter TargetName="CurrentBatterBorder" Property="Padding" Value="12,6" />
                        <Setter TargetName="CurrentBatterName" Property="Label.FontSize" Value="22" />
                        <Setter TargetName="RunsOnPlayLabel" Property="Grid.Row" Value="3" />
                        <Setter TargetName="RunsOnPlayLabel" Property="Grid.Column" Value="2" />
                        <Setter TargetName="PortraitScoredArea" Property="IsVisible" Value="False" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*">
            <Button Text="&#x2630;"
                    Clicked="OnScoringMenuClicked"
                    FontSize="28"
                    MinimumHeightRequest="52"
                    MinimumWidthRequest="64"
                    HorizontalOptions="Start"
                    Padding="12,6"
                    SemanticProperties.Description="{x:Static strings:AppResources.ScoringMenuAccessibility}" />
            <Label Grid.Column="1"
                   Text="{x:Static strings:AppResources.ScoringTitle}"
                   Style="{StaticResource Headline}"
                   VerticalOptions="Center"
                   SemanticProperties.HeadingLevel="Level1" />
            <Border x:Name="ScoringMenu"
                    Grid.Row="1"
                    IsVisible="False"
                    HorizontalOptions="Start"
                    BackgroundColor="White"
                    Stroke="Black"
                    StrokeShape="RoundRectangle 8"
                    Padding="0">
                <VerticalStackLayout Spacing="0">
                    <Button Text="{x:Static strings:AppResources.GameRulesTitle}"
                            Clicked="OnGameRulesClicked"
                            BackgroundColor="Transparent" TextColor="Black"
                            MinimumHeightRequest="52" MinimumWidthRequest="180" Padding="20,12" />
                    <BoxView BackgroundColor="Black" HeightRequest="1" />
                    <Button Text="{x:Static strings:AppResources.ExitGameButton}"
                            Clicked="OnExitGameClicked"
                            BackgroundColor="Transparent"
                            TextColor="Black"
                            MinimumHeightRequest="52"
                            MinimumWidthRequest="180"
                            Padding="20,12" />
                    <BoxView BackgroundColor="Black" HeightRequest="1" />
                    <Button Text="{x:Static strings:AppResources.GameOverButton}"
                            Clicked="OnGameOverClicked"
                            BackgroundColor="Transparent" TextColor="Black"
                            MinimumHeightRequest="52" MinimumWidthRequest="180" Padding="20,12" />
                </VerticalStackLayout>
            </Border>
        </Grid>
        <Label Grid.Row="1" Text="{Binding ValidationMessage}" HorizontalTextAlignment="Center" />
        <Border x:Name="ScoreboardBorder"
                Grid.Row="2"
                IsVisible="{Binding IsLoaded}"
                Stroke="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"
                StrokeShape="RoundRectangle 12"
                Padding="24,16">
            <Grid x:Name="ScoreboardGrid"
                  ColumnDefinitions="*,1,*" RowDefinitions="Auto,Auto"
                  ColumnSpacing="24" RowSpacing="8">
                <Grid x:Name="HomeScoreboard"
                      Grid.Column="2"
                      ColumnDefinitions="*,Auto"
                      RowDefinitions="Auto,Auto,Auto,Auto"
                      RowSpacing="4"
                      HorizontalOptions="Fill">
                    <Label x:Name="HomeHeading"
                           Text="{x:Static strings:AppResources.HomeScoreboardHeading}"
                           FontSize="20"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center" />
                    <Label x:Name="HomeTeamName"
                           Grid.Row="1"
                           Text="{Binding HomeTeamDisplayName}"
                           FontSize="24"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center"
                           LineBreakMode="TailTruncation"
                           MaxLines="1" />
                    <Label x:Name="HomeScoreValue"
                           Grid.Row="2"
                           Text="{Binding HomeScore}"
                           FontSize="64"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center" />
                    <Label Grid.Row="3" Text="{Binding HomeHomeRunDisplay}"
                           FontSize="16" FontAttributes="Bold"
                           HorizontalTextAlignment="Center" />
                </Grid>
                <BoxView Grid.Column="1"
                         BackgroundColor="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}" />
                <BoxView x:Name="ScoreboardRightDivider"
                         Grid.Column="1"
                         IsVisible="False"
                         BackgroundColor="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}" />
                <Grid x:Name="VisitorScoreboard"
                      Grid.Column="0"
                      ColumnDefinitions="*,Auto"
                      RowDefinitions="Auto,Auto,Auto,Auto"
                      RowSpacing="4"
                      HorizontalOptions="Fill">
                    <Label x:Name="VisitorHeading"
                           Text="{x:Static strings:AppResources.VisitorScoreboardHeading}"
                           FontSize="20"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center" />
                    <Label x:Name="VisitorTeamName"
                           Grid.Row="1"
                           Text="{Binding VisitorTeamDisplayName}"
                           FontSize="24"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center"
                           LineBreakMode="TailTruncation"
                           MaxLines="1" />
                    <Label x:Name="VisitorScoreValue"
                           Grid.Row="2"
                           Text="{Binding VisitorScore}"
                           FontSize="64"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center" />
                    <Label Grid.Row="3" Text="{Binding VisitorHomeRunDisplay}"
                           FontSize="16" FontAttributes="Bold"
                           HorizontalTextAlignment="Center" />
                </Grid>
                <VerticalStackLayout x:Name="GameStatusPanel"
                                     Grid.Row="1" Grid.ColumnSpan="3"
                                     Spacing="2">
                    <Label x:Name="InningOutLabel"
                           Text="{Binding InningOutDisplay}"
                           FontSize="20"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center" />
                    <Label x:Name="LandscapeInningLabel"
                           Text="{Binding InningDisplay}"
                           IsVisible="False"
                           FontSize="16" FontAttributes="Bold"
                           HorizontalTextAlignment="Center" />
                    <Label x:Name="LandscapeOutsLabel"
                           Text="{Binding OutsDisplay}"
                           IsVisible="False"
                           FontSize="16" FontAttributes="Bold"
                           HorizontalTextAlignment="Center" />
                    <Label Text="{x:Static strings:AppResources.OneUpOnLabel}"
                           IsVisible="{Binding IsOneUpEnabled}"
                           FontSize="14" FontAttributes="Bold"
                           TextColor="{StaticResource Primary}"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Grid>
        </Border>
        <ScrollView Grid.Row="3" Grid.RowSpan="2" IsVisible="{Binding IsLoaded}">
            <Grid x:Name="ScoringContentLayout"
                  RowDefinitions="Auto,Auto" ColumnDefinitions="*"
                  RowSpacing="12">
                <VerticalStackLayout x:Name="FieldSection" Spacing="10">
                    <Label Text="{x:Static strings:AppResources.BasesHeading}"
                           FontAttributes="Bold" HorizontalTextAlignment="Center" />
                    <Grid x:Name="FieldGrid"
                          ColumnDefinitions="*,Auto,*"
                          RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                          RowSpacing="12">
                    <VerticalStackLayout Grid.Row="0" Grid.Column="1"
                                         Spacing="6" WidthRequest="160">
                        <Label Text="{Binding SecondBaseRunner.BaseLabel}"
                               FontAttributes="Bold" HorizontalTextAlignment="Center" />
                        <Button CommandParameter="{Binding SecondBaseRunner}"
                                Text="{Binding SecondBaseRunner.PlayerName}"
                                IsEnabled="{Binding SecondBaseRunner.IsOccupied}"
                                Clicked="OnRunnerButtonClicked" BackgroundColor="White"
                                BorderColor="{StaticResource Gray400}" BorderWidth="1"
                                TextColor="Black" MinimumWidthRequest="160"
                                MinimumHeightRequest="66" FontSize="16"
                                FontAttributes="Bold" Padding="14,8" />
                        <Label Text="{Binding SecondBaseRunner.RoleLabel}"
                               IsVisible="{Binding SecondBaseRunner.IsCurrentBatter}"
                               FontSize="12" FontAttributes="Bold"
                               TextColor="{StaticResource Primary}"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Row="1" Grid.Column="0"
                                         Spacing="6" WidthRequest="160"
                                         HorizontalOptions="Center">
                        <Label Text="{Binding ThirdBaseRunner.BaseLabel}"
                               FontAttributes="Bold" HorizontalTextAlignment="Center" />
                        <Button CommandParameter="{Binding ThirdBaseRunner}"
                                Text="{Binding ThirdBaseRunner.PlayerName}"
                                IsEnabled="{Binding ThirdBaseRunner.IsOccupied}"
                                Clicked="OnRunnerButtonClicked" BackgroundColor="White"
                                BorderColor="{StaticResource Gray400}" BorderWidth="1"
                                TextColor="Black" MinimumWidthRequest="160"
                                MinimumHeightRequest="66" FontSize="16"
                                FontAttributes="Bold" Padding="14,8" />
                        <Label Text="{Binding ThirdBaseRunner.RoleLabel}"
                               IsVisible="{Binding ThirdBaseRunner.IsCurrentBatter}"
                               FontSize="12" FontAttributes="Bold"
                               TextColor="{StaticResource Primary}"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Row="1" Grid.Column="2"
                                         Spacing="6" WidthRequest="160"
                                         HorizontalOptions="Center">
                        <Label Text="{Binding FirstBaseRunner.BaseLabel}"
                               FontAttributes="Bold" HorizontalTextAlignment="Center" />
                        <Button CommandParameter="{Binding FirstBaseRunner}"
                                Text="{Binding FirstBaseRunner.PlayerName}"
                                IsEnabled="{Binding FirstBaseRunner.IsOccupied}"
                                Clicked="OnRunnerButtonClicked" BackgroundColor="White"
                                BorderColor="{StaticResource Gray400}" BorderWidth="1"
                                TextColor="Black" MinimumWidthRequest="160"
                                MinimumHeightRequest="66" FontSize="16"
                                FontAttributes="Bold" Padding="14,8" />
                        <Label Text="{Binding FirstBaseRunner.RoleLabel}"
                               IsVisible="{Binding FirstBaseRunner.IsCurrentBatter}"
                               FontSize="12" FontAttributes="Bold"
                               TextColor="{StaticResource Primary}"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                    <Button x:Name="NextBatterButton"
                            Grid.Row="2" Grid.Column="1"
                            Text="{x:Static strings:AppResources.CompletePlateAppearanceButton}"
                            IsEnabled="{Binding CanCompletePlateAppearance}"
                            Clicked="OnNextBatterClicked"
                            MinimumHeightRequest="56"
                            MinimumWidthRequest="260"
                            HorizontalOptions="Center"
                            Padding="24,14" />
                    <Label x:Name="RunsOnPlayLabel"
                           Grid.Row="3" Grid.Column="1"
                           Text="{Binding RunsOnPlayDisplay}"
                           IsVisible="{Binding HasPendingPlay}"
                           FontSize="18"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center" />
                    <VerticalStackLayout x:Name="PortraitScoredArea"
                                         Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3"
                                         IsVisible="{Binding HasPendingPlay}"
                                         Spacing="6" HorizontalOptions="Center">
                        <Label Text="{x:Static strings:AppResources.ScoredHeading}"
                               FontAttributes="Bold" HorizontalTextAlignment="Center" />
                        <CollectionView ItemsSource="{Binding ScoredPlayers}" SelectionMode="None"
                                        ItemsLayout="HorizontalList" HorizontalOptions="Center">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="viewModels:ScoredPlayerViewModel">
                                    <Button Text="{Binding PlayerName}" Clicked="OnRunnerButtonClicked"
                                            Margin="6,0" MinimumWidthRequest="190"
                                            MinimumHeightRequest="68" FontSize="16"
                                            FontAttributes="Bold" Padding="14,8" />
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                        <Label Text="{x:Static strings:AppResources.EmptyBaseLabel}"
                               IsVisible="{Binding HasNoScoredPlayers}"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                    <Border x:Name="CurrentBatterBorder"
                            Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3"
                            IsVisible="{Binding IsCurrentBatterVisible}"
                            Stroke="{StaticResource Primary}"
                            StrokeThickness="2"
                            StrokeShape="RoundRectangle 12"
                            Padding="18,10"
                            HorizontalOptions="Center"
                            MinimumWidthRequest="360">
                        <VerticalStackLayout Spacing="8">
                            <VerticalStackLayout.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnBatterTapped" />
                            </VerticalStackLayout.GestureRecognizers>
                            <Label Text="{x:Static strings:AppResources.CurrentBatterHeading}"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource Primary}"
                                   HorizontalTextAlignment="Center" />
                            <Label x:Name="CurrentBatterName"
                                   Text="{Binding CurrentBatterDisplayName}"
                                   FontSize="28"
                                   FontAttributes="Bold"
                                   HorizontalTextAlignment="Center" />
                            <Label Text="{x:Static strings:AppResources.TapBatterHint}"
                                   FontSize="13"
                                   HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>
                    </Grid>
                </VerticalStackLayout>
                <Grid x:Name="UpcomingBattersList"
                          Grid.Row="1"
                          RowDefinitions="Auto,Auto"
                          ColumnDefinitions="Auto,*"
                          RowSpacing="6" ColumnSpacing="16"
                          Margin="18,0"
                          HorizontalOptions="Center"
                          MinimumWidthRequest="360">
                        <Label Text="{x:Static strings:AppResources.OnDeckLabel}"
                               FontAttributes="Bold" />
                        <Label Grid.Column="1"
                               Text="{Binding OnDeckDisplayName}"
                               FontSize="17" LineBreakMode="TailTruncation" />
                        <Label Grid.Row="1"
                               Text="{x:Static strings:AppResources.InTheHoleLabel}"
                               FontAttributes="Bold" />
                        <Label Grid.Row="1" Grid.Column="1"
                               Text="{Binding InTheHoleDisplayName}"
                               FontSize="17" LineBreakMode="TailTruncation" />
                </Grid>
                <BoxView x:Name="UpcomingDivider"
                         Grid.Row="0" Grid.Column="0"
                         IsVisible="False"
                         BackgroundColor="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}" />
                <BoxView x:Name="ScoredDivider"
                         Grid.Row="0" Grid.Column="0"
                         IsVisible="False"
                         BackgroundColor="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}" />
                <Grid x:Name="LandscapeScoredRail"
                      Grid.Row="0" Grid.Column="0"
                      IsVisible="False"
                      Padding="12,34,0,0">
                    <VerticalStackLayout IsVisible="{Binding HasPendingPlay}" Spacing="6">
                        <Label Text="{x:Static strings:AppResources.ScoredHeading}"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center" />
                        <CollectionView ItemsSource="{Binding ScoredPlayers}"
                                        SelectionMode="None"
                                        ItemsLayout="VerticalList">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="viewModels:ScoredPlayerViewModel">
                                    <Button Text="{Binding PlayerName}"
                                            Clicked="OnRunnerButtonClicked"
                                            Margin="0,3"
                                            MinimumHeightRequest="48"
                                            FontSize="16"
                                            FontAttributes="Bold"
                                            Padding="10,6" />
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                        <Label Text="{x:Static strings:AppResources.EmptyBaseLabel}"
                               IsVisible="{Binding HasNoScoredPlayers}"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Grid>
            </Grid>
        </ScrollView>
    </Grid>
</ContentPage>
