<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SoftballScorekeeper.Views.GameRulesDialog"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:strings="clr-namespace:SoftballScorekeeper.Resources.Strings"
    Shell.NavBarIsVisible="False"
    BackgroundColor="#99000000">
    <Grid Padding="36">
        <Border Padding="28" MaximumWidthRequest="620"
                HorizontalOptions="Center" VerticalOptions="Center"
                BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource Gray900}}"
                Stroke="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"
                StrokeShape="RoundRectangle 16">
            <VerticalStackLayout Spacing="18">
                <Label x:Name="TitleLabel" FontSize="28" FontAttributes="Bold"
                       HorizontalTextAlignment="Center" />
                <VerticalStackLayout x:Name="TeamSideSection" Spacing="8">
                    <Label Text="{x:Static strings:AppResources.OurTeamLabel}"
                           FontSize="18" FontAttributes="Bold" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <RadioButton x:Name="AwayOption" AutomationId="AwayTeamSideOption" GroupName="TeamSide"
                                     Content="{x:Static strings:AppResources.AwayButton}"
                                     IsChecked="True" MinimumHeightRequest="52" />
                        <RadioButton x:Name="HomeOption" AutomationId="HomeTeamSideOption"
                                     Grid.Column="1" GroupName="TeamSide"
                                     Content="{x:Static strings:AppResources.HomeButton}"
                                     MinimumHeightRequest="52" />
                    </Grid>
                </VerticalStackLayout>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{x:Static strings:AppResources.HomeRunLimitLabel}"
                               FontSize="18" FontAttributes="Bold" />
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                            <Button Text="{x:Static strings:AppResources.DecreaseValueButtonLabel}"
                                    Clicked="OnDecreaseClicked" MinimumHeightRequest="56"
                                    MinimumWidthRequest="56" FontSize="24"
                                    Padding="0" />
                            <Entry x:Name="HomeRunLimitEntry" Grid.Column="1"
                                   Keyboard="Numeric" HorizontalTextAlignment="Center"
                                   MinimumHeightRequest="56" />
                            <Button Grid.Column="2"
                                    Text="{x:Static strings:AppResources.IncreaseValueButtonLabel}"
                                    Clicked="OnIncreaseClicked" MinimumHeightRequest="56"
                                    MinimumWidthRequest="56" FontSize="24"
                                    Padding="0" />
                        </Grid>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="8">
                        <Label Text="{x:Static strings:AppResources.OneUpLabel}"
                               FontSize="18" FontAttributes="Bold" />
                        <HorizontalStackLayout Spacing="8">
                            <Label x:Name="OneUpStatusLabel" VerticalOptions="Center" />
                            <Switch x:Name="OneUpSwitch" Toggled="OnOneUpToggled" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Grid>
                <Label x:Name="ValidationLabel"
                       TextColor="{AppThemeBinding Light={StaticResource Error}, Dark={StaticResource ErrorDark}}"
                       HorizontalTextAlignment="Center" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                    <Button Text="{x:Static strings:AppResources.CancelButton}"
                            Clicked="OnCancelClicked" MinimumHeightRequest="56" />
                    <Button x:Name="SaveButton" AutomationId="ConfirmGameRulesButton" Grid.Column="1"
                            Clicked="OnSaveClicked" MinimumHeightRequest="56" />
                </Grid>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
