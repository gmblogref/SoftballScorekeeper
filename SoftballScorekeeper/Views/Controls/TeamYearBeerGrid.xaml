<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="SoftballScorekeeper.Views.Controls.TeamYearBeerGrid"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:strings="clr-namespace:SoftballScorekeeper.Resources.Strings"
    xmlns:viewModels="clr-namespace:SoftballScorekeeper.ViewModels"
    x:DataType="viewModels:TeamYearSummaryViewModel">
    <ContentView.Resources>
        <Style x:Key="YearBeerHeader" TargetType="Label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="HorizontalTextAlignment" Value="Center" />
            <Setter Property="VerticalTextAlignment" Value="Center" />
        </Style>
        <Style x:Key="YearBeerValue" TargetType="Label">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="HorizontalTextAlignment" Value="Center" />
            <Setter Property="VerticalTextAlignment" Value="Center" />
        </Style>
    </ContentView.Resources>

    <Grid x:Name="TeamYearBeerTable" RowDefinitions="Auto,*">
        <Grid x:Name="TeamYearBeerHeader" Padding="10,6,10,0" ColumnDefinitions="182,*">
            <Grid x:Name="TeamYearBeerPlayerHeader" ColumnDefinitions="180,2" RowDefinitions="Auto,2">
                <Label AutomationId="TeamYearBeerPlayerHeader" Grid.Column="0" Style="{StaticResource YearBeerHeader}" Text="{x:Static strings:AppResources.BeerTotalsPlayerHeader}" />
                <BoxView Grid.Column="1" Grid.RowSpan="2" BackgroundColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
                <BoxView Grid.Row="1" Grid.ColumnSpan="2" BackgroundColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
            </Grid>
            <Grid Grid.Column="1" IsClippedToBounds="True">
                <Grid x:Name="TeamYearBeerScrollableHeader" WidthRequest="768" HorizontalOptions="Start" ColumnDefinitions="72,88,72,72,88,100,88,100,88" RowDefinitions="Auto,2">
                    <Label AutomationId="TeamYearBeerDboHeader" Grid.Column="0" Style="{StaticResource YearBeerHeader}" Text="{x:Static strings:AppResources.BeerTotalsDboHeader}" />
                    <Label AutomationId="TeamYearBeerSoloHomeRunHeader" Grid.Column="1" Style="{StaticResource YearBeerHeader}" Text="{x:Static strings:AppResources.BeerTotalsSoloHomeRunHeader}" />
                    <Label AutomationId="TeamYearBeerDoublePlayHeader" Grid.Column="2" Style="{StaticResource YearBeerHeader}" Text="{x:Static strings:AppResources.BeerTotalsDoublePlayHeader}" />
                    <Label AutomationId="TeamYearBeerTriplePlayHeader" Grid.Column="3" Style="{StaticResource YearBeerHeader}" Text="{x:Static strings:AppResources.BeerTotalsTriplePlayHeader}" />
                    <Label AutomationId="TeamYearBeerTwoOutsHeader" Grid.Column="4" Style="{StaticResource YearBeerHeader}" Text="{x:Static strings:AppResources.BeerTotalsTwoOutsHeader}" />
                    <Label AutomationId="TeamYearBeerStrikeoutHeader" Grid.Column="5" Style="{StaticResource YearBeerHeader}" Text="{x:Static strings:AppResources.BeerTotalsStrikeoutHeader}" />
                    <Label AutomationId="TeamYearBeerLowManHeader" Grid.Column="6" Style="{StaticResource YearBeerHeader}" Text="{x:Static strings:AppResources.BeerTotalsLowManHeader}" />
                    <Label AutomationId="TeamYearBeerBroughtHeader" Grid.Column="7" Style="{StaticResource YearBeerHeader}" Text="{x:Static strings:AppResources.BeerTotalsBroughtHeader}" />
                    <Label AutomationId="TeamYearBeerOwedHeader" Grid.Column="8" Style="{StaticResource YearBeerHeader}" Text="{x:Static strings:AppResources.BeerTotalsOwedHeader}" />
                    <BoxView Grid.Row="1" Grid.ColumnSpan="9" BackgroundColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
                </Grid>
            </Grid>
        </Grid>

        <ScrollView x:Name="TeamYearBeerVerticalScroll" Grid.Row="1" AutomationId="TeamYearBeerSummaryGridVerticalScroll" Orientation="Vertical" VerticalScrollBarVisibility="Default">
            <Grid x:Name="TeamYearBeerBody" Padding="10,0" ColumnDefinitions="182,*">
                <VerticalStackLayout x:Name="TeamYearBeerPlayerNames" BindableLayout.ItemsSource="{Binding BeerRows}" Spacing="0">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:TeamYearBeerRowViewModel">
                            <Grid AutomationId="{Binding PlayerId, StringFormat='TeamYearBeerRow-{0}'}" ColumnDefinitions="180,2" RowDefinitions="48,1">
                                <Label Grid.Column="0" Text="{Binding PlayerDisplayName}" FontSize="16" FontAttributes="Bold" VerticalTextAlignment="Center" LineBreakMode="TailTruncation" MaxLines="1" />
                                <BoxView Grid.Column="1" Grid.RowSpan="2" BackgroundColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
                                <BoxView Grid.Row="1" Grid.ColumnSpan="2" BackgroundColor="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}" />
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
                <ScrollView x:Name="TeamYearBeerHorizontalScroll" Grid.Column="1" AutomationId="TeamYearBeerSummaryGrid" HorizontalScrollBarVisibility="Always" Orientation="Horizontal" Scrolled="OnStatisticsScrolled">
                    <VerticalStackLayout x:Name="TeamYearBeerScrollableRows" WidthRequest="768" HorizontalOptions="Start" BindableLayout.ItemsSource="{Binding BeerRows}" Spacing="0">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:TeamYearBeerRowViewModel">
                                <Grid ColumnDefinitions="72,88,72,72,88,100,88,100,88" RowDefinitions="48,1">
                                    <Label AutomationId="{Binding PlayerId, StringFormat='TeamYearBeerDbo-{0}'}" Grid.Column="0" Style="{StaticResource YearBeerValue}" Text="{Binding DboCount}" />
                                    <Label AutomationId="{Binding PlayerId, StringFormat='TeamYearBeerSoloHomeRun-{0}'}" Grid.Column="1" Style="{StaticResource YearBeerValue}" Text="{Binding SoloHomeRunCount}" />
                                    <Label AutomationId="{Binding PlayerId, StringFormat='TeamYearBeerDoublePlay-{0}'}" Grid.Column="2" Style="{StaticResource YearBeerValue}" Text="{Binding DoublePlayCount}" />
                                    <Label AutomationId="{Binding PlayerId, StringFormat='TeamYearBeerTriplePlay-{0}'}" Grid.Column="3" Style="{StaticResource YearBeerValue}" Text="{Binding TriplePlayCount}" />
                                    <Label AutomationId="{Binding PlayerId, StringFormat='TeamYearBeerTwoOuts-{0}'}" Grid.Column="4" Style="{StaticResource YearBeerValue}" Text="{Binding TwoOutsInOneInningCount}" />
                                    <Label AutomationId="{Binding PlayerId, StringFormat='TeamYearBeerStrikeout-{0}'}" Grid.Column="5" Style="{StaticResource YearBeerValue}" Text="{Binding StrikeoutCount}" />
                                    <Label AutomationId="{Binding PlayerId, StringFormat='TeamYearBeerLowMan-{0}'}" Grid.Column="6" Style="{StaticResource YearBeerValue}" Text="{Binding LowManCount}" />
                                    <Label AutomationId="{Binding PlayerId, StringFormat='TeamYearBeerBrought-{0}'}" Grid.Column="7" Style="{StaticResource YearBeerValue}" Text="{Binding Brought}" />
                                    <Label AutomationId="{Binding PlayerId, StringFormat='TeamYearBeerOwed-{0}'}" Grid.Column="8" FontAttributes="Bold" Style="{StaticResource YearBeerValue}" Text="{Binding Owed}" />
                                    <BoxView Grid.Row="1" Grid.ColumnSpan="9" BackgroundColor="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </ScrollView>
            </Grid>
        </ScrollView>
    </Grid>
</ContentView>
