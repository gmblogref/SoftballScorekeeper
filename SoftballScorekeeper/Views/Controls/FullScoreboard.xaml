<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:SoftballScorekeeper.Views.Controls"
             xmlns:strings="clr-namespace:SoftballScorekeeper.Resources.Strings"
             x:Class="SoftballScorekeeper.Views.Controls.FullScoreboard"
             x:Name="ScoreboardRoot"
             HorizontalOptions="Fill"
             VerticalOptions="Start">
    <Border x:Name="ScoreboardBorder"
            Stroke="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"
            StrokeShape="RoundRectangle 12"
            HorizontalOptions="Fill"
            VerticalOptions="Start"
            Padding="24,16">
        <Grid x:Name="ContentGrid"
              RowDefinitions="Auto,Auto">
            <Grid.VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="ScoreboardProfiles">
                    <VisualState x:Name="LiveRegularPortrait" />
                    <VisualState x:Name="LiveCompactPortrait">
                        <VisualState.Setters>
                            <Setter TargetName="ScoreboardBorder" Property="Padding" Value="8,2" />
                            <Setter TargetName="ScoreboardGrid" Property="ColumnDefinitions" Value="*,1,Auto,1,*" />
                            <Setter TargetName="ScoreboardGrid" Property="RowDefinitions" Value="Auto" />
                            <Setter TargetName="ScoreboardGrid" Property="RowSpacing" Value="0" />
                            <Setter TargetName="HomeScoreboard" Property="Grid.Column" Value="4" />
                            <Setter TargetName="HomeScoreboard" Property="RowDefinitions" Value="Auto,Auto,Auto" />
                            <Setter TargetName="VisitorScoreboard" Property="RowDefinitions" Value="Auto,Auto,Auto" />
                            <Setter TargetName="HomeScoreboard" Property="RowSpacing" Value="0" />
                            <Setter TargetName="VisitorScoreboard" Property="RowSpacing" Value="0" />
                            <Setter TargetName="ScoreboardRightDivider" Property="IsVisible" Value="True" />
                            <Setter TargetName="ScoreboardRightDivider" Property="Grid.Column" Value="3" />
                            <Setter TargetName="GameStatusPanel" Property="Grid.Row" Value="0" />
                            <Setter TargetName="GameStatusPanel" Property="Grid.Column" Value="2" />
                            <Setter TargetName="GameStatusPanel" Property="Grid.ColumnSpan" Value="1" />
                            <Setter TargetName="GameStatusPanel" Property="Padding" Value="8,0" />
                            <Setter TargetName="HomeHeading" Property="Label.FontSize" Value="12" />
                            <Setter TargetName="VisitorHeading" Property="Label.FontSize" Value="12" />
                            <Setter TargetName="HomeTeamName" Property="Label.FontSize" Value="15" />
                            <Setter TargetName="VisitorTeamName" Property="Label.FontSize" Value="15" />
                            <Setter TargetName="HomeScoreValue" Property="Label.FontSize" Value="30" />
                            <Setter TargetName="VisitorScoreValue" Property="Label.FontSize" Value="30" />
                            <Setter TargetName="HomeScoreValue" Property="Grid.Row" Value="0" />
                            <Setter TargetName="VisitorScoreValue" Property="Grid.Row" Value="0" />
                            <Setter TargetName="HomeScoreValue" Property="Grid.Column" Value="1" />
                            <Setter TargetName="VisitorScoreValue" Property="Grid.Column" Value="1" />
                            <Setter TargetName="HomeScoreValue" Property="Grid.RowSpan" Value="2" />
                            <Setter TargetName="VisitorScoreValue" Property="Grid.RowSpan" Value="2" />
                            <Setter TargetName="HomeDetailLabel" Property="Grid.Row" Value="2" />
                            <Setter TargetName="VisitorDetailLabel" Property="Grid.Row" Value="2" />
                            <Setter TargetName="HomeDetailLabel" Property="Label.FontSize" Value="12" />
                            <Setter TargetName="VisitorDetailLabel" Property="Label.FontSize" Value="12" />
                            <Setter TargetName="CombinedStatusLabel" Property="Label.FontSize" Value="15" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="LiveRegularLandscape">
                        <VisualState.Setters>
                            <Setter TargetName="ScoreboardBorder" Property="Padding" Value="10,2" />
                            <Setter TargetName="ScoreboardGrid" Property="ColumnDefinitions" Value="*,1,Auto,1,*" />
                            <Setter TargetName="ScoreboardGrid" Property="RowDefinitions" Value="Auto" />
                            <Setter TargetName="ScoreboardGrid" Property="RowSpacing" Value="2" />
                            <Setter TargetName="HomeScoreboard" Property="Grid.Column" Value="4" />
                            <Setter TargetName="HomeScoreboard" Property="RowDefinitions" Value="Auto,Auto,Auto" />
                            <Setter TargetName="VisitorScoreboard" Property="RowDefinitions" Value="Auto,Auto,Auto" />
                            <Setter TargetName="HomeScoreboard" Property="RowSpacing" Value="0" />
                            <Setter TargetName="VisitorScoreboard" Property="RowSpacing" Value="0" />
                            <Setter TargetName="ScoreboardRightDivider" Property="IsVisible" Value="True" />
                            <Setter TargetName="ScoreboardRightDivider" Property="Grid.Column" Value="3" />
                            <Setter TargetName="GameStatusPanel" Property="Grid.Row" Value="0" />
                            <Setter TargetName="GameStatusPanel" Property="Grid.Column" Value="2" />
                            <Setter TargetName="GameStatusPanel" Property="Grid.ColumnSpan" Value="1" />
                            <Setter TargetName="GameStatusPanel" Property="Padding" Value="10,0" />
                            <Setter TargetName="CombinedStatusLabel" Property="IsVisible" Value="False" />
                            <Setter TargetName="InningStatusLabel" Property="IsVisible" Value="True" />
                            <Setter TargetName="OutsStatusLabel" Property="IsVisible" Value="True" />
                            <Setter TargetName="HomeHeading" Property="Label.FontSize" Value="14" />
                            <Setter TargetName="VisitorHeading" Property="Label.FontSize" Value="14" />
                            <Setter TargetName="HomeTeamName" Property="Label.FontSize" Value="16" />
                            <Setter TargetName="VisitorTeamName" Property="Label.FontSize" Value="16" />
                            <Setter TargetName="HomeScoreValue" Property="Label.FontSize" Value="34" />
                            <Setter TargetName="VisitorScoreValue" Property="Label.FontSize" Value="34" />
                            <Setter TargetName="HomeScoreValue" Property="Grid.Row" Value="0" />
                            <Setter TargetName="VisitorScoreValue" Property="Grid.Row" Value="0" />
                            <Setter TargetName="HomeScoreValue" Property="Grid.Column" Value="1" />
                            <Setter TargetName="VisitorScoreValue" Property="Grid.Column" Value="1" />
                            <Setter TargetName="HomeScoreValue" Property="Grid.RowSpan" Value="2" />
                            <Setter TargetName="VisitorScoreValue" Property="Grid.RowSpan" Value="2" />
                            <Setter TargetName="HomeDetailLabel" Property="Grid.Row" Value="2" />
                            <Setter TargetName="VisitorDetailLabel" Property="Grid.Row" Value="2" />
                            <Setter TargetName="HomeDetailLabel" Property="Label.FontSize" Value="13" />
                            <Setter TargetName="VisitorDetailLabel" Property="Label.FontSize" Value="13" />
                            <Setter TargetName="InningStatusLabel" Property="Label.FontSize" Value="14" />
                            <Setter TargetName="OutsStatusLabel" Property="Label.FontSize" Value="14" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="LiveCompactLandscape">
                        <VisualState.Setters>
                            <Setter TargetName="ScoreboardBorder" Property="Padding" Value="8,0" />
                            <Setter TargetName="ScoreboardGrid" Property="ColumnDefinitions" Value="*,1,Auto,1,*" />
                            <Setter TargetName="ScoreboardGrid" Property="RowDefinitions" Value="Auto" />
                            <Setter TargetName="ScoreboardGrid" Property="RowSpacing" Value="0" />
                            <Setter TargetName="HomeScoreboard" Property="Grid.Column" Value="4" />
                            <Setter TargetName="HomeScoreboard" Property="RowDefinitions" Value="Auto,Auto,Auto" />
                            <Setter TargetName="VisitorScoreboard" Property="RowDefinitions" Value="Auto,Auto,Auto" />
                            <Setter TargetName="HomeScoreboard" Property="RowSpacing" Value="0" />
                            <Setter TargetName="VisitorScoreboard" Property="RowSpacing" Value="0" />
                            <Setter TargetName="ScoreboardRightDivider" Property="IsVisible" Value="True" />
                            <Setter TargetName="ScoreboardRightDivider" Property="Grid.Column" Value="3" />
                            <Setter TargetName="GameStatusPanel" Property="Grid.Row" Value="0" />
                            <Setter TargetName="GameStatusPanel" Property="Grid.Column" Value="2" />
                            <Setter TargetName="GameStatusPanel" Property="Grid.ColumnSpan" Value="1" />
                            <Setter TargetName="GameStatusPanel" Property="Padding" Value="8,0" />
                            <Setter TargetName="CombinedStatusLabel" Property="IsVisible" Value="False" />
                            <Setter TargetName="InningStatusLabel" Property="IsVisible" Value="True" />
                            <Setter TargetName="OutsStatusLabel" Property="IsVisible" Value="True" />
                            <Setter TargetName="HomeHeading" Property="Label.FontSize" Value="12" />
                            <Setter TargetName="VisitorHeading" Property="Label.FontSize" Value="12" />
                            <Setter TargetName="HomeTeamName" Property="Label.FontSize" Value="15" />
                            <Setter TargetName="VisitorTeamName" Property="Label.FontSize" Value="15" />
                            <Setter TargetName="HomeScoreValue" Property="Label.FontSize" Value="28" />
                            <Setter TargetName="VisitorScoreValue" Property="Label.FontSize" Value="28" />
                            <Setter TargetName="HomeScoreValue" Property="Grid.Row" Value="0" />
                            <Setter TargetName="VisitorScoreValue" Property="Grid.Row" Value="0" />
                            <Setter TargetName="HomeScoreValue" Property="Grid.Column" Value="1" />
                            <Setter TargetName="VisitorScoreValue" Property="Grid.Column" Value="1" />
                            <Setter TargetName="HomeScoreValue" Property="Grid.RowSpan" Value="2" />
                            <Setter TargetName="VisitorScoreValue" Property="Grid.RowSpan" Value="2" />
                            <Setter TargetName="HomeDetailLabel" Property="Grid.Row" Value="2" />
                            <Setter TargetName="VisitorDetailLabel" Property="Grid.Row" Value="2" />
                            <Setter TargetName="HomeDetailLabel" Property="Label.FontSize" Value="12" />
                            <Setter TargetName="VisitorDetailLabel" Property="Label.FontSize" Value="12" />
                            <Setter TargetName="InningStatusLabel" Property="Label.FontSize" Value="13" />
                            <Setter TargetName="OutsStatusLabel" Property="Label.FontSize" Value="13" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="CompletedPortrait">
                        <VisualState.Setters>
                            <Setter TargetName="ScoreboardBorder" Property="Padding" Value="24,12" />
                            <Setter TargetName="ContentGrid" Property="RowSpacing" Value="4" />
                            <Setter TargetName="HeaderLabel" Property="IsVisible" Value="True" />
                            <Setter TargetName="ScoreboardGrid" Property="RowDefinitions" Value="Auto" />
                            <Setter TargetName="ScoreboardGrid" Property="RowSpacing" Value="0" />
                            <Setter TargetName="HomeScoreboard" Property="ColumnDefinitions" Value="*" />
                            <Setter TargetName="VisitorScoreboard" Property="ColumnDefinitions" Value="*" />
                            <Setter TargetName="HomeScoreboard" Property="RowDefinitions" Value="Auto,Auto,Auto" />
                            <Setter TargetName="VisitorScoreboard" Property="RowDefinitions" Value="Auto,Auto,Auto" />
                            <Setter TargetName="HomeScoreboard" Property="RowSpacing" Value="2" />
                            <Setter TargetName="VisitorScoreboard" Property="RowSpacing" Value="2" />
                            <Setter TargetName="HomeHeading" Property="Label.FontSize" Value="16" />
                            <Setter TargetName="VisitorHeading" Property="Label.FontSize" Value="16" />
                            <Setter TargetName="HomeTeamName" Property="Label.FontSize" Value="20" />
                            <Setter TargetName="VisitorTeamName" Property="Label.FontSize" Value="20" />
                            <Setter TargetName="HomeScoreValue" Property="Label.FontSize" Value="56" />
                            <Setter TargetName="VisitorScoreValue" Property="Label.FontSize" Value="56" />
                            <Setter TargetName="HomeDetailLabel" Property="IsVisible" Value="False" />
                            <Setter TargetName="VisitorDetailLabel" Property="IsVisible" Value="False" />
                            <Setter TargetName="GameStatusPanel" Property="IsVisible" Value="False" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="CompletedLandscape">
                        <VisualState.Setters>
                            <Setter TargetName="ScoreboardBorder" Property="Padding" Value="8,2" />
                            <Setter TargetName="ContentGrid" Property="RowDefinitions" Value="Auto" />
                            <Setter TargetName="ContentGrid" Property="RowSpacing" Value="0" />
                            <Setter TargetName="HeaderLabel" Property="IsVisible" Value="False" />
                            <Setter TargetName="ScoreboardGrid" Property="Grid.Row" Value="0" />
                            <Setter TargetName="ScoreboardGrid" Property="ColumnDefinitions" Value="*,1,Auto,1,*" />
                            <Setter TargetName="ScoreboardGrid" Property="RowDefinitions" Value="Auto" />
                            <Setter TargetName="ScoreboardGrid" Property="ColumnSpacing" Value="8" />
                            <Setter TargetName="ScoreboardGrid" Property="RowSpacing" Value="0" />
                            <Setter TargetName="HomeScoreboard" Property="Grid.Column" Value="4" />
                            <Setter TargetName="HomeScoreboard" Property="ColumnDefinitions" Value="*" />
                            <Setter TargetName="VisitorScoreboard" Property="ColumnDefinitions" Value="*" />
                            <Setter TargetName="HomeScoreboard" Property="RowDefinitions" Value="Auto,Auto,Auto" />
                            <Setter TargetName="VisitorScoreboard" Property="RowDefinitions" Value="Auto,Auto,Auto" />
                            <Setter TargetName="HomeScoreboard" Property="RowSpacing" Value="0" />
                            <Setter TargetName="VisitorScoreboard" Property="RowSpacing" Value="0" />
                            <Setter TargetName="ScoreboardRightDivider" Property="IsVisible" Value="True" />
                            <Setter TargetName="ScoreboardRightDivider" Property="Grid.Column" Value="3" />
                            <Setter TargetName="GameStatusPanel" Property="IsVisible" Value="True" />
                            <Setter TargetName="GameStatusPanel" Property="Grid.Row" Value="0" />
                            <Setter TargetName="GameStatusPanel" Property="Grid.Column" Value="2" />
                            <Setter TargetName="GameStatusPanel" Property="Grid.ColumnSpan" Value="1" />
                            <Setter TargetName="GameStatusPanel" Property="Padding" Value="8,0" />
                            <Setter TargetName="CompletedCompactHeaderLabel" Property="IsVisible" Value="True" />
                            <Setter TargetName="CompletedCompactHeaderLabel" Property="Label.FontSize" Value="14" />
                            <Setter TargetName="CombinedStatusLabel" Property="IsVisible" Value="False" />
                            <Setter TargetName="HomeHeading" Property="Label.FontSize" Value="12" />
                            <Setter TargetName="VisitorHeading" Property="Label.FontSize" Value="12" />
                            <Setter TargetName="HomeTeamName" Property="Label.FontSize" Value="15" />
                            <Setter TargetName="VisitorTeamName" Property="Label.FontSize" Value="15" />
                            <Setter TargetName="HomeScoreValue" Property="Label.FontSize" Value="32" />
                            <Setter TargetName="VisitorScoreValue" Property="Label.FontSize" Value="32" />
                            <Setter TargetName="HomeDetailLabel" Property="IsVisible" Value="False" />
                            <Setter TargetName="VisitorDetailLabel" Property="IsVisible" Value="False" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </Grid.VisualStateManager.VisualStateGroups>

            <Label x:Name="HeaderLabel"
                   IsVisible="False"
                   AutomationId="{Binding HeaderAutomationId, Source={x:Reference ScoreboardRoot}, x:DataType=controls:FullScoreboard}"
                   Text="{Binding HeaderText, Source={x:Reference ScoreboardRoot}, x:DataType=controls:FullScoreboard}"
                   FontSize="20"
                   FontAttributes="Bold"
                   HorizontalTextAlignment="Center"
                   SemanticProperties.HeadingLevel="Level1" />
            <Grid x:Name="ScoreboardGrid"
                  Grid.Row="1"
                  ColumnDefinitions="*,1,*"
                  RowDefinitions="Auto,Auto"
                  ColumnSpacing="24"
                  RowSpacing="8">
                <Grid x:Name="VisitorScoreboard"
                      Grid.Column="0"
                      ColumnDefinitions="*,Auto"
                      RowDefinitions="Auto,Auto,Auto,Auto"
                      RowSpacing="4"
                      HorizontalOptions="Fill">
                    <Label x:Name="VisitorHeading"
                           Text="{x:Static strings:AppResources.VisitorScoreboardHeading}"
                           FontSize="20"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center" />
                    <Label x:Name="VisitorTeamName"
                           Grid.Row="1"
                           AutomationId="{Binding VisitorNameAutomationId, Source={x:Reference ScoreboardRoot}, x:DataType=controls:FullScoreboard}"
                           Text="{Binding VisitorName, Source={x:Reference ScoreboardRoot}, x:DataType=controls:FullScoreboard}"
                           FontSize="24"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center"
                           LineBreakMode="TailTruncation"
                           MaxLines="1" />
                    <Label x:Name="VisitorScoreValue"
                           Grid.Row="2"
                           AutomationId="{Binding VisitorScoreAutomationId, Source={x:Reference ScoreboardRoot}, x:DataType=controls:FullScoreboard}"
                           Text="{Binding VisitorScore, Source={x:Reference ScoreboardRoot}, x:DataType=controls:FullScoreboard}"
                           FontSize="52"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center" />
                    <Label x:Name="VisitorDetailLabel"
                           Grid.Row="3"
                           Text="{Binding VisitorDetailText, Source={x:Reference ScoreboardRoot}, x:DataType=controls:FullScoreboard}"
                           FontSize="16"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center" />
                </Grid>
                <BoxView Grid.Column="1"
                         BackgroundColor="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}" />
                <BoxView x:Name="ScoreboardRightDivider"
                         Grid.Column="1"
                         IsVisible="False"
                         BackgroundColor="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}" />
                <Grid x:Name="HomeScoreboard"
                      Grid.Column="2"
                      ColumnDefinitions="*,Auto"
                      RowDefinitions="Auto,Auto,Auto,Auto"
                      RowSpacing="4"
                      HorizontalOptions="Fill">
                    <Label x:Name="HomeHeading"
                           Text="{x:Static strings:AppResources.HomeScoreboardHeading}"
                           FontSize="20"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center" />
                    <Label x:Name="HomeTeamName"
                           Grid.Row="1"
                           AutomationId="{Binding HomeNameAutomationId, Source={x:Reference ScoreboardRoot}, x:DataType=controls:FullScoreboard}"
                           Text="{Binding HomeName, Source={x:Reference ScoreboardRoot}, x:DataType=controls:FullScoreboard}"
                           FontSize="24"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center"
                           LineBreakMode="TailTruncation"
                           MaxLines="1" />
                    <Label x:Name="HomeScoreValue"
                           Grid.Row="2"
                           AutomationId="{Binding HomeScoreAutomationId, Source={x:Reference ScoreboardRoot}, x:DataType=controls:FullScoreboard}"
                           Text="{Binding HomeScore, Source={x:Reference ScoreboardRoot}, x:DataType=controls:FullScoreboard}"
                           FontSize="52"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center" />
                    <Label x:Name="HomeDetailLabel"
                           Grid.Row="3"
                           Text="{Binding HomeDetailText, Source={x:Reference ScoreboardRoot}, x:DataType=controls:FullScoreboard}"
                           FontSize="16"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center" />
                </Grid>
                <VerticalStackLayout x:Name="GameStatusPanel"
                                     Grid.Row="1"
                                      Grid.ColumnSpan="3"
                                      Spacing="2">
                    <Label x:Name="CompletedCompactHeaderLabel"
                           AutomationId="{Binding HeaderAutomationId, Source={x:Reference ScoreboardRoot}, x:DataType=controls:FullScoreboard}"
                           Text="{Binding HeaderText, Source={x:Reference ScoreboardRoot}, x:DataType=controls:FullScoreboard}"
                           IsVisible="False"
                           FontSize="20"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center"
                           SemanticProperties.HeadingLevel="Level1" />
                    <Label x:Name="CombinedStatusLabel"
                           AutomationId="{Binding CombinedStatusAutomationId, Source={x:Reference ScoreboardRoot}, x:DataType=controls:FullScoreboard}"
                           Text="{Binding CombinedStatusText, Source={x:Reference ScoreboardRoot}, x:DataType=controls:FullScoreboard}"
                           FontSize="20"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center" />
                    <Label x:Name="InningStatusLabel"
                           AutomationId="{Binding InningStatusAutomationId, Source={x:Reference ScoreboardRoot}, x:DataType=controls:FullScoreboard}"
                           Text="{Binding InningStatusText, Source={x:Reference ScoreboardRoot}, x:DataType=controls:FullScoreboard}"
                           IsVisible="False"
                           FontSize="16"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center" />
                    <Label x:Name="OutsStatusLabel"
                           AutomationId="{Binding OutsStatusAutomationId, Source={x:Reference ScoreboardRoot}, x:DataType=controls:FullScoreboard}"
                           Text="{Binding OutsStatusText, Source={x:Reference ScoreboardRoot}, x:DataType=controls:FullScoreboard}"
                           IsVisible="False"
                           FontSize="16"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center" />
                    <Label Text="{x:Static strings:AppResources.OneUpOnLabel}"
                           IsVisible="{Binding IsOneUpEnabled, Source={x:Reference ScoreboardRoot}, x:DataType=controls:FullScoreboard}"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Grid>
        </Grid>
    </Border>
</ContentView>
