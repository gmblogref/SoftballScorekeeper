<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:SoftballScorekeeper.Views.Controls"
             xmlns:strings="clr-namespace:SoftballScorekeeper.Resources.Strings"
             xmlns:viewModels="clr-namespace:SoftballScorekeeper.ViewModels"
             x:Class="SoftballScorekeeper.Views.AddGamePage"
             x:DataType="viewModels:AddGameViewModel"
             Title="{x:Static strings:AppResources.AddGameTitle}">

    <Grid Padding="40" RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" RowSpacing="16">
        <controls:PrimarySectionNavigation Grid.Row="0" CurrentSection="Teams" />
        <Label
            Grid.Row="1"
            Text="{Binding TeamName}"
            Style="{StaticResource Headline}"
            SemanticProperties.HeadingLevel="Level1"
            IsVisible="{Binding IsTeamLoaded}" />
        <Label
            Grid.Row="2"
            Text="{x:Static strings:AppResources.AddGameHeading}"
            Style="{StaticResource SubHeadline}"
            SemanticProperties.HeadingLevel="Level2"
            IsVisible="{Binding IsTeamLoaded}" />
        <Border
            Grid.Row="3"
            Padding="14,10"
            BackgroundColor="{AppThemeBinding Light={StaticResource WarningSurface}, Dark={StaticResource WarningSurfaceDark}}"
            Stroke="{AppThemeBinding Light={StaticResource Error}, Dark={StaticResource ErrorDark}}"
            StrokeThickness="2">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="8" />
            </Border.StrokeShape>
            <Label
                Text="{Binding ValidationMessage}"
                FontAttributes="Bold"
                TextColor="{AppThemeBinding Light={StaticResource WarningText}, Dark={StaticResource WarningTextDark}}"
                HorizontalTextAlignment="Center" />
            <Border.Triggers>
                <DataTrigger TargetType="Border" Binding="{Binding ValidationMessage}" Value="">
                    <Setter Property="IsVisible" Value="False" />
                </DataTrigger>
            </Border.Triggers>
        </Border>

        <ScrollView Grid.Row="4" IsVisible="{Binding IsTeamLoaded}">
            <Grid
                Padding="0,4"
                RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                ColumnDefinitions="*,*"
                ColumnSpacing="28"
                RowSpacing="16">
                <VerticalStackLayout Spacing="8">
                    <HorizontalStackLayout Spacing="4">
                        <Label Text="{x:Static strings:AppResources.SeasonLabel}" />
                        <Label
                            Text="{x:Static strings:AppResources.RequiredFieldIndicator}"
                            FontAttributes="Bold"
                            TextColor="{AppThemeBinding Light={StaticResource Error}, Dark={StaticResource ErrorDark}}" />
                    </HorizontalStackLayout>
                    <Border
                        Padding="2"
                        BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource OffBlack}}"
                        Stroke="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource Gray300}}"
                        StrokeThickness="2"
                        IsVisible="{Binding IsUsingExistingSeason}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="6" />
                        </Border.StrokeShape>
                        <Picker
                            ItemsSource="{Binding Seasons}"
                            SelectedItem="{Binding SelectedSeason, Mode=TwoWay}"
                            Title="{x:Static strings:AppResources.SelectSeasonPrompt}"
                            MinimumHeightRequest="52"
                            BackgroundColor="Transparent">
                            <Picker.ItemDisplayBinding>
                                <Binding Path="DisplayName" x:DataType="viewModels:SeasonSelectionItem" />
                            </Picker.ItemDisplayBinding>
                        </Picker>
                    </Border>
                    <Label
                        Text="{x:Static strings:AppResources.SeasonSelectionHint}"
                        FontSize="13"
                        IsVisible="{Binding IsUsingExistingSeason}" />
                </VerticalStackLayout>

                <Grid Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="12" MinimumHeightRequest="52">
                    <Label
                        Text="{x:Static strings:AppResources.CreateNewSeasonLabel}"
                        VerticalTextAlignment="Center" />
                    <Switch
                        Grid.Column="1"
                        IsToggled="{Binding IsCreatingNewSeason, Mode=TwoWay}"
                        MinimumHeightRequest="48"
                        MinimumWidthRequest="48" />
                </Grid>

                <Grid
                    Grid.Row="1"
                    Grid.ColumnSpan="2"
                    ColumnDefinitions="2*,*"
                    ColumnSpacing="20"
                    IsVisible="{Binding IsCreatingNewSeason}">
                    <VerticalStackLayout Spacing="8">
                        <HorizontalStackLayout Spacing="4">
                            <Label Text="{x:Static strings:AppResources.SeasonNameLabel}" />
                            <Label
                                Text="{x:Static strings:AppResources.RequiredFieldIndicator}"
                                FontAttributes="Bold"
                                TextColor="{AppThemeBinding Light={StaticResource Error}, Dark={StaticResource ErrorDark}}" />
                        </HorizontalStackLayout>
                        <Entry
                            Text="{Binding SeasonName, Mode=TwoWay}"
                            Placeholder="{x:Static strings:AppResources.SeasonNamePlaceholder}"
                            MinimumHeightRequest="52" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="8">
                        <HorizontalStackLayout Spacing="4">
                            <Label Text="{x:Static strings:AppResources.SeasonYearLabel}" />
                            <Label
                                Text="{x:Static strings:AppResources.RequiredFieldIndicator}"
                                FontAttributes="Bold"
                                TextColor="{AppThemeBinding Light={StaticResource Error}, Dark={StaticResource ErrorDark}}" />
                        </HorizontalStackLayout>
                        <Entry
                            Text="{Binding SeasonYearText, Mode=TwoWay}"
                            Placeholder="{x:Static strings:AppResources.SeasonYearPlaceholder}"
                            Keyboard="Numeric"
                            MaxLength="4"
                            MinimumHeightRequest="52" />
                    </VerticalStackLayout>
                </Grid>

                <VerticalStackLayout Grid.Row="2" Spacing="8">
                    <HorizontalStackLayout Spacing="4">
                        <Label Text="{x:Static strings:AppResources.GameDateLabel}" />
                        <Label
                            Text="{x:Static strings:AppResources.RequiredFieldIndicator}"
                            FontAttributes="Bold"
                            TextColor="{AppThemeBinding Light={StaticResource Error}, Dark={StaticResource ErrorDark}}" />
                    </HorizontalStackLayout>
                    <DatePicker Date="{Binding ScheduledDate, Mode=TwoWay}" MinimumHeightRequest="52" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Row="2" Grid.Column="1" Spacing="8">
                    <HorizontalStackLayout Spacing="4">
                        <Label Text="{x:Static strings:AppResources.GameTimeLabel}" />
                        <Label
                            Text="{x:Static strings:AppResources.RequiredFieldIndicator}"
                            FontAttributes="Bold"
                            TextColor="{AppThemeBinding Light={StaticResource Error}, Dark={StaticResource ErrorDark}}" />
                    </HorizontalStackLayout>
                    <TimePicker Time="{Binding ScheduledTime, Mode=TwoWay}" MinimumHeightRequest="52" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Row="3" Spacing="8">
                    <Label Text="{x:Static strings:AppResources.OpponentLabel}" />
                    <Entry
                        Text="{Binding Opponent, Mode=TwoWay}"
                        Placeholder="{x:Static strings:AppResources.OpponentPlaceholder}"
                        MinimumHeightRequest="52" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Row="3" Grid.Column="1" Spacing="8">
                    <Label Text="{x:Static strings:AppResources.FieldLabel}" />
                    <Entry
                        Text="{Binding Field, Mode=TwoWay}"
                        Placeholder="{x:Static strings:AppResources.FieldPlaceholder}"
                        MinimumHeightRequest="52" />
                </VerticalStackLayout>

                <Grid Grid.Row="4" ColumnDefinitions="*,Auto" ColumnSpacing="12" MinimumHeightRequest="52">
                    <Label
                        Text="{x:Static strings:AppResources.AddSecondGameLabel}"
                        VerticalTextAlignment="Center" />
                    <Switch
                        Grid.Column="1"
                        IsToggled="{Binding AddSecondGame, Mode=TwoWay}"
                        MinimumHeightRequest="48"
                        MinimumWidthRequest="48" />
                </Grid>
                <VerticalStackLayout
                    Grid.Row="4"
                    Grid.Column="1"
                    Spacing="8"
                    IsVisible="{Binding AddSecondGame}">
                    <HorizontalStackLayout Spacing="4">
                        <Label Text="{x:Static strings:AppResources.SecondGameTimeLabel}" />
                        <Label
                            Text="{x:Static strings:AppResources.RequiredFieldIndicator}"
                            FontAttributes="Bold"
                            TextColor="{AppThemeBinding Light={StaticResource Error}, Dark={StaticResource ErrorDark}}" />
                    </HorizontalStackLayout>
                    <TimePicker Time="{Binding SecondGameTime, Mode=TwoWay}" MinimumHeightRequest="52" />
                </VerticalStackLayout>
            </Grid>
        </ScrollView>

        <HorizontalStackLayout Grid.Row="5" HorizontalOptions="Center" Spacing="20">
            <Button
                Text="{x:Static strings:AppResources.SaveButton}"
                Command="{Binding SaveCommand}"
                MinimumHeightRequest="52"
                MinimumWidthRequest="180"
                Padding="24,12" />
            <Button
                Text="{x:Static strings:AppResources.CancelButton}"
                Command="{Binding CancelCommand}"
                MinimumHeightRequest="52"
                MinimumWidthRequest="180"
                Padding="24,12" />
        </HorizontalStackLayout>
    </Grid>
</ContentPage>
