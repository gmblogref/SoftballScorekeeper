<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:strings="clr-namespace:SoftballScorekeeper.Resources.Strings"
             xmlns:viewModels="clr-namespace:SoftballScorekeeper.ViewModels"
             x:Class="SoftballScorekeeper.Views.EditPlayerPage"
             x:DataType="viewModels:EditPlayerViewModel"
             Title="{x:Static strings:AppResources.EditPlayerTitle}">
    <ScrollView>
        <VerticalStackLayout Padding="40" Spacing="20">
            <Label Text="{x:Static strings:AppResources.EditPlayerTitle}"
                   Style="{StaticResource Headline}"
                   SemanticProperties.HeadingLevel="Level1" />
            <Label Text="{x:Static strings:AppResources.FirstNameLabel}"
                   SemanticProperties.HeadingLevel="Level2" />
            <Entry Text="{Binding FirstName, Mode=TwoWay}"
                   Placeholder="{x:Static strings:AppResources.FirstNamePlaceholder}"
                   IsEnabled="{Binding IsPlayerLoaded}" />
            <Label Text="{x:Static strings:AppResources.LastNameLabel}"
                   SemanticProperties.HeadingLevel="Level2" />
            <Entry Text="{Binding LastName, Mode=TwoWay}"
                   Placeholder="{x:Static strings:AppResources.LastNamePlaceholder}"
                   IsEnabled="{Binding IsPlayerLoaded}" />
            <Label Text="{Binding ValidationMessage}">
                <Label.Triggers>
                    <DataTrigger TargetType="Label" Binding="{Binding ValidationMessage}" Value="">
                        <Setter Property="IsVisible" Value="False" />
                    </DataTrigger>
                </Label.Triggers>
            </Label>
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="16">
                <Button Text="{x:Static strings:AppResources.SaveButton}"
                        Command="{Binding SaveCommand}" />
                <Button Text="{x:Static strings:AppResources.CancelButton}"
                        Command="{Binding CancelCommand}" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
