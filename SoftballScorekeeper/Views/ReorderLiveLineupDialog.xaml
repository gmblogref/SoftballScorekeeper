<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:strings="clr-namespace:SoftballScorekeeper.Resources.Strings"
             xmlns:viewModels="clr-namespace:SoftballScorekeeper.ViewModels"
             x:Class="SoftballScorekeeper.Views.ReorderLiveLineupDialog"
             AutomationId="ReorderLiveLineupDialog"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#99000000">
    <Grid Padding="16">
        <Border Padding="20"
                MaximumWidthRequest="720"
                MaximumHeightRequest="700"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource Gray900}}"
                StrokeShape="RoundRectangle 16">
            <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" RowSpacing="12">
                <Label Text="{x:Static strings:AppResources.ReorderLiveLineupTitle}"
                       FontSize="24"
                       FontAttributes="Bold"
                       HorizontalTextAlignment="Center"
                       SemanticProperties.HeadingLevel="Level1" />
                <Label Grid.Row="1"
                       Text="{x:Static strings:AppResources.ReorderLiveLineupInstructions}"
                       HorizontalTextAlignment="Center" />
                <CollectionView x:Name="LineupCollection"
                                Grid.Row="2"
                                AutomationId="ReorderLiveLineupList"
                                ItemsSource="{Binding Items}"
                                SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:LiveLineupReorderItem">
                            <Grid RowDefinitions="Auto,Auto,Auto">
                                <Grid.GestureRecognizers>
                                    <DragGestureRecognizer DragStarting="OnDragStarting"
                                                           DropCompleted="OnDropCompleted" />
                                    <DropGestureRecognizer AllowDrop="True"
                                                           DragOver="OnDragOver"
                                                           DragLeave="OnDragLeave"
                                                           Drop="OnDrop" />
                                </Grid.GestureRecognizers>
                                <Grid HeightRequest="18" IsVisible="{Binding IsDropGapBefore}">
                                    <BoxView Margin="12,7"
                                             HeightRequest="4"
                                             CornerRadius="2"
                                             Color="{StaticResource Primary}" />
                                </Grid>
                                <Border Grid.Row="1"
                                        AutomationId="{Binding RowAutomationId}"
                                        Padding="12,8"
                                        Margin="0,3"
                                        MinimumHeightRequest="56"
                                        Scale="1"
                                        Opacity="1"
                                        Stroke="{StaticResource Gray300}"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 8">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border"
                                                     Binding="{Binding IsDragged}"
                                                     Value="True">
                                            <Setter Property="Scale" Value="1.03" />
                                            <Setter Property="Opacity" Value="0.82" />
                                            <Setter Property="Stroke" Value="{StaticResource Primary}" />
                                            <Setter Property="StrokeThickness" Value="2" />
                                            <Setter Property="BackgroundColor"
                                                    Value="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource Gray600}}" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                        <Label Text="{Binding PositionAndNameDisplay}"
                                               FontSize="18"
                                               VerticalTextAlignment="Center"
                                               LineBreakMode="TailTruncation" />
                                        <Label Grid.Column="1"
                                               Text="{x:Static strings:AppResources.ViewLineupCurrentMarker}"
                                               IsVisible="{Binding IsCurrentSlot}"
                                               FontAttributes="Bold"
                                               VerticalTextAlignment="Center" />
                                    </Grid>
                                </Border>
                                <Grid Grid.Row="2" HeightRequest="18" IsVisible="{Binding IsDropGapAfter}">
                                    <BoxView Margin="12,7"
                                             HeightRequest="4"
                                             CornerRadius="2"
                                             Color="{StaticResource Primary}" />
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
                <Label Grid.Row="3"
                       Text="{Binding ValidationMessage}"
                       HorizontalTextAlignment="Center" />
                <Grid Grid.Row="4" ColumnDefinitions="*,*" ColumnSpacing="16">
                    <Button AutomationId="ReorderLiveLineupCancelButton"
                            Text="{x:Static strings:AppResources.CancelButton}"
                            Clicked="OnCancelClicked"
                            IsEnabled="{Binding IsNotBusy}"
                            MinimumHeightRequest="52" />
                    <Button Grid.Column="1"
                            AutomationId="ReorderLiveLineupSaveButton"
                            Text="{x:Static strings:AppResources.SaveLineupOrderButton}"
                            Clicked="OnSaveClicked"
                            IsEnabled="{Binding IsNotBusy}"
                            MinimumHeightRequest="52" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</ContentPage>
