<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:SoftballScorekeeper.Views.Controls"
             xmlns:strings="clr-namespace:SoftballScorekeeper.Resources.Strings"
             xmlns:viewModels="clr-namespace:SoftballScorekeeper.ViewModels"
             x:Class="SoftballScorekeeper.Views.TeamWorkspacePage"
             x:Name="PageRoot"
             x:DataType="viewModels:TeamWorkspaceViewModel"
             Title="{x:Static strings:AppResources.TeamWorkspaceTitle}">

    <Grid
        Padding="40"
        RowDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto,Auto"
        RowSpacing="20">

        <controls:PrimarySectionNavigation Grid.Row="0" CurrentSection="Teams" />

        <Grid Grid.Row="1" IsVisible="{Binding IsTeamLoaded}">
            <Label
                Text="{Binding TeamName}"
                Style="{StaticResource Headline}"
                MinimumHeightRequest="52"
                VerticalTextAlignment="Center"
                SemanticProperties.HeadingLevel="Level1"
                SemanticProperties.Hint="{x:Static strings:AppResources.TeamNameEditHint}">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding BeginTeamNameEditCommand}" />
                </Label.GestureRecognizers>
                <Label.Triggers>
                    <DataTrigger TargetType="Label" Binding="{Binding IsEditingTeamName}" Value="True">
                        <Setter Property="IsVisible" Value="False" />
                    </DataTrigger>
                </Label.Triggers>
            </Label>

            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="16" IsVisible="False">
                <Grid.Triggers>
                    <DataTrigger TargetType="Grid" Binding="{Binding IsEditingTeamName}" Value="True">
                        <Setter Property="IsVisible" Value="True" />
                    </DataTrigger>
                </Grid.Triggers>
                <Entry
                    Text="{Binding EditableTeamName, Mode=TwoWay}"
                    Placeholder="{x:Static strings:AppResources.TeamNamePlaceholder}"
                    MinimumHeightRequest="52"
                    FontSize="22" />
                <Button
                    Grid.Column="1"
                    Text="{x:Static strings:AppResources.SaveButton}"
                    Command="{Binding SaveTeamNameCommand}"
                    MinimumHeightRequest="52"
                    Padding="24,12" />
                <Button
                    Grid.Column="2"
                    Text="{x:Static strings:AppResources.CancelButton}"
                    Command="{Binding CancelTeamNameEditCommand}"
                    MinimumHeightRequest="52"
                    Padding="24,12" />
            </Grid>
        </Grid>

        <VerticalStackLayout Grid.Row="2" Spacing="8" IsVisible="{Binding IsTeamLoaded}">
            <Label
                Text="{x:Static strings:AppResources.CurrentRosterHeading}"
                Style="{StaticResource SubHeadline}"
                SemanticProperties.HeadingLevel="Level2" />
            <Label
                Text="{Binding SelectedPlayerCount, StringFormat={x:Static strings:AppResources.SelectedPlayerCountText}}"
                HorizontalOptions="Fill"
                HorizontalTextAlignment="Center"
                IsVisible="{Binding IsRemovingPlayers}" />
        </VerticalStackLayout>

        <Label
            Grid.Row="3"
            Text="{Binding ValidationMessage}"
            HorizontalTextAlignment="Center">
            <Label.Triggers>
                <DataTrigger TargetType="Label" Binding="{Binding ValidationMessage}" Value="">
                    <Setter Property="IsVisible" Value="False" />
                </DataTrigger>
            </Label.Triggers>
        </Label>

        <Grid Grid.Row="4" IsVisible="{Binding IsTeamLoaded}">
            <Label
                Text="{x:Static strings:AppResources.NoRosterPlayersMessage}"
                HorizontalTextAlignment="Center"
                VerticalOptions="Center"
                IsVisible="{Binding HasNoPlayers}" />

            <CollectionView
                ItemsSource="{Binding RosterPlayers}"
                IsVisible="{Binding HasPlayers}"
                SelectionMode="None">
                <CollectionView.Triggers>
                    <DataTrigger TargetType="CollectionView" Binding="{Binding IsRemovingPlayers}" Value="True">
                        <Setter Property="IsVisible" Value="False" />
                    </DataTrigger>
                </CollectionView.Triggers>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:PlayerSelectionItem">
                        <Grid Padding="20,12" RowDefinitions="Auto,1" MinimumHeightRequest="72">
                            <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                <Label Text="{Binding Player.FirstName}" FontSize="20" LineBreakMode="TailTruncation" />
                                <Label Text="{Binding Player.LastName}" FontSize="20" LineBreakMode="TailTruncation" />
                            </HorizontalStackLayout>
                            <BoxView
                                Grid.Row="1"
                                Margin="0,11,0,0"
                                HeightRequest="1"
                                Color="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray500}}" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <CollectionView
                ItemsSource="{Binding RosterPlayers}"
                IsVisible="{Binding IsRemovingPlayers}"
                SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:PlayerSelectionItem">
                        <Grid Padding="20,12" RowDefinitions="Auto,1" ColumnDefinitions="*,Auto" MinimumHeightRequest="72">
                            <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                <Label Text="{Binding Player.FirstName}" FontSize="20" LineBreakMode="TailTruncation" />
                                <Label Text="{Binding Player.LastName}" FontSize="20" LineBreakMode="TailTruncation" />
                            </HorizontalStackLayout>
                            <CheckBox
                                Grid.Column="1"
                                IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                MinimumHeightRequest="48"
                                MinimumWidthRequest="48"
                                HorizontalOptions="End"
                                VerticalOptions="Center" />
                            <BoxView Grid.Row="1" Grid.ColumnSpan="2" Margin="0,11,0,0" HeightRequest="1" Color="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray500}}" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <Label
            Grid.Row="5"
            Text="{Binding StatusMessage}"
            HorizontalTextAlignment="Center">
            <Label.Triggers>
                <DataTrigger TargetType="Label" Binding="{Binding StatusMessage}" Value="">
                    <Setter Property="IsVisible" Value="False" />
                </DataTrigger>
            </Label.Triggers>
        </Label>

        <HorizontalStackLayout Grid.Row="6" HorizontalOptions="Center" Spacing="20">
            <HorizontalStackLayout.Triggers>
                <DataTrigger TargetType="HorizontalStackLayout" Binding="{Binding IsRemovingPlayers}" Value="True">
                    <Setter Property="IsVisible" Value="False" />
                </DataTrigger>
            </HorizontalStackLayout.Triggers>
            <Button
                Text="{x:Static strings:AppResources.AddPlayersButton}"
                Command="{Binding AddPlayersCommand}"
                MinimumHeightRequest="52"
                MinimumWidthRequest="180"
                Padding="24,12" />
            <Button
                Text="{x:Static strings:AppResources.RemovePlayersButton}"
                Command="{Binding RemovePlayersCommand}"
                MinimumHeightRequest="52"
                MinimumWidthRequest="180"
                Padding="24,12" />
        </HorizontalStackLayout>

        <HorizontalStackLayout Grid.Row="6" HorizontalOptions="Center" Spacing="20" IsVisible="{Binding IsRemovingPlayers}">
            <Button
                Text="{x:Static strings:AppResources.CancelButton}"
                Command="{Binding CancelRemovePlayersCommand}"
                MinimumHeightRequest="52"
                Padding="24,12" />
            <Button
                Text="{x:Static strings:AppResources.RemoveSelectedPlayersFromTeamButton}"
                Command="{Binding RemoveSelectedPlayersCommand}"
                MinimumHeightRequest="52"
                Padding="24,12" />
        </HorizontalStackLayout>

        <Button
            Grid.Row="7"
            Margin="0,12,0,0"
            Padding="24,14"
            MinimumHeightRequest="52"
            MinimumWidthRequest="200"
            HorizontalOptions="Center"
            Text="{x:Static strings:AppResources.DeactivateTeamButton}"
            Command="{Binding RequestDeactivateTeamCommand}"
            BackgroundColor="Transparent"
            BorderColor="{AppThemeBinding Light=#B3261E, Dark=#FFB4AB}"
            BorderWidth="2"
            TextColor="{AppThemeBinding Light=#B3261E, Dark=#FFB4AB}">
            <Button.Triggers>
                <DataTrigger TargetType="Button" Binding="{Binding IsRemovingPlayers}" Value="True">
                    <Setter Property="IsVisible" Value="False" />
                </DataTrigger>
            </Button.Triggers>
        </Button>
    </Grid>
</ContentPage>
