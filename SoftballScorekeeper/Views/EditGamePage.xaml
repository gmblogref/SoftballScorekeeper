<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:SoftballScorekeeper.Views.Controls"
             xmlns:strings="clr-namespace:SoftballScorekeeper.Resources.Strings"
             xmlns:viewModels="clr-namespace:SoftballScorekeeper.ViewModels"
             x:Class="SoftballScorekeeper.Views.EditGamePage"
             x:DataType="viewModels:EditGameViewModel"
             Title="{x:Static strings:AppResources.EditGameTitle}">
    <Grid Padding="40" RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" RowSpacing="16">
        <controls:PrimarySectionNavigation Grid.Row="0" CurrentSection="Teams" />
        <Label Grid.Row="1" Text="{Binding TeamName}" Style="{StaticResource Headline}" IsVisible="{Binding IsLoaded}" />
        <Label Grid.Row="2" Text="{x:Static strings:AppResources.EditGameTitle}" Style="{StaticResource SubHeadline}" IsVisible="{Binding IsLoaded}" />
        <Border Grid.Row="3" Padding="14,10" BackgroundColor="{AppThemeBinding Light={StaticResource WarningSurface}, Dark={StaticResource WarningSurfaceDark}}" Stroke="{AppThemeBinding Light={StaticResource Error}, Dark={StaticResource ErrorDark}}" StrokeThickness="2">
            <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
            <Label Text="{Binding ValidationMessage}" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource WarningText}, Dark={StaticResource WarningTextDark}}" HorizontalTextAlignment="Center" />
            <Border.Triggers><DataTrigger TargetType="Border" Binding="{Binding ValidationMessage}" Value=""><Setter Property="IsVisible" Value="False" /></DataTrigger></Border.Triggers>
        </Border>
        <ScrollView Grid.Row="4" IsVisible="{Binding IsLoaded}">
            <Grid Padding="0,4" RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="*,*" ColumnSpacing="28" RowSpacing="16">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{x:Static strings:AppResources.SeasonLabel}" />
                    <Border Padding="2" Stroke="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource Gray300}}" StrokeThickness="2" IsVisible="{Binding IsUsingExistingSeason}">
                        <Picker ItemsSource="{Binding Seasons}" SelectedItem="{Binding SelectedSeason, Mode=TwoWay}" Title="{x:Static strings:AppResources.SelectSeasonPrompt}" MinimumHeightRequest="52">
                            <Picker.ItemDisplayBinding><Binding Path="DisplayName" x:DataType="viewModels:SeasonSelectionItem" /></Picker.ItemDisplayBinding>
                        </Picker>
                    </Border>
                </VerticalStackLayout>
                <Grid Grid.Column="1" ColumnDefinitions="*,Auto"><Label Text="{x:Static strings:AppResources.CreateNewSeasonLabel}" VerticalTextAlignment="Center" /><Switch Grid.Column="1" IsToggled="{Binding IsCreatingNewSeason, Mode=TwoWay}" /></Grid>
                <Grid Grid.Row="1" Grid.ColumnSpan="2" IsVisible="{Binding IsCreatingNewSeason}">
                    <VerticalStackLayout Spacing="8"><Label Text="{x:Static strings:AppResources.SeasonNameLabel}" /><Entry Text="{Binding SeasonName, Mode=TwoWay}" Placeholder="{x:Static strings:AppResources.SeasonNamePlaceholder}" MinimumHeightRequest="52" /></VerticalStackLayout>
                </Grid>
                <VerticalStackLayout Grid.Row="2" Spacing="8"><Label Text="{x:Static strings:AppResources.GameDateLabel}" /><DatePicker Date="{Binding ScheduledDate, Mode=TwoWay}" MinimumHeightRequest="52" /></VerticalStackLayout>
                <VerticalStackLayout Grid.Row="2" Grid.Column="1" Spacing="8"><Label Text="{x:Static strings:AppResources.GameTimeLabel}" /><TimePicker Time="{Binding ScheduledTime, Mode=TwoWay}" MinimumHeightRequest="52" /></VerticalStackLayout>
                <VerticalStackLayout Grid.Row="3" Spacing="8"><Label Text="{x:Static strings:AppResources.OpponentLabel}" /><Entry Text="{Binding Opponent, Mode=TwoWay}" Placeholder="{x:Static strings:AppResources.OpponentPlaceholder}" MinimumHeightRequest="52" /></VerticalStackLayout>
                <VerticalStackLayout Grid.Row="3" Grid.Column="1" Spacing="8"><Label Text="{x:Static strings:AppResources.FieldLabel}" /><Entry Text="{Binding Field, Mode=TwoWay}" Placeholder="{x:Static strings:AppResources.FieldPlaceholder}" MinimumHeightRequest="52" /></VerticalStackLayout>
            </Grid>
        </ScrollView>
        <HorizontalStackLayout Grid.Row="5" HorizontalOptions="Center" Spacing="20">
            <Button Text="{x:Static strings:AppResources.SaveButton}" Command="{Binding SaveCommand}" MinimumHeightRequest="52" MinimumWidthRequest="180" />
            <Button Text="{x:Static strings:AppResources.CancelButton}" Command="{Binding CancelCommand}" MinimumHeightRequest="52" MinimumWidthRequest="180" />
        </HorizontalStackLayout>
    </Grid>
</ContentPage>
