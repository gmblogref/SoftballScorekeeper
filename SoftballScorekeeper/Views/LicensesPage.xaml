<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:strings="clr-namespace:SoftballScorekeeper.Resources.Strings"
             x:Class="SoftballScorekeeper.Views.LicensesPage"
             Title="{x:Static strings:AppResources.LicensesTitle}">
    <Grid
        Style="{StaticResource ResponsivePageGrid}"
        RowDefinitions="Auto,Auto,Auto,Auto,*">
        <Label
            Grid.Row="0"
            Text="{x:Static strings:AppResources.LicensesTitle}"
            Style="{StaticResource ResponsiveHeadline}"
            SemanticProperties.HeadingLevel="Level1" />
        <VerticalStackLayout Grid.Row="1" Spacing="6">
            <Label
                Text="{x:Static strings:AppResources.LicensesDescription}"
                FontSize="18" />
            <Label
                AutomationId="ApplicationRequiredNotice"
                Text="{x:Static strings:AppResources.LicensesRequiredNotice}"
                FontAttributes="Bold"
                FontSize="16" />
        </VerticalStackLayout>
        <Label
            Grid.Row="2"
            Text="{x:Static strings:AppResources.LicenseDocumentPickerLabel}"
            FontAttributes="Bold"
            FontSize="18" />
        <Picker
            x:Name="DocumentPicker"
            Grid.Row="3"
            AutomationId="LicenseDocumentPicker"
            MinimumHeightRequest="56"
            SelectedIndexChanged="OnDocumentSelectionChanged"
            Title="{x:Static strings:AppResources.LicenseDocumentPickerTitle}" />
        <Grid Grid.Row="4">
            <ScrollView
                AutomationId="LicenseDocumentScrollView"
                VerticalScrollBarVisibility="Always">
                <Label
                    x:Name="DocumentContentLabel"
                    AutomationId="LicenseDocumentContent"
                    FontFamily="monospace"
                    FontSize="14"
                    LineBreakMode="WordWrap"
                    Padding="0,8,0,20" />
            </ScrollView>
            <ActivityIndicator
                x:Name="DocumentLoadingIndicator"
                AutomationId="LicenseDocumentLoadingIndicator"
                HorizontalOptions="Center"
                IsVisible="False"
                VerticalOptions="Center" />
        </Grid>
    </Grid>
</ContentPage>
