<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:strings="clr-namespace:SoftballScorekeeper.Resources.Strings"
             xmlns:controls="clr-namespace:SoftballScorekeeper.Views.Controls"
             xmlns:viewModels="clr-namespace:SoftballScorekeeper.ViewModels"
             x:Class="SoftballScorekeeper.Views.AddPlayersToTeamPage"
             x:DataType="viewModels:AddPlayersToTeamViewModel"
             Title="{x:Static strings:AppResources.AddPlayersToTeamTitle}">

    <Grid Padding="40" RowDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto" RowSpacing="20">
        <controls:PrimarySectionNavigation Grid.Row="0" CurrentSection="Teams" />
        <Label
            Grid.Row="1"
            Text="{Binding TeamName}"
            Style="{StaticResource Headline}"
            SemanticProperties.HeadingLevel="Level1"
            IsVisible="{Binding IsTeamLoaded}" />
        <Label
            Grid.Row="2"
            Text="{x:Static strings:AppResources.AddPlayersHeading}"
            Style="{StaticResource SubHeadline}"
            SemanticProperties.HeadingLevel="Level2"
            IsVisible="{Binding IsTeamLoaded}" />
        <Label
            Grid.Row="3"
            Text="{Binding ValidationMessage}"
            HorizontalTextAlignment="Center">
            <Label.Triggers>
                <DataTrigger TargetType="Label" Binding="{Binding ValidationMessage}" Value="">
                    <Setter Property="IsVisible" Value="False" />
                </DataTrigger>
            </Label.Triggers>
        </Label>
        <Grid Grid.Row="4" ColumnDefinitions="*,Auto">
            <Label
                Text="{x:Static strings:AppResources.EligiblePlayersHeading}"
                SemanticProperties.HeadingLevel="Level2"
                IsVisible="{Binding IsTeamLoaded}" />
            <Label
                Grid.Column="1"
                Text="{Binding SelectedPlayerCount, StringFormat={x:Static strings:AppResources.SelectedPlayerCountText}}"
                IsVisible="{Binding IsTeamLoaded}" />
        </Grid>
        <Grid Grid.Row="5" IsVisible="{Binding IsTeamLoaded}">
            <Label
                Text="{x:Static strings:AppResources.NoEligiblePlayersMessage}"
                HorizontalTextAlignment="Center"
                VerticalOptions="Center"
                IsVisible="{Binding HasNoEligiblePlayers}" />
            <CollectionView ItemsSource="{Binding Players}" IsVisible="{Binding HasEligiblePlayers}" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:PlayerSelectionItem">
                        <Grid Padding="20,12" RowDefinitions="Auto,1" ColumnDefinitions="*,Auto" MinimumHeightRequest="72">
                            <Label Text="{Binding DisplayName}" FontSize="20" LineBreakMode="WordWrap" VerticalOptions="Center" />
                            <CheckBox
                                Grid.Column="1"
                                IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                MinimumHeightRequest="48"
                                MinimumWidthRequest="48"
                                HorizontalOptions="End"
                                VerticalOptions="Center" />
                            <BoxView
                                Grid.Row="1"
                                Grid.ColumnSpan="2"
                                Margin="0,11,0,0"
                                HeightRequest="1"
                                Color="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray500}}" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
        <Button
            Grid.Row="6"
            Text="{x:Static strings:AppResources.AddSelectedPlayersToTeamButton}"
            Command="{Binding AddSelectedPlayersCommand}"
            MinimumHeightRequest="52"
            MinimumWidthRequest="220"
            Padding="24,12"
            HorizontalOptions="Center" />
    </Grid>
</ContentPage>
