<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:strings="clr-namespace:SoftballScorekeeper.Resources.Strings"
             xmlns:controls="clr-namespace:SoftballScorekeeper.Views.Controls"
             xmlns:services="clr-namespace:SoftballScorekeeper.Services"
             xmlns:viewModels="clr-namespace:SoftballScorekeeper.ViewModels"
             x:Class="SoftballScorekeeper.Views.AddPlayersToTeamPage"
             x:DataType="viewModels:AddPlayersToTeamViewModel"
             Title="{x:Static strings:AppResources.AddPlayersToTeamTitle}">

    <Grid Style="{StaticResource ResponsivePageGrid}"
          RowDefinitions="Auto,Auto,Auto,*,Auto">
        <controls:TeamContextHeader
            Grid.Row="0"
            TeamName="{Binding TeamName}"
            PageTitle="{x:Static strings:AppResources.AddPlayersHeading}"
            IsVisible="{Binding IsTeamLoaded}" />
        <Label
            Grid.Row="1"
            Text="{Binding ValidationMessage}"
            HorizontalTextAlignment="Center">
            <Label.Triggers>
                <DataTrigger TargetType="Label" Binding="{Binding ValidationMessage}" Value="">
                    <Setter Property="IsVisible" Value="False" />
                </DataTrigger>
            </Label.Triggers>
        </Label>
        <Grid Grid.Row="2" RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="4">
            <Label Text="{x:Static strings:AppResources.EligiblePlayersHeading}"
                   FontAttributes="Bold"
                   SemanticProperties.HeadingLevel="Level2"
                   IsVisible="{Binding IsTeamLoaded}" />
            <Label Grid.Column="1"
                   Text="{Binding SelectedPlayerCount, StringFormat={x:Static strings:AppResources.SelectedPlayerCountText}}"
                   IsVisible="{Binding IsTeamLoaded}" />
            <HorizontalStackLayout Grid.Row="1" Grid.ColumnSpan="2" Spacing="10" HorizontalOptions="End">
                <Button AutomationId="AddPlayersSelectAllButton"
                        Text="{x:Static strings:AppResources.SelectAllButton}"
                        Command="{Binding SelectAllCommand}"
                        MinimumHeightRequest="44"
                        Padding="14,6" />
                <Button AutomationId="AddPlayersClearAllButton"
                        Text="{x:Static strings:AppResources.ClearAllButton}"
                        Command="{Binding ClearAllCommand}"
                        MinimumHeightRequest="44"
                        Padding="14,6" />
            </HorizontalStackLayout>
        </Grid>
        <Grid Grid.Row="3" IsVisible="{Binding IsTeamLoaded}">
            <Label
                Text="{x:Static strings:AppResources.NoEligiblePlayersMessage}"
                HorizontalTextAlignment="Center"
                VerticalOptions="Center"
                IsVisible="{Binding HasNoEligiblePlayers}" />
            <CollectionView ItemsSource="{Binding Players}" IsVisible="{Binding HasEligiblePlayers}" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:PlayerSelectionItem">
                        <Grid Padding="16,8" RowDefinitions="Auto,1" ColumnDefinitions="*,Auto" MinimumHeightRequest="64">
                            <Label Text="{Binding DisplayName}" Style="{StaticResource PrimaryListItemText}" LineBreakMode="WordWrap" />
                            <CheckBox
                                Grid.Column="1"
                                IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                MinimumHeightRequest="48"
                                MinimumWidthRequest="48"
                                HorizontalOptions="End"
                                VerticalOptions="Center" />
                            <BoxView
                                Grid.Row="1"
                                Grid.ColumnSpan="2"
                                Margin="0,11,0,0"
                                HeightRequest="1"
                                Color="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray500}}" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
        <Grid Grid.Row="4" ColumnDefinitions="*,*" ColumnSpacing="12" RowSpacing="8">
            <Grid.Triggers>
                <DataTrigger TargetType="Grid"
                             Binding="{Binding Profile, Source={x:Static services:ResponsiveLayoutState.Current}, x:DataType=services:ResponsiveLayoutState}"
                             Value="{x:Static services:ResponsiveLayoutProfile.NarrowPortrait}">
                    <Setter Property="ColumnDefinitions" Value="*" />
                    <Setter Property="RowDefinitions" Value="Auto,Auto" />
                </DataTrigger>
            </Grid.Triggers>
            <Button
                AutomationId="CreatePlayerFromTeamButton"
                Text="{x:Static strings:AppResources.CreateNewPlayerButton}"
                Command="{Binding CreatePlayerCommand}"
                Style="{StaticResource ResponsiveActionButton}"
                BackgroundColor="Transparent"
                BorderColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"
                BorderWidth="2"
                TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
            <Button
                Grid.Column="1"
                AutomationId="AddSelectedPlayersToTeamButton"
                Text="{x:Static strings:AppResources.AddSelectedPlayersToTeamButton}"
                Command="{Binding AddSelectedPlayersCommand}"
                Style="{StaticResource ResponsiveActionButton}">
                <Button.Triggers>
                    <DataTrigger TargetType="Button"
                                 Binding="{Binding Profile, Source={x:Static services:ResponsiveLayoutState.Current}, x:DataType=services:ResponsiveLayoutState}"
                                 Value="{x:Static services:ResponsiveLayoutProfile.NarrowPortrait}">
                        <Setter Property="Grid.Row" Value="1" />
                        <Setter Property="Grid.Column" Value="0" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
        </Grid>
    </Grid>
</ContentPage>
