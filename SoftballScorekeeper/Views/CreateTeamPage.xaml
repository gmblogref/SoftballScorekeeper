<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:strings="clr-namespace:SoftballScorekeeper.Resources.Strings"
             xmlns:viewModels="clr-namespace:SoftballScorekeeper.ViewModels"
             x:Class="SoftballScorekeeper.Views.CreateTeamPage"
             x:DataType="viewModels:CreateTeamViewModel"
             Title="{x:Static strings:AppResources.CreateTeamTitle}">

    <ScrollView>
        <VerticalStackLayout Style="{StaticResource ResponsivePageStack}">

            <Label
                Text="{x:Static strings:AppResources.CreateTeamTitle}"
                Style="{StaticResource ResponsiveHeadline}"
                SemanticProperties.HeadingLevel="Level1" />

            <Label
                Text="{x:Static strings:AppResources.TeamNameLabel}"
                SemanticProperties.HeadingLevel="Level2" />

            <Entry
                Text="{Binding TeamName, Mode=TwoWay}"
                Placeholder="{x:Static strings:AppResources.TeamNamePlaceholder}" />

            <Label
                Text="{x:Static strings:AppResources.TeamYearLabel}"
                SemanticProperties.HeadingLevel="Level2" />

            <Entry
                Text="{Binding TeamYearText, Mode=TwoWay}"
                Placeholder="{x:Static strings:AppResources.TeamYearPlaceholder}"
                Keyboard="Numeric"
                MaxLength="4" />

            <Label Text="{Binding ValidationMessage}">
                <Label.Triggers>
                    <DataTrigger
                        TargetType="Label"
                        Binding="{Binding ValidationMessage}"
                        Value="">
                        <Setter Property="IsVisible" Value="False" />
                    </DataTrigger>
                </Label.Triggers>
            </Label>

            <HorizontalStackLayout
                HorizontalOptions="Center"
                Spacing="16">
                <Button
                    Text="{x:Static strings:AppResources.SaveButton}"
                    Command="{Binding SaveCommand}"
                    MinimumHeightRequest="52" />

                <Button
                    Text="{x:Static strings:AppResources.SaveAndAddAnotherButton}"
                    Command="{Binding SaveAndAddAnotherCommand}"
                    MinimumHeightRequest="52" />

                <Button
                    Text="{x:Static strings:AppResources.CancelButton}"
                    Command="{Binding CancelCommand}"
                    MinimumHeightRequest="52" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
